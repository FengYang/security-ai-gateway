# syntax=docker/dockerfile:1
# route2-client 镜像 —— 路线2 端到端客户端编排器（纯 CPU，CGO=0）。
# 线性层默认走 CPU 128 位内核 CipherLinearInt128；若需加速后端，改用 CGO=1 构建并注入
# ACCEL_BACKEND_LIB（见 packaging/route2/README.md）。
FROM golang:1.26-alpine AS build
WORKDIR /src
ENV GOPROXY=https://goproxy.cn,direct
COPY go.mod go.sum ./
RUN go mod download
COPY cipher ./cipher
COPY protocol ./protocol
COPY internal ./internal
# 路线2 引擎（masked-infer）已拆分为独立仓库 github.com/FengYang/masked-infer。
# 本镜像构建时该模块须可达：发布后由 go.mod 正式 require（去掉本地 replace）经 proxy 拉取；
# 本地构建须把 masked-infer 源码拷入构建上下文（或挂载），否则 go build 无法解析 masked-infer。
# 过渡期的本地 replace（=> ../masked-infer）仅适用于 go.work 同仓联调，不适用于 Docker 上下文。
COPY gateway/cryptop ./gateway/cryptop
COPY cmd/route2-client ./cmd/route2-client
RUN CGO_ENABLED=0 go build -mod=mod -trimpath -o /out/route2-client ./cmd/route2-client

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/route2-client /usr/local/bin/route2-client
# 非 root 运行
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/route2-client"]
