diff --git a/frontend/src/pages/admin-ext/tracing/index.tsx b/frontend/src/pages/admin-ext/tracing/index.tsx
new file mode 100644
index 0000000..aadb88e
--- /dev/null
+++ b/frontend/src/pages/admin-ext/tracing/index.tsx
@@ -0,0 +1,243 @@
+import { PageContainer } from '@ant-design/pro-layout';
+import { Alert, Button, Card, Descriptions, Form, Input, Select, Space, Table, Tag } from 'antd';
+import { useCallback, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import AdminExtBadge from '@/components/AdminExtBadge';
+import {
+  TRACE_STATUS_OPTIONS,
+  TraceAggregate,
+  TraceSearchItem,
+  TraceSearchParams,
+  TraceSpan,
+  exportTraceReport,
+  getTrace,
+  searchTrace,
+} from '@/services/admin-ext-tracing';
+
+/**
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：排障查询（P1-2 全链路 tracing，§6.3/§7.7）。
+ *
+ * 三区块：
+ *  ① 多维检索：tenant/model/status（status 枚举固定 ok/client_error/server_error/denied）
+ *     → 映射 Tempo Search；命中表只读展示 traceID/服务/耗时（供定位）。
+ *  ② 单请求聚合：按 request_id 拉取 span 树 + 审计段 + 耗时分解（§6.3 响应结构）。
+ *  ③ 报告导出：json / csv（CSV 由后端做公式注入防护）。
+ *
+ * 最小披露（C-1/C-5）：响应仅含 §6.2 白名单属性与审计元数据，**无原文、无金额**。
+ * 租户隔离：后端按会话 claims 强隔离（跨租户/缺省 tenant 的非 admin → 403）。
+ * 503 语义：Tempo/Prometheus 未配置或不可达时后端返回 503（不静默给空数据）。
+ */
+
+interface SearchFormValues {
+  tenant?: string;
+  model?: string;
+  status?: string;
+}
+
+const TracingCenter: React.FC = () => {
+  const { t } = useTranslation();
+  const [detailForm] = Form.useForm<{ request_id?: string }>();
+  const [searchForm] = Form.useForm<SearchFormValues>();
+
+  const [agg, setAgg] = useState<TraceAggregate | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [err, setErr] = useState<string | null>(null);
+
+  const [hits, setHits] = useState<TraceSearchItem[]>([]);
+  const [searching, setSearching] = useState(false);
+  const [searchErr, setSearchErr] = useState<string | null>(null);
+
+  const loadTrace = useCallback((rid: string) => {
+    const id = (rid || '').trim();
+    if (!id) {
+      return;
+    }
+    setLoading(true);
+    setErr(null);
+    getTrace(id)
+      .then((r) => setAgg(r))
+      .catch((e) => {
+        setAgg(null);
+        setErr(String(e));
+      })
+      .finally(() => setLoading(false));
+  }, []);
+
+  const doSearch = useCallback((v: SearchFormValues) => {
+    setSearching(true);
+    setSearchErr(null);
+    const params: TraceSearchParams = {
+      tenant: v.tenant,
+      model: v.model,
+      status: v.status,
+      limit: 50,
+    };
+    searchTrace(params)
+      .then((r) => setHits(r.traces || []))
+      .catch((e) => {
+        setHits([]);
+        setSearchErr(String(e));
+      })
+      .finally(() => setSearching(false));
+  }, []);
+
+  const hitColumns = [
+    { title: t('adminExt.tracing.colTraceId'), dataIndex: 'traceID', ellipsis: true },
+    { title: t('adminExt.tracing.colService'), dataIndex: 'rootServiceName' },
+    { title: t('adminExt.tracing.colDurationMs'), dataIndex: 'durationMs', width: 120 },
+  ];
+
+  const spanColumns = [
+    { title: t('adminExt.tracing.colSpanName'), dataIndex: 'name', width: 200 },
+    {
+      title: t('adminExt.tracing.colStartMs'),
+      dataIndex: 'start_ms',
+      width: 110,
+      render: (v: number) => (typeof v === 'number' ? v.toFixed(2) : '-'),
+    },
+    {
+      title: t('adminExt.tracing.colDurMs'),
+      dataIndex: 'dur_ms',
+      width: 110,
+      render: (v: number) => (typeof v === 'number' ? v.toFixed(2) : '-'),
+    },
+    {
+      title: t('adminExt.tracing.colAttrs'),
+      dataIndex: 'attrs',
+      render: (attrs: Record<string, unknown>) => (
+        <Space size={[4, 4]} wrap>
+          {Object.keys(attrs || {}).map((k) => (
+            <Tag key={k}>{`${k}=${String((attrs || {})[k])}`}</Tag>
+          ))}
+        </Space>
+      ),
+    },
+  ];
+
+  const statusOptions = TRACE_STATUS_OPTIONS.map((s) => ({
+    value: s,
+    label: t(`adminExt.tracing.status_${s}`),
+  }));
+
+  return (
+    <PageContainer title={t('menu.adminExtTracing')}>
+      <AdminExtBadge />
+
+      <Card title={t('adminExt.tracing.searchTitle')} style={{ marginBottom: 16 }}>
+        <Form form={searchForm} layout="inline" onFinish={doSearch}>
+          <Form.Item name="tenant" label={t('adminExt.tracing.tenant')}>
+            <Input allowClear placeholder={t('adminExt.tracing.tenantPlaceholder')} style={{ width: 180 }} />
+          </Form.Item>
+          <Form.Item name="model" label={t('adminExt.tracing.model')}>
+            <Input allowClear style={{ width: 160 }} />
+          </Form.Item>
+          <Form.Item name="status" label={t('adminExt.tracing.status')}>
+            <Select allowClear options={statusOptions} style={{ width: 160 }} />
+          </Form.Item>
+          <Form.Item>
+            <Button type="primary" htmlType="submit" loading={searching}>
+              {t('adminExt.tracing.search')}
+            </Button>
+          </Form.Item>
+        </Form>
+        {searchErr && <Alert type="error" showIcon message={searchErr} style={{ marginTop: 12 }} />}
+        <Table<TraceSearchItem>
+          rowKey="traceID"
+          size="small"
+          style={{ marginTop: 12 }}
+          loading={searching}
+          dataSource={hits}
+          columns={hitColumns}
+          pagination={{ pageSize: 10, hideOnSinglePage: true }}
+        />
+      </Card>
+
+      <Card
+        title={t('adminExt.tracing.detailTitle')}
+        extra={
+          <Space>
+            <Button
+              size="small"
+              disabled={!agg}
+              onClick={() => agg && exportTraceReport(agg.request_id, 'json')}
+            >
+              {t('adminExt.tracing.exportJson')}
+            </Button>
+            <Button
+              size="small"
+              disabled={!agg}
+              onClick={() => agg && exportTraceReport(agg.request_id, 'csv')}
+            >
+              {t('adminExt.tracing.exportCsv')}
+            </Button>
+          </Space>
+        }
+      >
+        <Form
+          form={detailForm}
+          layout="inline"
+          onFinish={(v) => loadTrace(v.request_id || '')}
+          style={{ marginBottom: 12 }}
+        >
+          <Form.Item
+            name="request_id"
+            label={t('adminExt.tracing.requestId')}
+            rules={[{ required: true, message: t('adminExt.tracing.requestIdRequired') }]}
+          >
+            <Input allowClear style={{ width: 320 }} placeholder="req-..." />
+          </Form.Item>
+          <Form.Item>
+            <Button type="primary" htmlType="submit" loading={loading}>
+              {t('adminExt.tracing.query')}
+            </Button>
+          </Form.Item>
+        </Form>
+
+        {err && <Alert type="error" showIcon message={t('adminExt.tracing.detailError')} description={err} />}
+
+        {agg && (
+          <>
+            <Descriptions bordered size="small" column={2}>
+              <Descriptions.Item label="request_id">{agg.request_id}</Descriptions.Item>
+              <Descriptions.Item label="trace_id">{agg.trace_id}</Descriptions.Item>
+              <Descriptions.Item label={t('adminExt.tracing.tenant')}>{agg.tenant || '-'}</Descriptions.Item>
+              <Descriptions.Item label={t('adminExt.tracing.breakdown')}>
+                {`ingress ${agg.breakdown.ingress_ms.toFixed(2)}ms / tee ${agg.breakdown.tee_overhead_ms.toFixed(
+                  2,
+                )}ms / upstream ${agg.breakdown.upstream_ms.toFixed(2)}ms`}
+              </Descriptions.Item>
+            </Descriptions>
+
+            <Table<TraceSpan>
+              rowKey={(r) => `${r.name}-${r.start_ms}`}
+              size="small"
+              style={{ marginTop: 16 }}
+              dataSource={agg.spans}
+              columns={spanColumns}
+              pagination={false}
+            />
+
+            <Descriptions
+              title={t('adminExt.tracing.audit')}
+              bordered
+              size="small"
+              column={2}
+              style={{ marginTop: 16 }}
+            >
+              <Descriptions.Item label="available">{String(agg.audit.available)}</Descriptions.Item>
+              <Descriptions.Item label="action">{agg.audit.action || '-'}</Descriptions.Item>
+              <Descriptions.Item label="result">{agg.audit.result || '-'}</Descriptions.Item>
+              <Descriptions.Item label="cache_hit">{String(agg.audit.cache_hit)}</Descriptions.Item>
+              <Descriptions.Item label="is_retry">{String(agg.audit.is_retry)}</Descriptions.Item>
+              <Descriptions.Item label={t('adminExt.tracing.denies')}>
+                {(agg.audit.denies || []).map((d) => `${d.result}:${d.reason}`).join(', ') || '-'}
+              </Descriptions.Item>
+            </Descriptions>
+          </>
+        )}
+      </Card>
+    </PageContainer>
+  );
+};
+
+export default TracingCenter;
diff --git a/frontend/src/services/admin-ext-tracing.ts b/frontend/src/services/admin-ext-tracing.ts
