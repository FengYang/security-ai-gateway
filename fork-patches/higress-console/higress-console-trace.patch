+++ b/frontend/src/services/admin-ext-tracing.ts
@@ -0,0 +1,110 @@
+import request from './request';
+
+/**
+ * ADMIN-EXT（自研扩展）：排障查询 API 客户端（P1-2 全链路 tracing，§6.3）。
+ *
+ * 数据源：gateway-admin-service `/v1/adminext/*`
+ *  - GET /trace/{request_id}         单请求全链路聚合（span 树 + 审计 + 耗时分解）
+ *  - GET /trace/search               多维检索（映射 Tempo Search）
+ *  - GET /trace/{request_id}/report  导出报告（json | csv）
+ *
+ * 安全约束（§6.3）：响应仅含 §6.2 白名单属性与审计元数据，**无原文、无金额**（C-1/C-5）；
+ * 租户隔离：非 admin 会话仅可访问本声明租户（跨租户/缺省 tenant → 403，fail-closed）。
+ * 503 语义：Tempo/Prometheus 未配置或不可达时后端返回 503（不静默给空数据）。
+ */
+
+const BASE = '/v1/adminext';
+
+/** 单个 span（元数据，属性已按白名单裁剪）。 */
+export interface TraceSpan {
+  name: string;
+  start_ms: number;
+  dur_ms: number;
+  attrs: Record<string, unknown>;
+}
+
+/** 拒绝/拦截记录（审计段）。 */
+export interface TraceDeny {
+  reason: string;
+  result: string;
+}
+
+/** 审计段（audit.available=false 表示 tee-infer 审计代理不可达，如实标注）。 */
+export interface TraceAudit {
+  available: boolean;
+  action: string;
+  result: string;
+  cache_hit: boolean;
+  is_retry: boolean;
+  denies: TraceDeny[];
+}
+
+/** 耗时分解（毫秒）。 */
+export interface TraceBreakdown {
+  ingress_ms: number;
+  tee_overhead_ms: number;
+  upstream_ms: number;
+}
+
+/** 单请求全链路聚合响应。 */
+export interface TraceAggregate {
+  request_id: string;
+  trace_id: string;
+  tenant: string;
+  spans: TraceSpan[];
+  audit: TraceAudit;
+  breakdown: TraceBreakdown;
+}
+
+/** 检索命中项（Tempo Search 精简视图）。 */
+export interface TraceSearchItem {
+  traceID: string;
+  rootServiceName?: string;
+  rootTraceName?: string;
+  startTimeUnixNano?: string;
+  durationMs?: number;
+}
+
+/** 检索响应（Tempo 原样透传，取 traces 字段。 */
+export interface TraceSearchResult {
+  traces?: TraceSearchItem[];
+}
+
+/** §6.3 status 枚举（枚举外值后端返回 400）。 */
+export const TRACE_STATUS_OPTIONS = ['ok', 'client_error', 'server_error', 'denied'];
+
+export interface TraceSearchParams {
+  tenant?: string;
+  model?: string;
+  status?: string;
+  category?: string;
+  from?: string;
+  to?: string;
+  limit?: number;
+  offset?: number;
+}
+
+/** 单请求全链路聚合。 */
+export const getTrace = (requestId: string): Promise<TraceAggregate> => {
+  return request.get<any, TraceAggregate>(`${BASE}/trace/${encodeURIComponent(requestId)}`);
+};
+
+/** 多维检索。 */
+export const searchTrace = (params: TraceSearchParams): Promise<TraceSearchResult> => {
+  const q: Record<string, string> = {};
+  Object.keys(params).forEach((k) => {
+    const v = (params as Record<string, unknown>)[k];
+    if (v !== undefined && v !== null && v !== '') {
+      q[k] = String(v);
+    }
+  });
+  return request.get<any, TraceSearchResult>(`${BASE}/trace/search`, { params: q });
+};
+
+/** 导出排障报告（浏览器直接下载，走同源会话认证）。 */
+export const exportTraceReport = (requestId: string, format: 'json' | 'csv'): void => {
+  window.open(
+    `${BASE}/trace/${encodeURIComponent(requestId)}/report?format=${format}`,
+    '_blank',
+  );
+};
