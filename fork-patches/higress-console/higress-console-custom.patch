@@ -0,0 +1,93 @@
+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：
+ * 登录失败锁定器（M3-A，docs/管理门户-细化方案.md §5.4"密码强度校验与登录失败锁定"）。
+ *
+ * 策略（M3-A 定案默认值）：
+ *  - 同一用户名在滑动窗口（5 分钟）内连续失败 ≥5 次 → 锁定 15 分钟；
+ *  - 成功登录立即清零计数；
+ *  - 内存实现（进程重启清零）：锁定是防爆破的减速带而非安全边界，
+ *    安全边界仍是密码哈希 + 会话令牌签名。对原生 admin 与自研账号统一生效。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+import org.springframework.stereotype.Component;
+
+/**
+ * @author admin-ext
+ */
+@Component
+public class AdminExtLoginGuard {
+
+    /** 锁定异常（携带剩余锁定毫秒，供上层友好提示）。 */
+    public static class LockedException extends RuntimeException {
+        public LockedException(long remainingMs) {
+            super("账号已锁定，请 " + Math.max(remainingMs / 60_000 + 1, 1) + " 分钟后重试");
+        }
+    }
+
+    /** 滑动窗口长度（毫秒）。 */
+    private static final long WINDOW_MS = 5 * 60_000L;
+    /** 窗口内最大失败次数。 */
+    private static final int MAX_FAILURES = 5;
+    /** 触发后的锁定时长（毫秒）。 */
+    private static final long LOCKOUT_MS = 15 * 60_000L;
+
+    private final Map<String, FailureState> states = new ConcurrentHashMap<>();
+
+    /** 校验是否处于锁定态；锁定则抛 LockedException，否则放行。 */
+    public void checkNotLocked(String username) {
+        if (username == null || username.isEmpty()) {
+            return;
+        }
+        FailureState state = states.get(username);
+        if (state == null) {
+            return;
+        }
+        long now = System.currentTimeMillis();
+        synchronized (state) {
+            if (state.lockedUntil > now) {
+                throw new LockedException(state.lockedUntil - now);
+            }
+        }
+    }
+
+    /** 记录一次失败；达到阈值即进入锁定态。 */
+    public void recordFailure(String username) {
+        if (username == null || username.isEmpty()) {
+            return;
+        }
+        long now = System.currentTimeMillis();
+        FailureState state = states.computeIfAbsent(username, k -> new FailureState());
+        synchronized (state) {
+            // 窗口外的旧失败不计数（重置窗口起点）。
+            if (now - state.windowStart > WINDOW_MS) {
+                state.windowStart = now;
+                state.failures = 0;
+                state.lockedUntil = 0;
+            }
+            state.failures++;
+            if (state.failures >= MAX_FAILURES) {
+                state.lockedUntil = now + LOCKOUT_MS;
+            }
+        }
+    }
+
+    /** 记录成功登录（清零计数与锁定态）。 */
+    public void recordSuccess(String username) {
+        if (username == null || username.isEmpty()) {
+            return;
+        }
+        states.remove(username);
+    }
+
+    private static final class FailureState {
+        private long windowStart;
+        private int failures;
+        private long lockedUntil;
+    }
+}
