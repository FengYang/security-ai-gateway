+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：
+ * 账号管理审计投递器（M3-A）。账号表写操作（AdminExtAccountController）成功后，
+ * 经内部令牌调 gateway-admin-service 的 POST /v1/adminext/audit-events 落 G1 哈希链。
+ *
+ * fail-closed（与凭据/配额写同款语义）：投递失败 → 调用方必须回滚该次账号变更并 500，
+ * 绝不允许"变更生效但无审计"的窗口。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+
+import javax.annotation.Resource;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Component;
+
+import com.alibaba.higress.sdk.exception.BusinessException;
+
+/**
+ * @author admin-ext
+ */
+@Component
+public class AdminExtAuditForwarder {
+
+    private static final Logger log = LoggerFactory.getLogger(AdminExtAuditForwarder.class);
+
+    private static final int HTTP_NO_CONTENT = 204;
+
+    /** 审计动作常量（与 gateway-admin-service/audit_events.go 白名单一一对应）。 */
+    public static final String ACTION_ACCOUNT_CREATE = "account_create";
+    public static final String ACTION_ACCOUNT_UPDATE = "account_update";
+    public static final String ACTION_ACCOUNT_PASSWORD_RESET = "account_password_reset";
+    public static final String ACTION_ACCOUNT_DELETE = "account_delete";
+
+    @Resource
+    private AdminExtConfig config;
+
+    /**
+     * 投递一条账号管理审计事件（仅管理端点触达，内部令牌恒签 admin——Go 侧 admin only）。
+     *
+     * @param action 审计动作（Go 侧白名单：account_create/update/password_reset/delete）
+     * @param target 目标账号名
+     * @param sub    操作人（会话登录名）
+     */
+    public void forward(String action, String target, String sub) {
+        if (!config.isReady()) {
+            throw new BusinessException("审计投递配置未就绪（ADMIN_SVC_TARGET/ADMIN_SVC_JWT_SECRET），账号变更拒绝（fail-closed）");
+        }
+        String token = AdminExtJwtSigner.signNow(config.getJwtSecret(), sub, AdminExtRole.ADMIN,
+            config.getJwtTtlSeconds());
+        String body = "{\"action\":\"" + jsonEscape(action) + "\",\"target\":\"" + jsonEscape(target) + "\"}";
+
+        HttpURLConnection conn = null;
+        try {
+            conn = (HttpURLConnection) new URL(
+                config.getTarget() + "/v1/adminext/audit-events").openConnection();
+            conn.setRequestMethod("POST");
+            conn.setConnectTimeout(3000);
+            conn.setReadTimeout(10000);
+            conn.setDoOutput(true);
+            conn.setRequestProperty("Authorization", "Bearer " + token);
+            conn.setRequestProperty("Content-Type", "application/json");
+            byte[] payload = body.getBytes(StandardCharsets.UTF_8);
+            conn.setFixedLengthStreamingMode(payload.length);
+            try (OutputStream out = conn.getOutputStream()) {
+                out.write(payload);
+            }
+            int code = conn.getResponseCode();
+            if (code != HTTP_NO_CONTENT) {
+                InputStream err = conn.getErrorStream();
+                String detail = err == null ? "" : readFully(err);
+                log.warn("[admin-ext] 审计投递失败 action={} target={} code={} detail={}",
+                    action, target, code, detail);
+                throw new BusinessException("审计链投递失败（HTTP " + code + "），账号变更须回滚");
+            }
+            log.info("[admin-ext] 审计事件落链：action={} target={} sub={}", action, target, sub);
+        } catch (BusinessException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new BusinessException("审计链投递失败（连接异常），账号变更须回滚", e);
+        } finally {
+            if (conn != null) {
+                conn.disconnect();
+            }
+        }
+    }
+
+    private static String jsonEscape(String s) {
+        return s == null ? "" : s.replace("\\", "\\\\").replace("\"", "\\\"");
+    }
+
+    private static String readFully(InputStream in) {
+        try (InputStream input = in) {
+            ByteArrayOutputStream buf = new ByteArrayOutputStream();
+            byte[] chunk = new byte[1024];
+            int n;
+            while ((n = input.read(chunk)) != -1) {
+                buf.write(chunk, 0, n);
+            }
+            return buf.toString("UTF-8");
+        } catch (Exception e) {
+            return "";
+        }
+    }
+}
