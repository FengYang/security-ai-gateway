@@ -0,0 +1,239 @@
+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：
+ * 自研账号表存储（M3-A，docs/管理门户-细化方案.md §4 User+role 扩展）。
+ *
+ * 持久化：独立 K8s Secret（higress-console-adminext-users），与原生 admin secret 分离：
+ *   data["users.json"] = JSON 数组 [{username, displayName, role, passwordHash, salt}]
+ *   data["serverKey"]  = 随机 hex 64 字符（自研会话令牌的 HMAC 密钥，首次写入时生成）
+ *
+ * 职责边界（单一真源）：
+ *   - 写操作仅经本类（AdminExtAccountController 编排，admin only，写后投递 G1 审计链）；
+ *   - 读消费方 = 本类缓存（登录校验/角色解析，TTL 30s——角色变更生效延迟 ≤30s+JWT TTL）；
+ *   - gateway-admin-service 不接触账号数据（凭据 Secret 的只读卷模式不适用于动态写）。
+ *
+ * 失败语义（fail-closed 降级）：
+ *   - 读失败且有旧缓存 → 回落旧缓存（最老 30s 偏差可接受，登录可用性优先）；
+ *   - 读失败且无缓存 → 抛 BusinessException（登录/角色解析 fail-closed，不静默放行）。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import java.nio.charset.StandardCharsets;
+import java.security.SecureRandom;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.stream.Collectors;
+
+import javax.annotation.Resource;
+
+import org.springframework.stereotype.Component;
+
+import com.alibaba.higress.sdk.exception.BusinessException;
+import com.alibaba.higress.sdk.service.kubernetes.KubernetesClientService;
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+import io.kubernetes.client.openapi.models.V1Secret;
+import lombok.Data;
+
+/**
+ * @author admin-ext
+ */
+@Component
+public class AdminExtUserStore {
+
+    /** 账号 Secret 名（console namespace 内，与原生 admin secret 分离）。 */
+    public static final String SECRET_NAME = "higress-console-adminext-users";
+
+    private static final String USERS_JSON_KEY = "users.json";
+    private static final String SERVER_KEY_KEY = "serverKey";
+    /** 缓存 TTL（毫秒）：角色/账号变更生效延迟上限 = TTL + JWT TTL。 */
+    private static final long CACHE_TTL_MS = 30_000L;
+    /** serverKey 长度（hex 字符）。 */
+    private static final int SERVER_KEY_HEX_LEN = 64;
+
+    private static final ObjectMapper MAPPER = new ObjectMapper();
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    @Resource
+    private KubernetesClientService kubernetesClientService;
+
+    private final AtomicReference<CachedUsers> cache = new AtomicReference<>();
+
+    /** 新鲜读快照（写路径用：绕过缓存，含原始 data 供回滚）。 */
+    @Data
+    public static class Snapshot {
+        private Map<String, byte[]> data;
+        private List<AdminExtUserRecord> users;
+        private String serverKey;
+    }
+
+    /** 缓存条目。 */
+    private static final class CachedUsers {
+        private final List<AdminExtUserRecord> users;
+        private final String serverKey;
+        private final long loadedAt;
+
+        private CachedUsers(List<AdminExtUserRecord> users, String serverKey, long loadedAt) {
+            this.users = users;
+            this.serverKey = serverKey;
+            this.loadedAt = loadedAt;
+        }
+    }
+
+    /**
+     * 查询账号（缓存）。读失败回落旧缓存；无缓存时抛 BusinessException（fail-closed）。
+     *
+     * @return 无该账号返回 null（区别于原生 admin 账号——由调用方兜底判定角色）
+     */
+    public AdminExtUserRecord findByUsername(String username) {
+        for (AdminExtUserRecord record : listUsers()) {
+            if (record.getUsername().equals(username)) {
+                return record;
+            }
+        }
+        return null;
+    }
+
+    /** 全量账号（缓存，脱敏副本；写路径须走 {@link #readFresh}）。 */
+    public List<AdminExtUserRecord> listUsers() {
+        CachedUsers cached = cache.get();
+        if (cached != null && System.currentTimeMillis() - cached.loadedAt < CACHE_TTL_MS) {
+            return cached.users;
+        }
+        Snapshot snapshot = readFresh();
+        cache.set(new CachedUsers(snapshot.getUsers(), snapshot.getServerKey(), System.currentTimeMillis()));
+        return snapshot.getUsers();
+    }
+
+    /** 当前（缓存内）serverKey；无缓存时新鲜读。供会话令牌签名使用。 */
+    public String serverKey() {
+        CachedUsers cached = cache.get();
+        if (cached != null && System.currentTimeMillis() - cached.loadedAt < CACHE_TTL_MS) {
+            return cached.serverKey;
+        }
+        Snapshot snapshot = readFresh();
+        cache.set(new CachedUsers(snapshot.getUsers(), snapshot.getServerKey(), System.currentTimeMillis()));
+        return snapshot.getServerKey();
+    }
+
+    /**
+     * 新鲜读（绕过缓存）。Secret 不存在 → 空表 + null serverKey（由写路径首次创建生成）。
+     * 非 404 读失败 → BusinessException（fail-closed，不静默放行）。
+     */
+    public Snapshot readFresh() {
+        V1Secret secret;
+        try {
+            secret = kubernetesClientService.readSecret(SECRET_NAME);
+        } catch (Exception e) {
+            CachedUsers cached = cache.get();
+            if (cached != null) {
+                return snapshotFrom(cached.users, cached.serverKey, emptyData());
+            }
+            throw new BusinessException("账号表读取失败（K8s Secret 不可达，fail-closed）", e);
+        }
+        if (secret == null || secret.getData() == null || secret.getData().isEmpty()) {
+            return snapshotFrom(Collections.emptyList(), null, null);
+        }
+        Map<String, byte[]> data = new HashMap<>(secret.getData());
+        List<AdminExtUserRecord> users = parseUsers(data.get(USERS_JSON_KEY));
+        String serverKey = data.get(SERVER_KEY_KEY) == null ? null
+            : new String(data.get(SERVER_KEY_KEY), StandardCharsets.UTF_8);
+        return snapshotFrom(users, serverKey, data);
+    }
+
+    /**
+     * 以 base 为基准写回账号表（含 serverKey 原样保留；base.data 为 null 表示首次创建）。
+     * 写后失效缓存（下一次读即最新）。调用方负责先投递审计、失败时用 base 回滚。
+     */
+    public void writeUsers(Snapshot base, List<AdminExtUserRecord> users) {
+        Map<String, byte[]> data = base.getData() == null ? new HashMap<>() : new HashMap<>(base.getData());
+        try {
+            data.put(USERS_JSON_KEY, MAPPER.writeValueAsBytes(users));
+            if (data.get(SERVER_KEY_KEY) == null) {
+                data.put(SERVER_KEY_KEY, newServerKey().getBytes(StandardCharsets.UTF_8));
+            }
+        } catch (Exception e) {
+            throw new BusinessException("账号表序列化失败", e);
+        }
+        V1Secret secret = new V1Secret();
+        io.kubernetes.client.openapi.models.V1ObjectMeta meta =
+            new io.kubernetes.client.openapi.models.V1ObjectMeta();
+        meta.setName(SECRET_NAME);
+        secret.setMetadata(meta);
+        secret.setData(data);
+        try {
+            if (base.getData() == null) {
+                kubernetesClientService.createSecret(secret);
+            } else {
+                kubernetesClientService.replaceSecret(secret);
+            }
+        } catch (io.kubernetes.client.openapi.ApiException e) {
+            throw new BusinessException("账号表写入失败（K8s）", e);
+        }
+        cache.set(null);
+    }
+
+    /** 失效缓存（运维/测试用）。 */
+    public void invalidate() {
+        cache.set(null);
+    }
+
+    /**
+     * 角色解析（单一真源，M3-A；AdminExtProxyController / AdminExtAccountController 共用）：
+     * 账号表命中 → 其角色；未命中 → 原生 admin 兜底（原生账号恒为管理员）；
+     * 读失败（无缓存且 K8s 不可达）→ auditor 降级（只读，fail-closed）——
+     * 集群运维层的 ADMIN_SVC_ROLE_ADMINS 白名单是此时唯一的管理员通道。
+     */
+    public String resolveRole(String username) {
+        try {
+            AdminExtUserRecord record = findByUsername(username);
+            return record != null ? record.getRole() : AdminExtRole.ADMIN;
+        } catch (RuntimeException e) {
+            return AdminExtRole.AUDITOR;
+        }
+    }
+
+    private static Snapshot snapshotFrom(List<AdminExtUserRecord> users, String serverKey, Map<String, byte[]> data) {
+        Snapshot snapshot = new Snapshot();
+        snapshot.setUsers(users);
+        snapshot.setServerKey(serverKey);
+        snapshot.setData(data);
+        return snapshot;
+    }
+
+    private static Map<String, byte[]> emptyData() {
+        return new HashMap<>();
+    }
+
+    private static List<AdminExtUserRecord> parseUsers(byte[] raw) {
+        if (raw == null || raw.length == 0) {
+            return Collections.emptyList();
+        }
+        try {
+            List<AdminExtUserRecord> users =
+                MAPPER.readValue(raw, new TypeReference<List<AdminExtUserRecord>>() {});
+            return Collections.unmodifiableList(users);
+        } catch (Exception e) {
+            throw new BusinessException("账号表解析失败（users.json 损坏，fail-closed）", e);
+        }
+    }
+
+    private static String newServerKey() {
+        StringBuilder sb = new StringBuilder(SERVER_KEY_HEX_LEN);
+        for (int i = 0; i < SERVER_KEY_HEX_LEN / 2; i++) {
+            sb.append(String.format("%02x", RANDOM.nextInt(256)));
+        }
+        return sb.toString();
+    }
+
+    /** 脱敏视图（列表/日志输出用；hash/salt 不出 store）。 */
+    public static List<AdminExtUserRecord> sanitize(List<AdminExtUserRecord> users) {
+        return users.stream().map(u -> new AdminExtUserRecord(u.getUsername(), u.getDisplayName(), u.getRole(),
+            null, null)).collect(Collectors.toList());
+    }
+}
