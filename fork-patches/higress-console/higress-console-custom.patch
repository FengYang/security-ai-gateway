@@ -0,0 +1,72 @@
+import request from './request';
+
+/**
+ * ADMIN-EXT（自研扩展）：broker 凭据托管 API 客户端。
+ *
+ * 设计（docs/管理门户-apiTokens-Secret化-M2细化方案.md §2.1.3/§2.1.5）：
+ * 管理员在此写入/轮换厂商 API Key → 经 admin-ext 链路落 broker 凭据目录
+ * → CR 中 provider 恒为「无 token + customUrl 指向 broker」形态。
+ *
+ * 后端：gateway-admin-service /v1/adminext/broker-providers（Go），
+ * 经控制台 Java AdminExtProxyController 通用转发（会话校验 + 内部 JWT）。
+ * 安全：读写响应**均不回显 Key**（仅 8 位不可逆指纹）；写操作仅 admin 角色可用，
+ * auditor 调用将收到 403（后端以用户名白名单派生角色，不采信 JWT 声明）。
+ */
+
+/** 托管凭据视图（**不含 Key**）。 */
+export interface BrokerProviderView {
+  name: string;
+  upstream: string;
+  pathCount: number;
+  /** SHA-256 前 8 位十六进制，用于确认轮换是否生效（不可逆推） */
+  keyFingerprint: string;
+  updatedAt?: string;
+}
+
+/** 列表响应（含 CR 漂移告警）。 */
+export interface BrokerProviderList {
+  providers: BrokerProviderView[];
+  /** CR 中仍指向 broker 但 broker 侧已无凭据的 provider */
+  orphanDetected?: string[];
+}
+
+/** 写入/轮换请求体。 */
+export interface BrokerProviderUpsert {
+  upstream: string;
+  key: string;
+  allowPathPrefixes?: string[];
+}
+
+/** 写入响应（返回 customUrl 供粘贴到 Provider 页；**不回显 Key**）。 */
+export interface BrokerProviderUpsertResult {
+  name: string;
+  customUrl: string;
+}
+
+/** 删除响应（含 CR 联动告警）。 */
+export interface BrokerProviderDeleteResult {
+  name: string;
+  affectedProviders: string[];
+  warning: string;
+}
+
+const BASE = '/v1/adminext/broker-providers';
+
+export const listBrokerProviders = (): Promise<BrokerProviderList> => {
+  return request.get<any, BrokerProviderList>(BASE);
+};
+
+export const getBrokerProvider = (name: string): Promise<BrokerProviderView> => {
+  return request.get<any, BrokerProviderView>(`${BASE}/${name}`);
+};
+
+export const upsertBrokerProvider = (
+  name: string,
+  payload: BrokerProviderUpsert,
+): Promise<BrokerProviderUpsertResult> => {
+  return request.post<any, BrokerProviderUpsertResult>(`${BASE}/${name}`, payload);
+};
+
+export const deleteBrokerProvider = (name: string): Promise<BrokerProviderDeleteResult> => {
+  return request.delete<any, BrokerProviderDeleteResult>(`${BASE}/${name}`);
+};
