@@ -0,0 +1,102 @@
+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：
+ * 账号表记录（M3-A）。持久化于独立 K8s Secret 的 users.json（AdminExtUserStore）。
+ *
+ * 安全约束：
+ *  - 绝不存明文密码：仅存 passwordHash = SHA-256(salt + password) 与随机盐；
+ *  - 列表/日志输出一律走脱敏视图（AdminExtUserStore#sanitize），hash/salt 不出 store。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.stream.Collectors;
+import java.util.stream.IntStream;
+
+import lombok.AllArgsConstructor;
+import lombok.Data;
+import lombok.NoArgsConstructor;
+
+/**
+ * @author admin-ext
+ */
+@Data
+@NoArgsConstructor
+@AllArgsConstructor
+public class AdminExtUserRecord {
+
+    private static final char[] HEX = "0123456789abcdef".toCharArray();
+
+    private String username;
+
+    private String displayName;
+
+    /** 固定角色：AdminExtRole.ADMIN / AdminExtRole.AUDITOR。 */
+    private String role;
+
+    /** SHA-256(salt + password) 的 hex（64 字符）。 */
+    private String passwordHash;
+
+    /** 随机盐 hex（32 字符）。 */
+    private String salt;
+
+    /** 计算密码哈希（与持久化口径一致）。 */
+    public static String hashPassword(String salt, String password) {
+        MessageDigest digest;
+        try {
+            digest = MessageDigest.getInstance("SHA-256");
+        } catch (NoSuchAlgorithmException e) {
+            throw new IllegalStateException("SHA-256 不可用", e);
+        }
+        byte[] hashed = digest.digest((salt + password).getBytes(StandardCharsets.UTF_8));
+        StringBuilder sb = new StringBuilder(hashed.length * 2);
+        for (byte b : hashed) {
+            sb.append(HEX[(b >> 4) & 0xf]).append(HEX[b & 0xf]);
+        }
+        return sb.toString();
+    }
+
+    /** 校验密码（常数不确定时间足够账号管理场景；哈希比对用恒时比较防计时侧信道）。 */
+    public boolean matchesPassword(String password) {
+        return constantTimeEquals(passwordHash, hashPassword(salt, password));
+    }
+
+    private static boolean constantTimeEquals(String a, String b) {
+        return MessageDigest.isEqual(a.getBytes(StandardCharsets.UTF_8), b.getBytes(StandardCharsets.UTF_8));
+    }
+
+    /** 生成随机盐（32 hex 字符，SecureRandom 由调用方注入值）。 */
+    public static String newSalt(java.security.SecureRandom random) {
+        byte[] raw = new byte[16];
+        random.nextBytes(raw);
+        return IntStream.range(0, raw.length).mapToObj(i -> String.format("%02x", raw[i]))
+            .collect(Collectors.joining());
+    }
+
+    /**
+     * 密码强度校验（M3-A 定案：≥8 位且同时含字母与数字）。
+     * 会话改密码与账号管理端点共用同一规则。
+     */
+    public static String validatePassword(String password) {
+        if (password == null || password.length() < 8) {
+            return "密码长度须 ≥8 位";
+        }
+        boolean hasLetter = false;
+        boolean hasDigit = false;
+        for (int i = 0; i < password.length(); i++) {
+            char c = password.charAt(i);
+            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
+                hasLetter = true;
+            } else if (c >= '0' && c <= '9') {
+                hasDigit = true;
+            }
+        }
+        if (!hasLetter || !hasDigit) {
+            return "密码须同时包含字母与数字";
+        }
+        return null;
+    }
+}
