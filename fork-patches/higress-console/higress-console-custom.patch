index 0000000..83ec1b6
--- /dev/null
+++ b/backend/console/src/test/java/com/alibaba/higress/console/controller/admin/AdminExtJwtSignerTest.java
@@ -0,0 +1,95 @@
+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT：AdminExtJwtSigner 单元测试。
+ * 校验 JWT 结构、载荷字段、TTL 语义与 HMAC 敏感性（与 Go 端 gateway-admin-service/auth.go
+ * 校验约定一致：base64url 无 padding / 键名 sub,role,iss,aud,iat,exp / Unix 秒）。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * @author admin-ext
+ */
+class AdminExtJwtSignerTest {
+
+    private static final byte[] SECRET = "test-admin-shared-secret-0123456789".getBytes(StandardCharsets.UTF_8);
+    private static final long NOW = 1_752_000_000L;
+    private static final long TTL = 60L;
+
+    private static String[] parts(String token) {
+        String[] p = token.split("\\.");
+        assertEquals(3, p.length, "JWT 应为三段");
+        return p;
+    }
+
+    private static String decode(String segment) {
+        return new String(Base64.getUrlDecoder().decode(segment), StandardCharsets.UTF_8);
+    }
+
+    @Test
+    void signProducesWellFormedTokenWithClaims() {
+        String token = AdminExtJwtSigner.sign(SECRET, "alice", "admin",
+                AdminExtConfig.DEFAULT_ISSUER, AdminExtConfig.DEFAULT_AUDIENCE, NOW, TTL);
+        String[] p = parts(token);
+
+        String header = decode(p[0]);
+        assertTrue(header.contains("\"alg\":\"HS256\""));
+
+        String payload = decode(p[1]);
+        assertTrue(payload.contains("\"sub\":\"alice\""));
+        assertTrue(payload.contains("\"role\":\"admin\""));
+        assertTrue(payload.contains("\"iss\":\"higress-console\""));
+        assertTrue(payload.contains("\"aud\":\"gateway-admin-service\""));
+        assertTrue(payload.contains("\"iat\":" + NOW));
+        assertTrue(payload.contains("\"exp\":" + (NOW + TTL)));
+    }
+
+    @Test
+    void expEqualsIatPlusTtl() {
+        String token = AdminExtJwtSigner.sign(SECRET, "bob", "auditor",
+                AdminExtConfig.DEFAULT_ISSUER, AdminExtConfig.DEFAULT_AUDIENCE, NOW, TTL);
+        String payload = decode(parts(token)[1]);
+        assertTrue(payload.contains("\"iat\":" + NOW), payload);
+        assertTrue(payload.contains("\"exp\":" + (NOW + TTL)), payload);
+    }
+
+    @Test
+    void signatureChangesWhenPayloadOrSecretChanges() {
+        String base = AdminExtJwtSigner.sign(SECRET, "alice", "admin",
+                AdminExtConfig.DEFAULT_ISSUER, AdminExtConfig.DEFAULT_AUDIENCE, NOW, TTL);
+
+        String otherRole = AdminExtJwtSigner.sign(SECRET, "alice", "auditor",
+                AdminExtConfig.DEFAULT_ISSUER, AdminExtConfig.DEFAULT_AUDIENCE, NOW, TTL);
+        assertNotEquals(base, otherRole, "载荷变化必须改变签名");
+
+        byte[] otherSecret = "another-secret-key-0123456789abcdef".getBytes(StandardCharsets.UTF_8);
+        String otherKey = AdminExtJwtSigner.sign(otherSecret, "alice", "admin",
+                AdminExtConfig.DEFAULT_ISSUER, AdminExtConfig.DEFAULT_AUDIENCE, NOW, TTL);
+        assertNotEquals(base, otherKey, "密钥变化必须改变签名");
+    }
+
+    @Test
+    void jsonEscapesQuotesAndBackslashesInSub() {
+        String token = AdminExtJwtSigner.sign(SECRET, "a\"b\\c", "admin",
+                AdminExtConfig.DEFAULT_ISSUER, AdminExtConfig.DEFAULT_AUDIENCE, NOW, TTL);
+        String payload = decode(parts(token)[1]);
+        assertTrue(payload.contains("\"sub\":\"a\\\"b\\\\c\""), payload);
+    }
+
+    @Test
+    void signNowCarriesDefaults() {
+        String token = AdminExtJwtSigner.signNow(SECRET, "alice", "admin", TTL);
+        String payload = decode(parts(token)[1]);
+        assertTrue(payload.contains("\"iss\":\"higress-console\""));
+        assertTrue(payload.contains("\"aud\":\"gateway-admin-service\""));
+    }
+}
