@@ -0,0 +1,228 @@
+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：
+ * 账号管理端点（M3-A，docs/管理门户-细化方案.md §4 User+role 扩展）。
+ *
+ * 路径说明：账号表是 Java 控制台自研存储（独立 K8s Secret），不经 /v1/adminext/**
+ * 转发（该前缀整体转发到 gateway-admin-service），故本 controller 挂 /adminext-accounts。
+ *
+ * 写路径统一语义（fail-closed，与 G1 凭据写同款）：
+ *   校验 → 读快照 → 变更 → 写 Secret → 投递审计 → 失败则回滚 Secret 并 500。
+ *   绝不允许"变更生效但无审计"的窗口。
+ *
+ * 安全约束：
+ *  - 端点受 ApiStandardizationAspect 会话强制（已登录）；写权限由操作发起方（控制台
+ *    管理员界面）与后续 M3-A-2 的既有页 aspect 共同收口，本端点为管理面专用；
+ *  - 不得删最后一个 admin（防运维自锁）；不得删自己（防误删当前会话）；
+ *  - 密码强度 ≥8 位含字母+数字（AdminExtUserRecord.validatePassword）。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.List;
+
+import javax.annotation.Resource;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.alibaba.higress.console.model.User;
+import com.alibaba.higress.console.service.SessionUserHelper;
+import com.alibaba.higress.sdk.exception.BusinessException;
+import com.alibaba.higress.sdk.exception.ValidationException;
+
+/**
+ * @author admin-ext
+ */
+@RestController
+@RequestMapping("/adminext-accounts")
+public class AdminExtAccountController {
+
+    private static final Logger log = LoggerFactory.getLogger(AdminExtAccountController.class);
+
+    @Resource
+    private AdminExtUserStore userStore;
+
+    @Resource
+    private AdminExtAuditForwarder auditForwarder;
+
+    private final SecureRandom random = new SecureRandom();
+
+    @RequestMapping(method = RequestMethod.GET)
+    public ResponseEntity<List<AdminExtUserRecord>> list() {
+        requireSession();
+        return ResponseEntity.ok(AdminExtUserStore.sanitize(userStore.listUsers()));
+    }
+
+    @RequestMapping(method = RequestMethod.POST)
+    public ResponseEntity<Void> create(@RequestBody CreateAccountRequest req) {
+        User current = requireSession();
+        validateUsername(req.getUsername());
+        String weak = AdminExtUserRecord.validatePassword(req.getPassword());
+        if (weak != null) {
+            throw new ValidationException(weak);
+        }
+        if (!AdminExtRole.isValid(req.getRole())) {
+            throw new ValidationException("角色须为 admin 或 auditor");
+        }
+
+        AdminExtUserStore.Snapshot snapshot = userStore.readFresh();
+        List<AdminExtUserRecord> before = new ArrayList<>(snapshot.getUsers());
+        for (AdminExtUserRecord u : before) {
+            if (u.getUsername().equals(req.getUsername())) {
+                throw new ValidationException("账号已存在: " + req.getUsername());
+            }
+        }
+        String salt = AdminExtUserRecord.newSalt(random);
+        // readFresh 返回不可变列表（读路径保护），写路径显式工作副本后再变更
+        List<AdminExtUserRecord> updated = new ArrayList<>(before);
+        updated.add(new AdminExtUserRecord(
+            req.getUsername(), req.getDisplayName(), req.getRole(),
+            AdminExtUserRecord.hashPassword(salt, req.getPassword()), salt));
+        userStore.writeUsers(snapshot, updated);
+
+        try {
+            auditForwarder.forward(AdminExtAuditForwarder.ACTION_ACCOUNT_CREATE,
+                req.getUsername(), current.getName());
+        } catch (RuntimeException e) {
+            rollback(snapshot, before);
+            throw e;
+        }
+        return ResponseEntity.status(HttpStatus.CREATED).build();
+    }
+
+    @RequestMapping(value = "/{name}/password", method = RequestMethod.PUT)
+    public ResponseEntity<Void> resetPassword(@PathVariable String name, @RequestBody ResetPasswordRequest req) {
+        User current = requireSession();
+        String weak = AdminExtUserRecord.validatePassword(req.getPassword());
+        if (weak != null) {
+            throw new ValidationException(weak);
+        }
+
+        AdminExtUserStore.Snapshot snapshot = userStore.readFresh();
+        List<AdminExtUserRecord> before = new ArrayList<>(snapshot.getUsers());
+        AdminExtUserRecord target = findOrFail(snapshot, name);
+        // before 中 target 存深拷贝：密码字段回滚不受本次原地变更影响
+        before.set(before.indexOf(target), new AdminExtUserRecord(
+            target.getUsername(), target.getDisplayName(), target.getRole(),
+            target.getPasswordHash(), target.getSalt()));
+        String salt = AdminExtUserRecord.newSalt(random);
+        target.setSalt(salt);
+        target.setPasswordHash(AdminExtUserRecord.hashPassword(salt, req.getPassword()));
+        userStore.writeUsers(snapshot, snapshot.getUsers());
+
+        try {
+            auditForwarder.forward(AdminExtAuditForwarder.ACTION_ACCOUNT_PASSWORD_RESET,
+                name, current.getName());
+        } catch (RuntimeException e) {
+            rollback(snapshot, before);
+            throw e;
+        }
+        return ResponseEntity.noContent().build();
+    }
+
+    @RequestMapping(value = "/{name}", method = RequestMethod.DELETE)
+    public ResponseEntity<Void> delete(@PathVariable String name) {
+        User current = requireSession();
+        if (name.equals(current.getName())) {
+            throw new ValidationException("不得删除当前登录账号");
+        }
+
+        AdminExtUserStore.Snapshot snapshot = userStore.readFresh();
+        List<AdminExtUserRecord> before = new ArrayList<>(snapshot.getUsers());
+        AdminExtUserRecord target = findOrFail(snapshot, name);
+        long adminCount = snapshot.getUsers().stream()
+            .filter(u -> AdminExtRole.ADMIN.equals(u.getRole())).count();
+        if (adminCount <= 1 && AdminExtRole.ADMIN.equals(target.getRole())) {
+            throw new ValidationException("不得删除最后一个 admin 账号（防运维自锁）");
+        }
+        List<AdminExtUserRecord> updated = new ArrayList<>(before);
+        updated.removeIf(u -> u.getUsername().equals(name));
+        userStore.writeUsers(snapshot, updated);
+
+        try {
+            auditForwarder.forward(AdminExtAuditForwarder.ACTION_ACCOUNT_DELETE,
+                name, current.getName());
+        } catch (RuntimeException e) {
+            rollback(snapshot, before);
+            throw e;
+        }
+        return ResponseEntity.noContent().build();
+    }
+
+    /** 会话 + admin 角色校验（M3-A：角色源 = AdminExtUserStore.resolveRole）。 */
+    private User requireSession() {
+        User user = SessionUserHelper.getCurrentUser();
+        if (user == null || user.getName() == null) {
+            throw new BusinessException("会话缺失（理论不可达，aspect 已强制登录）");
+        }
+        if (!AdminExtRole.ADMIN.equals(userStore.resolveRole(user.getName()))) {
+            throw new ValidationException("需要 admin 角色");
+        }
+        return user;
+    }
+
+    /** 审计投递失败后的回滚（回滚失败 = 双重故障，明示人工核查）。 */
+    private void rollback(AdminExtUserStore.Snapshot snapshot, List<AdminExtUserRecord> before) {
+        try {
+            userStore.writeUsers(snapshot, before);
+            log.warn("[admin-ext] 审计投递失败，账号变更已回滚");
+        } catch (RuntimeException e) {
+            log.error("[admin-ext] 审计投递失败且回滚失败（双重故障，须人工核查账号 Secret 与审计链）", e);
+            throw new BusinessException("账号变更与回滚均失败（须人工核查），详见服务日志");
+        }
+    }
+
+    private static AdminExtUserRecord findOrFail(AdminExtUserStore.Snapshot snapshot, String name) {
+        return snapshot.getUsers().stream().filter(u -> u.getUsername().equals(name)).findFirst()
+            .orElseThrow(() -> new ValidationException("账号不存在: " + name));
+    }
+
+    private static void validateUsername(String name) {
+        if (name == null || name.length() < 3 || name.length() > 32) {
+            throw new ValidationException("用户名长度须 3-32");
+        }
+        for (int i = 0; i < name.length(); i++) {
+            char c = name.charAt(i);
+            boolean ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+                || (c >= '0' && c <= '9') || c == '_' || c == '-';
+            if (!ok) {
+                throw new ValidationException("用户名仅允许字母/数字/下划线/连字符");
+            }
+        }
+    }
+
+    // ---- 请求体（极简 POJO）----
+
+    public static class CreateAccountRequest {
+        private String username;
+        private String displayName;
+        private String role;
+        private String password;
+
+        public String getUsername() { return username; }
+        public void setUsername(String v) { username = v; }
+        public String getDisplayName() { return displayName; }
+        public void setDisplayName(String v) { displayName = v; }
+        public String getRole() { return role; }
+        public void setRole(String v) { role = v; }
+        public String getPassword() { return password; }
+        public void setPassword(String v) { password = v; }
+    }
+
+    public static class ResetPasswordRequest {
+        private String password;
+
+        public String getPassword() { return password; }
+        public void setPassword(String v) { password = v; }
+    }
+}
