@@ -0,0 +1,81 @@
+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：
+ * 内部服务令牌 HS256 签发器（RFC 7515）。零第三方依赖（仅 JDK 8 标准库），
+ * 与 gateway-admin-service（Go）的校验逻辑保持同一约定：
+ *   - base64url 无 padding；
+ *   - header={"alg":"HS256","typ":"JWT"}，payload 键：sub/role/iss/aud/iat/exp；
+ *   - iat/exp 为 Unix 秒（long，纯数字序列化，避免浮点）。
+ *
+ * Go 端校验侧（gateway/gateway-admin-service/auth.go）：
+ * 过期、aud/iss（若声明）、角色白名单、sub 非空；本签发器默认带全量字段。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+
+/**
+ * @author admin-ext
+ */
+public final class AdminExtJwtSigner {
+
+    private static final String ALG = "HmacSHA256";
+
+    private AdminExtJwtSigner() {
+    }
+
+    /**
+     * 签发内部服务令牌。
+     *
+     * @param secret  共享密钥（≥16 字节，由 AdminExtConfig 把关）
+     * @param sub     操作人登录名（控制台会话 user.name）
+     * @param role    管理面角色（admin/auditor；角色源待 M3 User+role 扩展落地）
+     * @param issuer  签发方（默认 higress-console）
+     * @param audience 受众（默认 gateway-admin-service）
+     * @param nowSec  当前 Unix 秒（便于单测注入固定时钟）
+     * @param ttlSec  有效期秒
+     */
+    public static String sign(byte[] secret, String sub, String role, String issuer, String audience,
+                              long nowSec, long ttlSec) {
+        String header = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}";
+        String payload = "{\"sub\":\"" + jsonEscape(sub) + "\",\"role\":\"" + jsonEscape(role)
+                + "\",\"iss\":\"" + jsonEscape(issuer) + "\",\"aud\":\"" + jsonEscape(audience)
+                + "\",\"iat\":" + nowSec + ",\"exp\":" + (nowSec + ttlSec) + "}";
+        String signingInput = b64url(header.getBytes(StandardCharsets.UTF_8))
+                + "." + b64url(payload.getBytes(StandardCharsets.UTF_8));
+        return signingInput + "." + b64url(hmacSha256(secret, signingInput));
+    }
+
+    private static String jsonEscape(String s) {
+        // 登录名/角色/issuer/audience 为受控 ASCII 域，仅转义引号与反斜杠即可。
+        return s == null ? "" : s.replace("\\", "\\\\").replace("\"", "\\\"");
+    }
+
+    private static String b64url(byte[] data) {
+        return Base64.getUrlEncoder().withoutPadding().encodeToString(data);
+    }
+
+    private static byte[] hmacSha256(byte[] secret, String input) {
+        try {
+            Mac mac = Mac.getInstance(ALG);
+            mac.init(new SecretKeySpec(secret, ALG));
+            return mac.doFinal(input.getBytes(StandardCharsets.UTF_8));
+        } catch (Exception e) {
+            throw new IllegalStateException("HMAC-SHA256 不可用", e);
+        }
+    }
+
+    /**
+     * 辅助：便捷签发（缺省时钟）。供 controller 调用。
+     */
+    public static String signNow(byte[] secret, String sub, String role, long ttlSec) {
+        long now = System.currentTimeMillis() / 1000;
+        return sign(secret, sub, role, AdminExtConfig.DEFAULT_ISSUER, AdminExtConfig.DEFAULT_AUDIENCE,
+                now, ttlSec);
+    }
+}
diff --git a/backend/console/src/main/java/com/alibaba/higress/console/controller/admin/AdminExtProxyController.java b/backend/console/src/main/java/com/alibaba/higress/console/controller/admin/AdminExtProxyController.java
new file mode 100644
index 0000000..6f1ed6e
--- /dev/null
+++ b/backend/console/src/main/java/com/alibaba/higress/console/controller/admin/AdminExtProxyController.java
@@ -0,0 +1,153 @@
+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：
+ * /v1/adminext/** 通用转发端点（docs/管理门户-细化方案.md §3.1/§3.2）。
+ *
+ * 设计：
+ *  - 本 controller 不加 @AllowAnonymous → 由 ApiStandardizationAspect 强制控制台登录会话
+ *    （validateSession 通过后 SessionUserHelper 注入当前用户），不重复建账号体系；
+ *  - 转发路径 = 目标前缀(ADMIN_SVC_TARGET) + 原始 URI（含 query），保留 /v1/adminext 前缀，
+ *    gateway-admin-service 侧同一前缀路由；
+ *  - 内部令牌：以共享密钥签发 HS256 JWT（sub=会话登录名），Go 侧校验签名/过期/aud-iss/角色；
+ *    role 暂固定 admin（控制台 User 模型无角色字段，User+role 扩展在 M3 落地后改为会话角色，
+ *    见 docs/管理门户-细化方案.md §7.4 F2）；
+ *  - 敏感头（Cookie/Authorization 等）不转发，仅注入自签 Bearer，防会话泄露/头注入。
+ *
+ * 语义说明：控制台 ApiStandardizationAspect 对 DELETE 统一强制 204（上游行为），
+ * 故转发 DELETE 亦无响应体语义（管理面 M1 无删除端点，不影响）。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Set;
+
+import javax.annotation.Resource;
+import javax.servlet.http.HttpServletRequest;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.alibaba.higress.console.model.User;
+import com.alibaba.higress.console.service.SessionUserHelper;
+
+/**
+ * @author admin-ext
+ */
+@RestController
+@RequestMapping("/v1/adminext")
+public class AdminExtProxyController {
+
+    private static final Logger log = LoggerFactory.getLogger(AdminExtProxyController.class);
+
+    /** 管理面角色：M3 前控制台无角色源，内部管理面会话一律按 admin 签发。 */
+    private static final String ROLE_ADMIN = "admin";
+
+    private static final Set<String> FORWARDABLE_METHODS =
+            new HashSet<>(Arrays.asList("GET", "POST", "PUT", "PATCH", "DELETE"));
+
+    private static final int MAX_BODY_BYTES = 10 * 1024 * 1024;
+
+    @Resource
+    private AdminExtConfig config;
+
+    @RequestMapping(path = "/**")
+    public ResponseEntity<byte[]> forward(HttpServletRequest request) throws IOException {
+        User user = SessionUserHelper.getCurrentUser();
+        if (user == null || user.getName() == null) {
+            // 理论不可达（aspect 已强制登录），防御性兜底。
+            return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build();
+        }
+        if (!config.isReady()) {
+            log.error("[admin-ext] 转发配置未就绪（ADMIN_SVC_JWT_SECRET 缺失/过短或目标为空），fail-closed 拒绝");
+            return ResponseEntity.status(HttpStatus.SERVICE_UNAVAILABLE)
+                    .body("gateway-admin-service 转发配置未就绪".getBytes(java.nio.charset.StandardCharsets.UTF_8));
+        }
+
+        String method = request.getMethod();
+        if (!FORWARDABLE_METHODS.contains(method)) {
+            return ResponseEntity.status(HttpStatus.BAD_REQUEST)
+                    .body(("不支持的转发方法: " + method).getBytes(java.nio.charset.StandardCharsets.UTF_8));
+        }
+
+        String token = AdminExtJwtSigner.signNow(config.getJwtSecret(), user.getName(), ROLE_ADMIN,
+                config.getJwtTtlSeconds());
+        return proxy(request, method, token);
+    }
+
+    private ResponseEntity<byte[]> proxy(HttpServletRequest request, String method, String token)
+            throws IOException {
+        String uri = request.getRequestURI();
+        String query = request.getQueryString();
+        URL url = new URL(config.getTarget() + uri + (query == null ? "" : "?" + query));
+
+        HttpURLConnection conn = null;
+        try {
+            conn = (HttpURLConnection) url.openConnection();
+            conn.setRequestMethod(method);
+            conn.setConnectTimeout(3000);
+            conn.setReadTimeout(60000);
+            conn.setRequestProperty("Authorization", "Bearer " + token);
+            String contentType = request.getContentType();
+            if (contentType != null) {
+                conn.setRequestProperty("Content-Type", contentType);
+            }
+
+            if ("POST".equals(method) || "PUT".equals(method) || "PATCH".equals(method)) {
+                conn.setDoOutput(true);
+                byte[] body = readFully(request.getInputStream());
+                try (OutputStream out = conn.getOutputStream()) {
+                    out.write(body);
+                }
+            }
+
+            int code = conn.getResponseCode();
+            InputStream in = code >= 400 ? conn.getErrorStream() : conn.getInputStream();
+            byte[] respBody = in == null ? new byte[0] : readFully(in);
+
+            HttpHeaders headers = new HttpHeaders();
+            String respType = conn.getContentType();
+            if (respType != null) {
+                try {
+                    headers.setContentType(MediaType.parseMediaType(respType));
+                } catch (RuntimeException e) {
+                    headers.setContentType(MediaType.APPLICATION_OCTET_STREAM);
+                }
+            }
+            log.info("[admin-ext] {} {} -> {} (upstream {})", method, uri, code, url);
+            return new ResponseEntity<>(respBody, headers, HttpStatus.valueOf(code));
+        } finally {
+            if (conn != null) {
+                conn.disconnect();
+            }
+        }
+    }
+
+    private static byte[] readFully(InputStream in) throws IOException {
+        ByteArrayOutputStream buf = new ByteArrayOutputStream();
+        byte[] chunk = new byte[4096];
+        int total = 0;
+        int n;
+        while ((n = in.read(chunk)) != -1) {
+            total += n;
+            if (total > MAX_BODY_BYTES) {
+                throw new IOException("管理面请求体超过上限 " + (MAX_BODY_BYTES / 1024 / 1024) + "MB");
+            }
+            buf.write(chunk, 0, n);
+        }
+        return buf.toByteArray();
+    }
+}
diff --git a/backend/console/src/test/java/com/alibaba/higress/console/controller/admin/AdminExtJwtSignerTest.java b/backend/console/src/test/java/com/alibaba/higress/console/controller/admin/AdminExtJwtSignerTest.java
