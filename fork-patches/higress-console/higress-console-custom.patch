+++ b/frontend/src/pages/admin-ext/vendors/index.tsx
@@ -0,0 +1,210 @@
+import { Alert, Card, Col, Descriptions, Empty, Row, Spin, Statistic, Tag } from 'antd';
+import { useEffect, useState } from 'react';
+import { PageContainer } from '@ant-design/pro-layout';
+import { useTranslation } from 'react-i18next';
+import AdminExtBadge from '@/components/AdminExtBadge';
+import { getLlmProviders } from '@/services/llm-provider';
+import { LlmProvider } from '@/interfaces/llm-provider';
+import { getUsageCumulative, UsageCumulative } from '@/services/admin-ext-usage';
+
+/**
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：厂商激活与状态（只读视图）。
+ *
+ * 定位（docs/管理门户-细化方案.md §5.1/F3）：激活操作复用控制台既有
+ * AI Provider 页（含完整表单/多 token/tokenFailover），本页仅做状态汇总：
+ *  - 展示受管厂商列表与降级探测配置（tokenFailover.enabled/健康阈值/探测模型）；
+ *  - tokens 一律掩码（仅示后 4 位），不在页面二次暴露明文（§6 密钥约束）；
+ *  - 运行态（M2 收口）：密态链路累计计量摘要（tee-infer 审计链，经
+ *    gateway-admin-service 代理）。口径如实标注：明文直连 /provider/* 不计量
+ *    （V 点①定案）；计量无 provider 维度 → 不做按厂商聚合；降级事件无采集点 →
+ *    不展示降级计数（不虚构运行态）。
+ * 数据源 = 控制台既有 REST /v1/ai/providers（services/llm-provider.ts，复用不改）
+ *        + /v1/adminext/usage 累计口径（services/admin-ext-usage.ts，复用不改）。
+ */
+
+const maskToken = (token: string): string => {
+  const s = token.trim();
+  return s.length > 4 ? `****${s.slice(-4)}` : '****';
+};
+
+/** 累计口径全租户加总（数据源 = tee-infer 审计链，免疫重启丢失）。 */
+const sumCumulative = (u: UsageCumulative) => {
+  let tokensIn = 0;
+  let tokensOut = 0;
+  let requests = 0;
+  let denies = 0;
+  Object.values(u || {}).forEach((t) => {
+    tokensIn += t.tokens_in || 0;
+    tokensOut += t.tokens_out || 0;
+    requests += t.requests || 0;
+    denies += t.denies || 0;
+  });
+  return { tokensIn, tokensOut, requests, denies };
+};
+
+const ProviderStatus: React.FC = () => {
+  const { t } = useTranslation();
+  const [list, setList] = useState<LlmProvider[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [runtime, setRuntime] = useState<UsageCumulative>({});
+  const [runtimeLoading, setRuntimeLoading] = useState(false);
+  const [runtimeError, setRuntimeError] = useState(false);
+
+  useEffect(() => {
+    let cancelled = false;
+    setLoading(true);
+    getLlmProviders()
+      .then((providers) => {
+        if (!cancelled) {
+          setList(providers || []);
+          setError(null);
+        }
+      })
+      .catch((e) => {
+        if (!cancelled) {
+          setError(String(e));
+        }
+      })
+      .finally(() => {
+        if (!cancelled) {
+          setLoading(false);
+        }
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  useEffect(() => {
+    let cancelled = false;
+    setRuntimeLoading(true);
+    getUsageCumulative()
+      .then((u) => {
+        if (!cancelled) {
+          setRuntime(u || {});
+          setRuntimeError(false);
+        }
+      })
+      .catch(() => {
+        // 503（数据源未配置/不可达）等：页面内如实提示，全局拦截器已弹错误框
+        if (!cancelled) {
+          setRuntimeError(true);
+        }
+      })
+      .finally(() => {
+        if (!cancelled) {
+          setRuntimeLoading(false);
+        }
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  const runtimeTotal = sumCumulative(runtime);
+
+  return (
+    <PageContainer>
+      <AdminExtBadge />
+      <Alert
+        type="info"
+        showIcon
+        message={t('adminExt.vendors.guide')}
+        style={{ marginBottom: 16 }}
+      />
+      {loading && (
+        <div style={{ textAlign: 'center', padding: 48 }}>
+          <Spin />
+        </div>
+      )}
+      {!loading && error && (
+        <Alert type="error" showIcon message={error} style={{ marginBottom: 16 }} />
+      )}
+      {!loading && !error && list.length === 0 && (
+        <Empty description={t('adminExt.vendors.empty')} />
+      )}
+      {!loading &&
+        !error &&
+        list.map((p) => {
+          const failover = p.tokenFailoverConfig;
+          return (
+            <Card
+              key={p.name}
+              size="small"
+              style={{ marginBottom: 12 }}
+              title={
+                <span>
+                  {p.name} <Tag>{p.type}</Tag>
+                </span>
+              }
+            >
+              <Descriptions column={2} size="small">
+                <Descriptions.Item label={t('adminExt.vendors.protocol')}>
+                  {p.protocol || '-'}
+                </Descriptions.Item>
+                <Descriptions.Item label={t('adminExt.vendors.proxyName')}>
+                  {p.proxyName || '-'}
+                </Descriptions.Item>
+                <Descriptions.Item label={t('adminExt.vendors.tokens')}>
+                  {p.tokens && p.tokens.length > 0
+                    ? p.tokens.map((tk) => maskToken(tk)).join('，')
+                    : '-'}
+                </Descriptions.Item>
+                <Descriptions.Item label={t('adminExt.vendors.healthCheck')}>
+                  {failover && failover.enabled ? (
+                    <>
+                      <Tag color="green">{t('adminExt.vendors.enabled')}</Tag>
+                      {`${t('adminExt.vendors.failureThreshold')} ${failover.failureThreshold ?? '-'} / ${t(
+                        'adminExt.vendors.healthCheckModel',
+                      )} ${failover.healthCheckModel || '-'}`}
+                    </>
+                  ) : (
+                    <Tag>{t('adminExt.vendors.disabled')}</Tag>
+                  )}
+                </Descriptions.Item>
+              </Descriptions>
+            </Card>
+          );
+        })}
+
+      <Card size="small" title={t('adminExt.vendors.runtimeTitle')} style={{ marginTop: 16 }}>
+        {runtimeError ? (
+          <Alert type="warning" showIcon message={t('adminExt.vendors.runtimeUnavailable')} />
+        ) : runtimeLoading ? (
+          <div style={{ textAlign: 'center', padding: 24 }}>
+            <Spin />
+          </div>
+        ) : (
+          <>
+            <Row gutter={16}>
+              <Col span={6}>
+                <Statistic title={t('adminExt.usage.requests')} value={runtimeTotal.requests} />
+              </Col>
+              <Col span={6}>
+                <Statistic title={t('adminExt.usage.tokensIn')} value={runtimeTotal.tokensIn} />
+              </Col>
+              <Col span={6}>
+                <Statistic title={t('adminExt.usage.tokensOut')} value={runtimeTotal.tokensOut} />
+              </Col>
+              <Col span={6}>
+                <Statistic
+                  title={t('adminExt.vendors.runtimeDenied')}
+                  value={runtimeTotal.denies}
+                />
+              </Col>
+            </Row>
+            <Alert
+              type="info"
+              showIcon
+              message={t('adminExt.vendors.runtimeGuide')}
+              style={{ marginTop: 12 }}
+            />
+          </>
+        )}
+      </Card>
+    </PageContainer>
+  );
+};
+
+export default ProviderStatus;
