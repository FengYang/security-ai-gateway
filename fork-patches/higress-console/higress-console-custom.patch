--- /dev/null
+++ b/frontend/src/pages/admin-ext/accounts/index.tsx
@@ -0,0 +1,339 @@
+import { PlusOutlined, ReloadOutlined } from '@ant-design/icons';
+import { PageContainer } from '@ant-design/pro-layout';
+import {
+  Alert,
+  Button,
+  Empty,
+  Form,
+  Input,
+  message,
+  Modal,
+  Popconfirm,
+  Select,
+  Space,
+  Spin,
+  Table,
+  Tag,
+} from 'antd';
+import { useCallback, useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import AdminExtBadge from '@/components/AdminExtBadge';
+import {
+  AdminExtAccountView,
+  createAccount,
+  deleteAccount,
+  listAccounts,
+  resetAccountPassword,
+} from '@/services/admin-ext-accounts';
+
+/**
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：账号与角色管理（M3-A-2）。
+ *
+ * 定位（docs/管理门户-细化方案.md §5「系统 → 账号与角色 [新/最小]」）：
+ * 自研账号（独立 K8s Secret 账号表）的列表/创建/重置密码/删除。
+ *
+ * 安全边界（§4，D10）：
+ *  - 全部端点服务端强制 admin 角色，auditor 访问本页将收到后端拒绝（前端隐藏入口
+ *    仅为体验手段、不承担安全职责；当前会话 API 无角色声明，故菜单不按角色隐藏）；
+ *  - 服务端硬约束（前端仅提示，不重复实现）：不得删除当前登录账号、
+ *    不得删除最后一个 admin（防运维自锁）、密码强度 ≥8 位含字母+数字；
+ *  - 密码二次确认缓解输错风险（登录失败 5 次锁定 15 分钟，输错代价高）；
+ *  - 所有写操作落审计链（G1，fail-closed）。
+ */
+
+const AccountManagement: React.FC = () => {
+  const { t } = useTranslation();
+  const [createForm] = Form.useForm();
+  const [resetForm] = Form.useForm();
+  const [list, setList] = useState<AdminExtAccountView[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [createOpen, setCreateOpen] = useState(false);
+  const [resetTarget, setResetTarget] = useState<AdminExtAccountView | null>(null);
+  const [submitting, setSubmitting] = useState(false);
+
+  const reload = useCallback(() => {
+    setLoading(true);
+    listAccounts()
+      .then((resp) => {
+        setList(resp || []);
+        setError(null);
+      })
+      .catch((e) => setError(String(e)))
+      .finally(() => setLoading(false));
+  }, []);
+
+  useEffect(() => {
+    reload();
+  }, [reload]);
+
+  const openCreate = () => {
+    createForm.resetFields();
+    setCreateOpen(true);
+  };
+
+  const openReset = (u: AdminExtAccountView) => {
+    resetForm.resetFields();
+    setResetTarget(u);
+  };
+
+  const submitCreate = async () => {
+    const values = await createForm.validateFields();
+    setSubmitting(true);
+    try {
+      await createAccount({
+        username: values.username,
+        displayName: values.displayName,
+        role: values.role,
+        password: values.password,
+      });
+      message.success(t('adminExt.accounts.created'));
+      setCreateOpen(false);
+      reload();
+    } catch (e) {
+      message.error(String(e));
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  const submitReset = async () => {
+    if (!resetTarget) {
+      return;
+    }
+    const values = await resetForm.validateFields();
+    setSubmitting(true);
+    try {
+      await resetAccountPassword(resetTarget.username, values.password);
+      message.success(t('adminExt.accounts.passwordReset'));
+      setResetTarget(null);
+      reload();
+    } catch (e) {
+      message.error(String(e));
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  const remove = async (u: AdminExtAccountView) => {
+    try {
+      await deleteAccount(u.username);
+      message.success(t('adminExt.accounts.deleted'));
+      reload();
+    } catch (e) {
+      message.error(String(e));
+    }
+  };
+
+  const passwordRules = [
+    { required: true, message: t('adminExt.accounts.required') },
+    {
+      pattern: /^(?=.*[A-Za-z])(?=.*\d).{8,}$/,
+      message: t('adminExt.accounts.passwordRule'),
+    },
+  ];
+
+  const columns = [
+    {
+      title: t('adminExt.accounts.colUsername'),
+      dataIndex: 'username',
+      key: 'username',
+    },
+    {
+      title: t('adminExt.accounts.colDisplayName'),
+      dataIndex: 'displayName',
+      key: 'displayName',
+      render: (v: string) => v || '-',
+    },
+    {
+      title: t('adminExt.accounts.colRole'),
+      dataIndex: 'role',
+      key: 'role',
+      render: (v: string) =>
+        v === 'admin' ? (
+          <Tag color="geekblue">{t('adminExt.accounts.roleAdmin')}</Tag>
+        ) : (
+          <Tag color="orange">{t('adminExt.accounts.roleAuditor')}</Tag>
+        ),
+    },
+    {
+      title: t('adminExt.accounts.colActions'),
+      key: 'actions',
+      render: (_: unknown, u: AdminExtAccountView) => (
+        <Space>
+          <Button size="small" onClick={() => openReset(u)}>
+            {t('adminExt.accounts.reset')}
+          </Button>
+          <Popconfirm
+            title={t('adminExt.accounts.deleteConfirm')}
+            description={t('adminExt.accounts.deleteWarning')}
+            onConfirm={() => remove(u)}
+            okText={t('adminExt.accounts.delete')}
+          >
+            <Button size="small" danger>
+              {t('adminExt.accounts.delete')}
+            </Button>
+          </Popconfirm>
+        </Space>
+      ),
+    },
+  ];
+
+  return (
+    <PageContainer>
+      <AdminExtBadge />
+      <Alert
+        type="info"
+        showIcon
+        message={t('adminExt.accounts.guide')}
+        style={{ marginBottom: 16 }}
+      />
+      <Alert
+        type="info"
+        showIcon
+        message={t('adminExt.accounts.oidcReserve')}
+        style={{ marginBottom: 16 }}
+      />
+      {error && <Alert type="error" showIcon message={error} style={{ marginBottom: 16 }} />}
+
+      <Space style={{ marginBottom: 16 }}>
+        <Button type="primary" icon={<PlusOutlined />} onClick={openCreate}>
+          {t('adminExt.accounts.add')}
+        </Button>
+        <Button icon={<ReloadOutlined />} onClick={reload}>
+          {t('adminExt.accounts.refresh')}
+        </Button>
+      </Space>
+
+      {loading && (
+        <div style={{ textAlign: 'center', padding: 48 }}>
+          <Spin />
+        </div>
+      )}
+      {!loading && !error && list.length === 0 && (
+        <Empty description={t('adminExt.accounts.empty')} />
+      )}
+      {!loading && list.length > 0 && (
+        <Table
+          rowKey="username"
+          columns={columns}
+          dataSource={list}
+          pagination={false}
+          size="middle"
+        />
+      )}
+
+      <Modal
+        open={createOpen}
+        title={t('adminExt.accounts.add')}
+        onCancel={() => setCreateOpen(false)}
+        onOk={submitCreate}
+        confirmLoading={submitting}
+        okText={t('adminExt.accounts.submit')}
+        destroyOnClose
+      >
+        <Form form={createForm} layout="vertical">
+          <Form.Item
+            name="username"
+            label={t('adminExt.accounts.colUsername')}
+            extra={t('adminExt.accounts.usernameTip')}
+            rules={[
+              { required: true, message: t('adminExt.accounts.required') },
+              {
+                pattern: /^[A-Za-z0-9_-]{3,32}$/,
+                message: t('adminExt.accounts.usernameRule'),
+              },
+            ]}
+          >
+            <Input placeholder="auditor01" autoComplete="off" />
+          </Form.Item>
+          <Form.Item
+            name="displayName"
+            label={t('adminExt.accounts.colDisplayName')}
+          >
+            <Input placeholder="审计员" />
+          </Form.Item>
+          <Form.Item
+            name="role"
+            label={t('adminExt.accounts.colRole')}
+            rules={[{ required: true, message: t('adminExt.accounts.required') }]}
+          >
+            <Select>
+              <Select.Option value="admin">{t('adminExt.accounts.roleAdmin')}</Select.Option>
+              <Select.Option value="auditor">
+                {t('adminExt.accounts.roleAuditor')}
+              </Select.Option>
+            </Select>
+          </Form.Item>
+          <Form.Item
+            name="password"
+            label={t('adminExt.accounts.password')}
+            extra={t('adminExt.accounts.passwordTip')}
+            rules={passwordRules}
+          >
+            <Input.Password autoComplete="new-password" />
+          </Form.Item>
+          <Form.Item
+            name="confirm"
+            label={t('adminExt.accounts.confirm')}
+            dependencies={['password']}
+            rules={[
+              { required: true, message: t('adminExt.accounts.required') },
+              ({ getFieldValue }) => ({
+                validator(_, value) {
+                  if (!value || getFieldValue('password') === value) {
+                    return Promise.resolve();
+                  }
+                  return Promise.reject(new Error(t('adminExt.accounts.passwordMismatch')));
+                },
+              }),
+            ]}
+          >
+            <Input.Password autoComplete="new-password" />
+          </Form.Item>
+        </Form>
+      </Modal>
+
+      <Modal
+        open={!!resetTarget}
+        title={`${t('adminExt.accounts.reset')}：${resetTarget?.username || ''}`}
+        onCancel={() => setResetTarget(null)}
+        onOk={submitReset}
+        confirmLoading={submitting}
+        okText={t('adminExt.accounts.submit')}
+        destroyOnClose
+      >
+        <Form form={resetForm} layout="vertical">
+          <Form.Item
+            name="password"
+            label={t('adminExt.accounts.password')}
+            extra={t('adminExt.accounts.passwordTip')}
+            rules={passwordRules}
+          >
+            <Input.Password autoComplete="new-password" />
+          </Form.Item>
+          <Form.Item
+            name="confirm"
+            label={t('adminExt.accounts.confirm')}
+            dependencies={['password']}
+            rules={[
+              { required: true, message: t('adminExt.accounts.required') },
+              ({ getFieldValue }) => ({
+                validator(_, value) {
+                  if (!value || getFieldValue('password') === value) {
+                    return Promise.resolve();
+                  }
+                  return Promise.reject(new Error(t('adminExt.accounts.passwordMismatch')));
+                },
+              }),
+            ]}
+          >
+            <Input.Password autoComplete="new-password" />
+          </Form.Item>
+        </Form>
+      </Modal>
+    </PageContainer>
+  );
+};
+
+export default AccountManagement;
