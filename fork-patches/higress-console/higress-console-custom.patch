diff --git a/frontend/src/pages/admin-ext/credentials/index.tsx b/frontend/src/pages/admin-ext/credentials/index.tsx
new file mode 100644
index 0000000..15e7adf
--- /dev/null
+++ b/frontend/src/pages/admin-ext/credentials/index.tsx
@@ -0,0 +1,311 @@
+import {
+  CopyOutlined,
+  PlusOutlined,
+  ReloadOutlined,
+} from '@ant-design/icons';
+import { PageContainer } from '@ant-design/pro-layout';
+import {
+  Alert,
+  Button,
+  Card,
+  Descriptions,
+  Empty,
+  Form,
+  Input,
+  message,
+  Modal,
+  Popconfirm,
+  Space,
+  Spin,
+  Tag,
+  Typography,
+} from 'antd';
+import { useCallback, useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import {
+  BrokerProviderView,
+  deleteBrokerProvider,
+  listBrokerProviders,
+  upsertBrokerProvider,
+} from '@/services/admin-ext-broker';
+import { listModels, ModelCatalog } from '@/services/admin-ext-models';
+
+/**
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：broker 凭据托管。
+ *
+ * 定位（docs/管理门户-apiTokens-Secret化-M2细化方案.md §2.1.3，D-4 定案）：
+ * 采用 **admin-ext 独立入口**（不改控制台上游 ProviderForm 业务组件，故 fork 白名单不扩容）。
+ * 管理员在此写入/轮换厂商 Key → 落 broker 凭据目录（CR 不含 token）→ 复制生成的
+ * customUrl 到「技术配置 → AI 服务提供者」建 provider（tokens 留空）。
+ *
+ * 安全（§2.1.5/§2.4）：
+ *  - Key 一经提交即不可回读，列表仅展示 8 位不可逆指纹（用于确认轮换生效）；
+ *  - 写/删操作仅 admin 角色可用，auditor 将收到 403（后端按用户名白名单派生角色）；
+ *  - CR 漂移（CR 指向 broker 但凭据已删）在页首显式告警。
+ *
+ * B-2（决策门 #6 最小补齐）：列表项标注**托管模式**；并以 **明文模式** 告警列出
+ * 仍被 AI 路由引用的明文 Key provider（数据源 = A-1' models 端点的 hasPlaintextToken），
+ * 提示迁移到本页托管。后端零改动（复用既有两端点）。
+ */
+
+const DEFAULT_PATH_PREFIXES = '/v1/chat/completions,/v1/models,/v1/embeddings';
+
+const CredentialHosting: React.FC = () => {
+  const { t } = useTranslation();
+  const [form] = Form.useForm();
+  const [list, setList] = useState<BrokerProviderView[]>([]);
+  const [orphans, setOrphans] = useState<string[]>([]);
+  const [plaintextProviders, setPlaintextProviders] = useState<string[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [modalOpen, setModalOpen] = useState(false);
+  const [editing, setEditing] = useState<BrokerProviderView | null>(null);
+  const [customUrl, setCustomUrl] = useState<string>('');
+  const [submitting, setSubmitting] = useState(false);
+
+  const reload = useCallback(() => {
+    setLoading(true);
+    // models 端点仅用于明文模式标注：取数失败不影响本页主功能（降级为空，不臆造）
+    Promise.all([
+      listBrokerProviders(),
+      listModels().catch((): ModelCatalog => ({ routes: [] })),
+    ])
+      .then(([resp, catalog]) => {
+        setList(resp?.providers || []);
+        setOrphans(resp?.orphanDetected || []);
+        const plain = Array.from(
+          new Set(
+            (catalog?.routes || [])
+              .filter((r) => r.hasPlaintextToken)
+              .map((r) => r.provider),
+          ),
+        ).sort();
+        setPlaintextProviders(plain);
+        setError(null);
+      })
+      .catch((e) => setError(String(e)))
+      .finally(() => setLoading(false));
+  }, []);
+
+  useEffect(() => {
+    reload();
+  }, [reload]);
+
+  const openCreate = () => {
+    setEditing(null);
+    setCustomUrl('');
+    form.resetFields();
+    form.setFieldsValue({ allowPathPrefixes: DEFAULT_PATH_PREFIXES });
+    setModalOpen(true);
+  };
+
+  const openRotate = (p: BrokerProviderView) => {
+    setEditing(p);
+    setCustomUrl('');
+    form.resetFields();
+    form.setFieldsValue({ name: p.name, upstream: p.upstream });
+    setModalOpen(true);
+  };
+
+  const submit = async () => {
+    const values = await form.validateFields();
+    const paths = (values.allowPathPrefixes || '')
+      .split(',')
+      .map((s: string) => s.trim())
+      .filter((s: string) => s.length > 0);
+    setSubmitting(true);
+    try {
+      const res = await upsertBrokerProvider(values.name, {
+        upstream: values.upstream,
+        key: values.key,
+        allowPathPrefixes: paths,
+      });
+      setCustomUrl(res?.customUrl || '');
+      message.success(t('adminExt.credentials.saved'));
+      reload();
+    } catch (e) {
+      // 403 = 当前会话非管理员（后端白名单派生角色）
+      message.error(String(e));
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  const remove = async (p: BrokerProviderView) => {
+    try {
+      const res = await deleteBrokerProvider(p.name);
+      message.warning(res?.warning || t('adminExt.credentials.deleted'));
+      reload();
+    } catch (e) {
+      message.error(String(e));
+    }
+  };
+
+  const copyCustomUrl = async (url: string) => {
+    try {
+      await navigator.clipboard.writeText(url);
+      message.success(t('adminExt.credentials.copied'));
+    } catch {
+      message.warning(url);
+    }
+  };
+
+  return (
+    <PageContainer>
+      <Alert
+        type="info"
+        showIcon
+        message={t('adminExt.credentials.guide')}
+        style={{ marginBottom: 16 }}
+      />
+      {orphans.length > 0 && (
+        <Alert
+          type="warning"
+          showIcon
+          message={t('adminExt.credentials.orphanTitle')}
+          description={`${t('adminExt.credentials.orphanTip')}：${orphans.join('，')}`}
+          style={{ marginBottom: 16 }}
+        />
+      )}
+      {plaintextProviders.length > 0 && (
+        <Alert
+          type="warning"
+          showIcon
+          message={`${t('adminExt.credentials.plaintextTitle')}（${plaintextProviders.length}）`}
+          description={`${t('adminExt.credentials.plaintextTip')}：${plaintextProviders.join('，')}`}
+          style={{ marginBottom: 16 }}
+        />
+      )}
+      {error && <Alert type="error" showIcon message={error} style={{ marginBottom: 16 }} />}
+
+      <Space style={{ marginBottom: 16 }}>
+        <Button type="primary" icon={<PlusOutlined />} onClick={openCreate}>
+          {t('adminExt.credentials.add')}
+        </Button>
+        <Button icon={<ReloadOutlined />} onClick={reload}>
+          {t('adminExt.credentials.refresh')}
+        </Button>
+      </Space>
+
+      {loading && (
+        <div style={{ textAlign: 'center', padding: 48 }}>
+          <Spin />
+        </div>
+      )}
+      {!loading && !error && list.length === 0 && (
+        <Empty description={t('adminExt.credentials.empty')} />
+      )}
+      {!loading &&
+        list.map((p) => (
+          <Card
+            key={p.name}
+            size="small"
+            style={{ marginBottom: 12 }}
+            title={
+              <span>
+                {p.name} <Tag color="blue">{t('adminExt.credentials.hosted')}</Tag>
+              </span>
+            }
+            extra={
+              <Space>
+                <Button size="small" onClick={() => openRotate(p)}>
+                  {t('adminExt.credentials.rotate')}
+                </Button>
+                <Popconfirm
+                  title={t('adminExt.credentials.deleteConfirm')}
+                  description={t('adminExt.credentials.deleteWarning')}
+                  onConfirm={() => remove(p)}
+                  okText={t('adminExt.credentials.delete')}
+                >
+                  <Button size="small" danger>
+                    {t('adminExt.credentials.delete')}
+                  </Button>
+                </Popconfirm>
+              </Space>
+            }
+          >
+            <Descriptions column={2} size="small">
+              <Descriptions.Item label={t('adminExt.credentials.upstream')}>
+                {p.upstream}
+              </Descriptions.Item>
+              <Descriptions.Item label={t('adminExt.credentials.pathCount')}>
+                {p.pathCount}
+              </Descriptions.Item>
+              <Descriptions.Item label={t('adminExt.credentials.fingerprint')}>
+                <Typography.Text code>{p.keyFingerprint || '-'}</Typography.Text>
+              </Descriptions.Item>
+              <Descriptions.Item label={t('adminExt.credentials.updatedAt')}>
+                {p.updatedAt || '-'}
+              </Descriptions.Item>
+            </Descriptions>
+          </Card>
+        ))}
+
+      <Modal
+        open={modalOpen}
+        title={editing ? t('adminExt.credentials.rotate') : t('adminExt.credentials.add')}
+        onCancel={() => setModalOpen(false)}
+        onOk={submit}
+        confirmLoading={submitting}
+        okText={t('adminExt.credentials.submit')}
+        destroyOnClose
+      >
+        <Form form={form} layout="vertical">
+          <Form.Item
+            name="name"
+            label={t('adminExt.credentials.formProvider')}
+            extra={t('adminExt.credentials.formProviderTip')}
+            rules={[{ required: true, message: t('adminExt.credentials.required') }]}
+          >
+            <Input disabled={!!editing} placeholder="phala" />
+          </Form.Item>
+          <Form.Item
+            name="upstream"
+            label={t('adminExt.credentials.formUpstream')}
+            rules={[{ required: true, message: t('adminExt.credentials.required') }]}
+          >
+            <Input placeholder="https://inference.phala.com" />
+          </Form.Item>
+          <Form.Item
+            name="key"
+            label={t('adminExt.credentials.formKey')}
+            extra={t('adminExt.credentials.formKeyTip')}
+            rules={[{ required: true, message: t('adminExt.credentials.required') }]}
+          >
+            <Input.Password autoComplete="new-password" placeholder="sk-..." />
+          </Form.Item>
+          <Form.Item
+            name="allowPathPrefixes"
+            label={t('adminExt.credentials.formPaths')}
+            extra={t('adminExt.credentials.formPathsTip')}
+          >
+            <Input placeholder={DEFAULT_PATH_PREFIXES} />
+          </Form.Item>
+        </Form>
+
+        {customUrl && (
+          <Alert
+            type="success"
+            showIcon
+            message={t('adminExt.credentials.customUrlTitle')}
+            description={
+              <Space direction="vertical" style={{ width: '100%' }}>
+                <Typography.Text code copyable={false}>
+                  {customUrl}
+                </Typography.Text>
+                <Button size="small" icon={<CopyOutlined />} onClick={() => copyCustomUrl(customUrl)}>
+                  {t('adminExt.credentials.copy')}
+                </Button>
+                <Typography.Text type="secondary">
+                  {t('adminExt.credentials.customUrlTip')}
+                </Typography.Text>
+              </Space>
+            }
+          />
+        )}
+      </Modal>
+    </PageContainer>
+  );
+};
+
+export default CredentialHosting;
diff --git a/frontend/src/pages/admin-ext/models/index.tsx b/frontend/src/pages/admin-ext/models/index.tsx
new file mode 100644
index 0000000..61e1764
--- /dev/null
+++ b/frontend/src/pages/admin-ext/models/index.tsx
@@ -0,0 +1,183 @@
+import { ReloadOutlined, SearchOutlined } from '@ant-design/icons';
+import { PageContainer } from '@ant-design/pro-layout';
+import { Alert, Button, Input, Space, Table, Tag, Typography } from 'antd';
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { listModels, ModelRouteEntry } from '@/services/admin-ext-models';
+
+/**
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：模型目录（M2 A-1'，只读）。
+ *
+ * 展示「可用模型 + 默认映射 + 所属厂商/provider」（重排计划 §3 A-1'）：
+ *  - 一行 = 一条 ai-route 上游（route × provider 绑定，含权重）；
+ *  - 链路形态标注：密态托管（经 broker）/ 明文 Key（CR 仍存 apiTokens，待迁移）/ 直连；
+ *  - 配置变更入口在控制台 技术配置 → AI 路由 / AI 服务提供者，本页不做写操作。
+ * 数据源 = gateway-admin-service GET /v1/adminext/models（无数据源时返回空列表）。
+ */
+
+const ModelCatalogPage: React.FC = () => {
+  const { t } = useTranslation();
+  const [list, setList] = useState<ModelRouteEntry[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [keyword, setKeyword] = useState('');
+
+  const reload = useCallback(() => {
+    setLoading(true);
+    listModels()
+      .then((resp) => {
+        setList(resp?.routes || []);
+        setError(null);
+      })
+      .catch((e) => setError(String(e)))
+      .finally(() => setLoading(false));
+  }, []);
+
+  useEffect(() => {
+    reload();
+  }, [reload]);
+
+  // 客户端过滤（目录体量小）：路由 / 路径 / 模型 / 厂商
+  const filtered = useMemo(() => {
+    const kw = keyword.trim().toLowerCase();
+    if (!kw) {
+      return list;
+    }
+    return list.filter((r) =>
+      [r.route, r.path, r.provider, ...(r.models || [])].some((v) =>
+        (v || '').toLowerCase().includes(kw)),
+      );
+  }, [list, keyword]);
+
+  const columns = [
+    {
+      title: t('adminExt.models.route'),
+      dataIndex: 'route',
+      key: 'route',
+      width: 180,
+      ellipsis: true,
+    },
+    {
+      title: t('adminExt.models.path'),
+      dataIndex: 'path',
+      key: 'path',
+      width: 160,
+      render: (value: string) => (
+        <Typography.Text code>{value || '-'}</Typography.Text>
+      ),
+    },
+    {
+      title: t('adminExt.models.models'),
+      dataIndex: 'models',
+      key: 'models',
+      render: (value: string[]) =>
+        value && value.length > 0 ? (
+          <Space wrap size={4}>
+            {value.map((m) => (
+              <Tag key={m}>{m}</Tag>
+            ))}
+          </Space>
+        ) : (
+          <Tag>{t('adminExt.models.unrestricted')}</Tag>
+        ),
+    },
+    {
+      title: t('adminExt.models.defaultMapping'),
+      dataIndex: 'defaultMapping',
+      key: 'defaultMapping',
+      render: (value: Record<string, string> | null | undefined) => {
+        const entries = Object.entries(value || {});
+        if (entries.length === 0) {
+          return '-';
+        }
+        return (
+          <Space direction="vertical" size={0}>
+            {entries.map(([from, to]) => (
+              <Typography.Text key={from} code>
+                {from} → {to}
+              </Typography.Text>
+            ))}
+          </Space>
+        );
+      },
+    },
+    {
+      title: t('adminExt.models.provider'),
+      dataIndex: 'provider',
+      key: 'provider',
+      render: (_, record: ModelRouteEntry) => (
+        <Space direction="vertical" size={0}>
+          <span>{record.provider}</span>
+          {(record.providerType || record.providerProtocol) && (
+            <Typography.Text type="secondary">
+              {[record.providerType, record.providerProtocol]
+                .filter(Boolean)
+                .join(' / ')}
+            </Typography.Text>
+          )}
+        </Space>
+      ),
+    },
+    {
+      title: t('adminExt.models.mode'),
+      key: 'mode',
+      width: 110,
+      render: (_, record: ModelRouteEntry) => {
+        if (record.viaBroker) {
+          return <Tag color="green">{t('adminExt.models.modeBroker')}</Tag>;
+        }
+        if (record.hasPlaintextToken) {
+          return <Tag color="red">{t('adminExt.models.modePlaintext')}</Tag>;
+        }
+        return <Tag>{t('adminExt.models.modeDirect')}</Tag>;
+      },
+    },
+    {
+      title: t('adminExt.models.weight'),
+      dataIndex: 'weight',
+      key: 'weight',
+      width: 80,
+      align: 'center' as const,
+    },
+  ];
+
+  return (
+    <PageContainer>
+      <Alert
+        type="info"
+        showIcon
+        message={t('adminExt.models.guide')}
+        style={{ marginBottom: 16 }}
+      />
+      {error && (
+        <Alert type="error" showIcon message={error} style={{ marginBottom: 16 }} />
+      )}
+
+      <Space style={{ marginBottom: 16 }}>
+        <Input
+          allowClear
+          prefix={<SearchOutlined />}
+          style={{ width: 280 }}
+          placeholder={t('adminExt.models.filterPlaceholder') as string}
+          value={keyword}
+          onChange={(e) => setKeyword(e.target.value)}
+        />
+        <Button icon={<ReloadOutlined />} onClick={reload}>
+          {t('adminExt.models.refresh')}
+        </Button>
+      </Space>
+
+      <Table
+        rowKey={(r: ModelRouteEntry) => `${r.route}/${r.provider}`}
+        size="middle"
+        loading={loading}
+        dataSource={filtered}
+        columns={columns}
+        locale={{ emptyText: t('adminExt.models.empty') }}
+        pagination={{ pageSize: 20, hideOnSinglePage: true }}
+      />
+    </PageContainer>
+  );
+};
+
+export default ModelCatalogPage;
diff --git a/frontend/src/pages/admin-ext/usage/index.tsx b/frontend/src/pages/admin-ext/usage/index.tsx
new file mode 100644
index 0000000..d860c97
--- /dev/null
+++ b/frontend/src/pages/admin-ext/usage/index.tsx
@@ -0,0 +1,360 @@
+import { ReloadOutlined } from '@ant-design/icons';
+import { Line } from '@ant-design/charts';
+import { PageContainer } from '@ant-design/pro-layout';
+import {
+  Alert,
+  AutoComplete,
+  Button,
+  Card,
+  Col,
+  Form,
+  InputNumber,
+  message,
+  Row,
+  Select,
+  Space,
+  Statistic,
+  Table,
+  TableColumnsType,
+  Tag,
+  Typography,
+} from 'antd';
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import {
+  getUsage,
+  setQuota,
+  TenantUsage,
+  UsageResponse,
+} from '@/services/admin-ext-usage';
+
+/**
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：用量看板与配额（M2 A-2'）。
+ *
+ * 数据源 = tee-infer 审计链增量聚合（计量唯一真源），经 gateway-admin-service 代理：
+ *  - 看板：时间范围 × 租户过滤 的 请求/token 计量（表格 + 按时间桶趋势）；
+ *  - 配额：租户维度 max_tokens 设置（admin 写操作，后端落审计链）；
+ *  - 金额列不出现（现仅计量无单价，项目硬约束）；
+ *  - 明文直连 /provider/* 链路不计量（V 点①定案）。
+ * 趋势实现：tee-infer /usage 仅有区间聚合接口，前端按时间桶并发查询后拼接
+ * （每桶一次 [from, to) 增量，数字与真源逐项一致）。
+ */
+
+type RangeKey = '24h' | '7d' | '30d';
+
+interface RangeOption {
+  key: RangeKey;
+  /** 窗口总时长（小时） */
+  hours: number;
+  /** 趋势桶数 */
+  buckets: number;
+  labelKey: string;
+}
+
+const RANGE_OPTIONS: RangeOption[] = [
+  { key: '24h', hours: 24, buckets: 24, labelKey: 'adminExt.usage.range24h' },
+  { key: '7d', hours: 24 * 7, buckets: 7, labelKey: 'adminExt.usage.range7d' },
+  { key: '30d', hours: 24 * 30, buckets: 30, labelKey: 'adminExt.usage.range30d' },
+];
+
+/** 趋势桶（一次 [from, to) 增量查询的载体）。 */
+interface TrendBucket {
+  label: string;
+  from: string;
+  to: string;
+  tokensIn: number;
+  tokensOut: number;
+  requests: number;
+}
+
+/** 表格行：租户 × 用量。 */
+interface TenantRow extends TenantUsage {
+  name: string;
+}
+
+const pad2 = (n: number) => String(n).padStart(2, '0');
+
+/** 桶标签：24h 窗口用 HH:mm，按日窗口用 MM-DD。 */
+const bucketLabel = (d: Date, range: RangeOption): string => {
+  if (range.key === '24h') {
+    return `${pad2(d.getUTCHours())}:${pad2(d.getUTCMinutes())}`;
+  }
+  return `${pad2(d.getUTCMonth() + 1)}-${pad2(d.getUTCDate())}`;
+};
+
+const buildBuckets = (range: RangeOption): TrendBucket[] => {
+  const now = Date.now();
+  const spanMs = range.hours * 3600_000;
+  const bucketMs = spanMs / range.buckets;
+  const start = now - spanMs;
+  return Array.from({ length: range.buckets }, (_, i) => {
+    const from = new Date(start + i * bucketMs);
+    const to = new Date(start + (i + 1) * bucketMs);
+    return {
+      label: bucketLabel(from, range),
+      from: from.toISOString(),
+      to: to.toISOString(),
+      tokensIn: 0,
+      tokensOut: 0,
+      requests: 0,
+    };
+  });
+};
+
+/** 区间内全部租户用量加总。 */
+const sumTenants = (resp: UsageResponse): { tokensIn: number; tokensOut: number; requests: number } => {
+  let tokensIn = 0;
+  let tokensOut = 0;
+  let requests = 0;
+  Object.values(resp?.tenants || {}).forEach((t) => {
+    tokensIn += t.tokens_in || 0;
+    tokensOut += t.tokens_out || 0;
+    requests += t.requests || 0;
+  });
+  return { tokensIn, tokensOut, requests };
+};
+
+const UsageDashboardPage: React.FC = () => {
+  const { t } = useTranslation();
+  const [rangeKey, setRangeKey] = useState<RangeKey>('7d');
+  const [tenant, setTenant] = useState<string>('');
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [tenants, setTenants] = useState<Record<string, TenantUsage>>({});
+  const [trend, setTrend] = useState<TrendBucket[]>([]);
+  const [quotaSubmitting, setQuotaSubmitting] = useState(false);
+  const [quotaForm] = Form.useForm();
+
+  const range = useMemo(
+    () => RANGE_OPTIONS.find((r) => r.key === rangeKey) || RANGE_OPTIONS[1],
+    [rangeKey],
+  );
+
+  const reload = useCallback(() => {
+    const r = RANGE_OPTIONS.find((x) => x.key === rangeKey) || RANGE_OPTIONS[1];
+    setLoading(true);
+    setError(null);
+
+    // 主区间查询（表格 + 统计卡 + 租户候选）
+    const from = new Date(Date.now() - r.hours * 3600_000).toISOString();
+    const to = new Date().toISOString();
+    const query: { from: string; to: string; tenant?: string } = { from, to };
+    if (tenant.trim()) {
+      query.tenant = tenant.trim();
+    }
+
+    // 趋势：按时间桶并发增量查询（每桶 [from, to) 与真源同口径）
+    const buckets = buildBuckets(r);
+    const trendQuery = (b: TrendBucket) => {
+      const q: { from: string; to: string; tenant?: string } = { from: b.from, to: b.to };
+      if (tenant.trim()) {
+        q.tenant = tenant.trim();
+      }
+      return q;
+    };
+
+    Promise.all([
+      getUsage(query),
+      ...buckets.map((b) => getUsage(trendQuery(b))),
+    ])
+      .then((results) => {
+        const main = results[0];
+        setTenants(main?.tenants || {});
+        setTrend(
+          buckets.map((b, i) => {
+            const s = sumTenants(results[i + 1]);
+            return { ...b, tokensIn: s.tokensIn, tokensOut: s.tokensOut, requests: s.requests };
+          }),
+        );
+      })
+      .catch((e) => setError(String(e)))
+      .finally(() => setLoading(false));
+  }, [rangeKey, tenant]);
+
+  useEffect(() => {
+    reload();
+  }, [reload]);
+
+  const total = useMemo(() => sumTenants({ tenants }), [tenants]);
+
+  const rows = useMemo<TenantRow[]>(
+    () => Object.entries(tenants).map(([name, u]) => ({ name, ...u })),
+    [tenants],
+  );
+
+  const trendData = useMemo(
+    () =>
+      trend.flatMap((b) => [
+        { label: b.label, type: t('adminExt.usage.tokensIn') as string, value: b.tokensIn },
+        { label: b.label, type: t('adminExt.usage.tokensOut') as string, value: b.tokensOut },
+      ]),
+    [trend, t],
+  );
+
+  const columns: TableColumnsType<TenantRow> = [
+    { title: t('adminExt.usage.tenant'), dataIndex: 'name', key: 'name', width: 180, ellipsis: true },
+    {
+      title: t('adminExt.usage.requests'),
+      dataIndex: 'requests',
+      key: 'requests',
+      width: 110,
+      align: 'right' as const,
+      sorter: (a, b) => a.requests - b.requests,
+    },
+    {
+      title: t('adminExt.usage.tokensIn'),
+      dataIndex: 'tokens_in',
+      key: 'tokens_in',
+      width: 130,
+      align: 'right' as const,
+      sorter: (a, b) => a.tokens_in - b.tokens_in,
+    },
+    {
+      title: t('adminExt.usage.tokensOut'),
+      dataIndex: 'tokens_out',
+      key: 'tokens_out',
+      width: 130,
+      align: 'right' as const,
+      sorter: (a, b) => a.tokens_out - b.tokens_out,
+    },
+  ];
+
+  const onSubmitQuota = (values: { tenant: string; max_tokens: number }) => {
+    setQuotaSubmitting(true);
+    setQuota({ tenant: values.tenant.trim(), max_tokens: values.max_tokens })
+      .then((resp) => {
+        message.success(
+          `${t('adminExt.usage.quotaSetOk')}: ${resp?.tenant} = ${resp?.quota}`,
+        );
+      })
+      .catch(() => {
+        // 全局拦截器已弹错误框（403 越权 / 503 数据源 / 500 审计 fail-closed）
+      })
+      .finally(() => setQuotaSubmitting(false));
+  };
+
+  return (
+    <PageContainer>
+      <Alert
+        type="info"
+        showIcon
+        message={t('adminExt.usage.guide')}
+        style={{ marginBottom: 16 }}
+      />
+      {error && (
+        <Alert type="error" showIcon message={error} style={{ marginBottom: 16 }} />
+      )}
+
+      <Space style={{ marginBottom: 16 }}>
+        <Select<RangeKey>
+          value={rangeKey}
+          style={{ width: 160 }}
+          onChange={(v) => setRangeKey(v)}
+          options={RANGE_OPTIONS.map((r) => ({ value: r.key, label: t(r.labelKey) }))}
+        />
+        <AutoComplete
+          value={tenant}
+          style={{ width: 240 }}
+          allowClear
+          options={rows.map((r) => ({ value: r.name }))}
+          placeholder={t('adminExt.usage.tenantFilterPlaceholder') as string}
+          onChange={(v: string) => setTenant(v)}
+        />
+        <Button icon={<ReloadOutlined />} onClick={reload} loading={loading}>
+          {t('adminExt.usage.refresh')}
+        </Button>
+      </Space>
+
+      <Row gutter={16} style={{ marginBottom: 16 }}>
+        <Col span={8}>
+          <Card size="small">
+            <Statistic title={t('adminExt.usage.totalRequests')} value={total.requests} />
+          </Card>
+        </Col>
+        <Col span={8}>
+          <Card size="small">
+            <Statistic title={t('adminExt.usage.tokensIn')} value={total.tokensIn} />
+          </Card>
+        </Col>
+        <Col span={8}>
+          <Card size="small">
+            <Statistic title={t('adminExt.usage.tokensOut')} value={total.tokensOut} />
+          </Card>
+        </Col>
+      </Row>
+
+      <Card size="small" title={t('adminExt.usage.trend')} style={{ marginBottom: 16 }}>
+        <Line
+          height={260}
+          data={trendData}
+          xField="label"
+          yField="value"
+          seriesField="type"
+          smooth
+        />
+      </Card>
+
+      <Card size="small" title={t('adminExt.usage.tenantTable')} style={{ marginBottom: 16 }}>
+        <Table
+          rowKey="name"
+          size="middle"
+          loading={loading}
+          dataSource={rows}
+          columns={columns}
+          locale={{ emptyText: t('adminExt.usage.empty') }}
+          pagination={{ pageSize: 20, hideOnSinglePage: true }}
+          expandable={{
+            rowExpandable: (r) => Object.keys(r.by_model || {}).length > 0,
+            expandedRowRender: (r) => (
+              <Table
+                rowKey={(m) => m.model}
+                size="small"
+                pagination={false}
+                dataSource={Object.entries(r.by_model || {}).map(([m, u]) => ({ model: m, ...u }))}
+                columns={[
+                  {
+                    title: t('adminExt.usage.model'),
+                    dataIndex: 'model',
+                    key: 'model',
+                    render: (v: string) => <Tag>{v}</Tag>,
+                  },
+                  { title: t('adminExt.usage.requests'), dataIndex: 'requests', key: 'requests', align: 'right' as const },
+                  { title: t('adminExt.usage.tokensIn'), dataIndex: 'tokens_in', key: 'tokens_in', align: 'right' as const },
+                  { title: t('adminExt.usage.tokensOut'), dataIndex: 'tokens_out', key: 'tokens_out', align: 'right' as const },
+                ]}
+              />
+            ),
+          }}
+        />
+      </Card>
+
+      <Card size="small" title={t('adminExt.usage.quotaTitle')}>
+        <Typography.Paragraph type="secondary" style={{ marginBottom: 8 }}>
+          {t('adminExt.usage.quotaGuide')}
+        </Typography.Paragraph>
+        <Form form={quotaForm} layout="inline" onFinish={onSubmitQuota} initialValues={{ max_tokens: 1000000 }}>
+          <Form.Item
+            name="tenant"
+            rules={[{ required: true, message: t('adminExt.usage.quotaTenantRequired') as string }]}
+          >
+            <AutoComplete
+              style={{ width: 240 }}
+              options={rows.map((r) => ({ value: r.name }))}
+              placeholder={t('adminExt.usage.quotaTenantPlaceholder') as string}
+            />
+          </Form.Item>
+          <Form.Item name="max_tokens" rules={[{ required: true }]}>
+            <InputNumber min={0} step={100000} style={{ width: 200 }} placeholder="max_tokens" />
+          </Form.Item>
+          <Form.Item>
+            <Button type="primary" htmlType="submit" loading={quotaSubmitting}>
+              {t('adminExt.usage.quotaSubmit')}
+            </Button>
+          </Form.Item>
+        </Form>
+      </Card>
+    </PageContainer>
+  );
+};
+
+export default UsageDashboardPage;
diff --git a/frontend/src/pages/admin-ext/vendors/index.tsx b/frontend/src/pages/admin-ext/vendors/index.tsx
new file mode 100644
index 0000000..9e8601a
--- /dev/null
+++ b/frontend/src/pages/admin-ext/vendors/index.tsx
@@ -0,0 +1,122 @@
+import { Alert, Card, Descriptions, Empty, Spin, Tag } from 'antd';
+import { useEffect, useState } from 'react';
+import { PageContainer } from '@ant-design/pro-layout';
+import { useTranslation } from 'react-i18next';
+import { getLlmProviders } from '@/services/llm-provider';
+import { LlmProvider } from '@/interfaces/llm-provider';
+
+/**
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：厂商激活与状态（只读视图）。
+ *
+ * 定位（docs/管理门户-细化方案.md §5.1/F3）：激活操作复用控制台既有
+ * AI Provider 页（含完整表单/多 token/tokenFailover），本页仅做状态汇总：
+ *  - 展示受管厂商列表与降级探测配置（tokenFailover.enabled/健康阈值/探测模型）；
+ *  - tokens 一律掩码（仅示后 4 位），不在页面二次暴露明文（§6 密钥约束）；
+ *  - 运行态实时健康（吞吐/降级计数）待用量与监控接入后补齐（M2），
+ *    此处如实呈现配置态而非虚构运行态。
+ * 数据源 = 控制台既有 REST /v1/ai/providers（services/llm-provider.ts，复用不改）。
+ */
+
+const maskToken = (token: string): string => {
+  const s = token.trim();
+  return s.length > 4 ? `****${s.slice(-4)}` : '****';
+};
+
+const ProviderStatus: React.FC = () => {
+  const { t } = useTranslation();
+  const [list, setList] = useState<LlmProvider[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    let cancelled = false;
+    setLoading(true);
+    getLlmProviders()
+      .then((providers) => {
+        if (!cancelled) {
+          setList(providers || []);
+          setError(null);
+        }
+      })
+      .catch((e) => {
+        if (!cancelled) {
+          setError(String(e));
+        }
+      })
+      .finally(() => {
+        if (!cancelled) {
+          setLoading(false);
+        }
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  return (
+    <PageContainer>
+      <Alert
+        type="info"
+        showIcon
+        message={t('adminExt.vendors.guide')}
+        style={{ marginBottom: 16 }}
+      />
+      {loading && (
+        <div style={{ textAlign: 'center', padding: 48 }}>
+          <Spin />
+        </div>
+      )}
+      {!loading && error && (
+        <Alert type="error" showIcon message={error} style={{ marginBottom: 16 }} />
+      )}
+      {!loading && !error && list.length === 0 && (
+        <Empty description={t('adminExt.vendors.empty')} />
+      )}
+      {!loading &&
+        !error &&
+        list.map((p) => {
+          const failover = p.tokenFailoverConfig;
+          return (
+            <Card
+              key={p.name}
+              size="small"
+              style={{ marginBottom: 12 }}
+              title={
+                <span>
+                  {p.name} <Tag>{p.type}</Tag>
+                </span>
+              }
+            >
+              <Descriptions column={2} size="small">
+                <Descriptions.Item label={t('adminExt.vendors.protocol')}>
+                  {p.protocol || '-'}
+                </Descriptions.Item>
+                <Descriptions.Item label={t('adminExt.vendors.proxyName')}>
+                  {p.proxyName || '-'}
+                </Descriptions.Item>
+                <Descriptions.Item label={t('adminExt.vendors.tokens')}>
+                  {p.tokens && p.tokens.length > 0
+                    ? p.tokens.map((tk) => maskToken(tk)).join('，')
+                    : '-'}
+                </Descriptions.Item>
+                <Descriptions.Item label={t('adminExt.vendors.healthCheck')}>
+                  {failover && failover.enabled ? (
+                    <>
+                      <Tag color="green">{t('adminExt.vendors.enabled')}</Tag>
+                      {`${t('adminExt.vendors.failureThreshold')} ${failover.failureThreshold ?? '-'} / ${t(
+                        'adminExt.vendors.healthCheckModel',
+                      )} ${failover.healthCheckModel || '-'}`}
+                    </>
+                  ) : (
+                    <Tag>{t('adminExt.vendors.disabled')}</Tag>
+                  )}
+                </Descriptions.Item>
+              </Descriptions>
+            </Card>
+          );
+        })}
+    </PageContainer>
+  );
+};
+
+export default ProviderStatus;
