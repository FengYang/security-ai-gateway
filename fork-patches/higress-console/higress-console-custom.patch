+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：
+ * 管理面角色常量（M3-A 账号角色扩展，docs/管理门户-细化方案.md §4 D6）。
+ *
+ * 两角色起步：admin（读写）/ auditor（只读审计）。
+ * 角色持久化于账号表（AdminExtUserStore，独立 K8s Secret）；
+ * 授权消费方 = gateway-admin-service（JWT role 采信 + 运维白名单加成）。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+/**
+ * @author admin-ext
+ */
+public final class AdminExtRole {
+
+    public static final String ADMIN = "admin";
+
+    public static final String AUDITOR = "auditor";
+
+    private AdminExtRole() {
+    }
+
+    public static boolean isValid(String role) {
+        return ADMIN.equals(role) || AUDITOR.equals(role);
+    }
+}
