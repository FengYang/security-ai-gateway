--- /dev/null
+++ b/backend/console/src/main/java/com/alibaba/higress/console/controller/admin/AdminExtSessionService.java
@@ -0,0 +1,289 @@
+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：
+ * 多账号会话服务（M3-A，docs/管理门户-细化方案.md §4 User+role 扩展）。
+ *
+ * 接管方式（上游零改动）：@Primary 覆盖 SessionService 接口注入点——
+ * 上游 SessionController / ApiStandardizationAspect 注入的均为接口，
+ * Spring 装配层择优选中本实现；本实现委托原生 SessionServiceImpl（原生 admin 账号
+ * 行为不变），自研账号（AdminExtUserStore 账号表）走独立校验与令牌。
+ *
+ * 自研会话令牌（与原生 AES token 并存于同一 cookie，前缀区分）：
+ *   admext1.<b64url(username)>.<expiryMillis>.<b64url(HMAC-SHA256(serverKey, username.expiryMs))>
+ *   - 无状态签名令牌（不存服务端），serverKey 持久化于账号 Secret；
+ *   - 有效期 = cookie maxAge（与原生行为一致，persistent 决定 cookie 是否持久）；
+ *   - validateSession 回查账号表：账号被删/角色变更后，令牌在有效期内仍会因
+ *     账号消失而失效（角色变更经 30s 缓存 + JWT 60s TTL 生效，M3-A 定案）。
+ *
+ * 锁定（§5.4）：原生与自研账号统一经 AdminExtLoginGuard 计数（失败/成功双路挂钩）。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.Base64;
+import java.util.List;
+
+import javax.annotation.Resource;
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+import javax.servlet.http.Cookie;
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+
+import org.apache.commons.lang3.StringUtils;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Primary;
+import org.springframework.stereotype.Service;
+
+import com.alibaba.higress.console.constant.SystemConfigKey;
+import com.alibaba.higress.console.model.User;
+import com.alibaba.higress.console.service.SessionService;
+import com.alibaba.higress.console.service.SessionServiceImpl;
+import com.alibaba.higress.sdk.exception.BusinessException;
+import com.alibaba.higress.sdk.exception.ValidationException;
+
+/**
+ * @author admin-ext
+ */
+@Service
+@Primary
+public class AdminExtSessionService implements SessionService {
+
+    private static final Logger log = LoggerFactory.getLogger(AdminExtSessionService.class);
+
+    /** 自研令牌版本前缀（与原生 AES 密文格式区分）。 */
+    private static final String TOKEN_PREFIX = "admext1.";
+    /** 令牌段分隔符。 */
+    private static final String TOKEN_SEPARATOR = ".";
+    /** HMAC 算法。 */
+    private static final String HMAC_ALG = "HmacSHA256";
+
+    private static final java.security.SecureRandom SECURE_RANDOM = new java.security.SecureRandom();
+
+    @Value("${" + SystemConfigKey.ADMIN_COOKIE_NAME_KEY + ":" + SystemConfigKey.ADMIN_COOKIE_NAME_DEFAULT + "}")
+    private String cookieName = SystemConfigKey.ADMIN_COOKIE_NAME_DEFAULT;
+
+    @Value("${" + SystemConfigKey.ADMIN_COOKIE_MAX_AGE_KEY + ":" + SystemConfigKey.ADMIN_COOKIE_MAX_AGE_DEFAULT + "}")
+    private int cookieMaxAge = SystemConfigKey.ADMIN_COOKIE_MAX_AGE_DEFAULT;
+
+    @Resource
+    private SessionServiceImpl delegate;
+
+    @Resource
+    private AdminExtUserStore userStore;
+
+    @Resource
+    private AdminExtLoginGuard loginGuard;
+
+    @Override
+    public boolean isAdminInitialized() {
+        return delegate.isAdminInitialized();
+    }
+
+    @Override
+    public void initializeAdmin(User user) {
+        delegate.initializeAdmin(user);
+    }
+
+    @Override
+    public User login(String username, String password) {
+        loginGuard.checkNotLocked(username);
+
+        AdminExtUserRecord record = tryFindRecord(username);
+        if (record != null) {
+            if (!record.matchesPassword(password)) {
+                loginGuard.recordFailure(username);
+                return null;
+            }
+            loginGuard.recordSuccess(username);
+            return toUser(record);
+        }
+
+        // 未命中自研账号 → 原生 admin 流程（行为不变，锁定器统一挂钩）。
+        User user = delegate.login(username, password);
+        if (user != null) {
+            loginGuard.recordSuccess(username);
+        } else {
+            loginGuard.recordFailure(username);
+        }
+        return user;
+    }
+
+    @Override
+    public void saveSession(HttpServletResponse response, User user, boolean persistent) {
+        AdminExtUserRecord record = tryFindRecord(user.getName());
+        if (record == null) {
+            delegate.saveSession(response, user, persistent);
+            return;
+        }
+        String token = generateExtToken(record.getUsername());
+        Cookie cookie = buildCookie(token);
+        if (persistent) {
+            cookie.setMaxAge(cookieMaxAge);
+        }
+        response.addCookie(cookie);
+    }
+
+    @Override
+    public void clearSession(HttpServletResponse response) {
+        delegate.clearSession(response);
+    }
+
+    @Override
+    public User validateSession(HttpServletRequest request) {
+        Cookie[] cookies = request.getCookies();
+        if (cookies != null) {
+            String token = Arrays.stream(cookies).filter(c -> cookieName.equals(c.getName()))
+                .map(Cookie::getValue).findFirst().orElse(null);
+            if (StringUtils.isNotEmpty(token) && token.startsWith(TOKEN_PREFIX)) {
+                return validateExtToken(token.substring(TOKEN_PREFIX.length()));
+            }
+        }
+        // 非 self token（原生 AES cookie / Basic auth）→ 原生流程。
+        return delegate.validateSession(request);
+    }
+
+    @Override
+    public void changePassword(String username, String oldPassword, String newPassword) {
+        AdminExtUserRecord record = tryFindRecord(username);
+        if (record == null) {
+            delegate.changePassword(username, oldPassword, newPassword);
+            return;
+        }
+        if (!record.matchesPassword(oldPassword)) {
+            throw new ValidationException("Incorrect old password.");
+        }
+        String weak = AdminExtUserRecord.validatePassword(newPassword);
+        if (weak != null) {
+            throw new ValidationException(weak);
+        }
+        AdminExtUserStore.Snapshot snapshot = userStore.readFresh();
+        String salt = AdminExtUserRecord.newSalt(SECURE_RANDOM);
+        for (AdminExtUserRecord u : snapshot.getUsers()) {
+            if (u.getUsername().equals(username)) {
+                u.setSalt(salt);
+                u.setPasswordHash(AdminExtUserRecord.hashPassword(salt, newPassword));
+            }
+        }
+        userStore.writeUsers(snapshot, snapshot.getUsers());
+    }
+
+    private User validateExtToken(String body) {
+        String[] parts = body.split("\\" + TOKEN_SEPARATOR, -1);
+        if (parts.length != 3) {
+            return null;
+        }
+        // HMAC 输入 = 原始编码段（与 generateExtToken 的 payload 完全一致，先验签后解码）。
+        String payload = parts[0] + TOKEN_SEPARATOR + parts[1];
+        String username;
+        long expiryMs;
+        try {
+            expiryMs = Long.parseLong(parts[1]);
+        } catch (IllegalArgumentException e) {
+            return null;
+        }
+        if (expiryMs <= System.currentTimeMillis()) {
+            return null;
+        }
+        AdminExtUserStore.Snapshot snapshot;
+        try {
+            // 会话校验需要真实角色与账号存在性，绕过 30s 缓存更安全；开销可控（K8s 读有本地 client 池）。
+            snapshot = userStore.readFresh();
+        } catch (RuntimeException e) {
+            log.warn("[admin-ext] 会话校验读账号表失败（fail-closed 视为失效）: {}", e.getMessage());
+            return null;
+        }
+        if (snapshot.getServerKey() == null) {
+            return null;
+        }
+        String expected = hmac(snapshot.getServerKey(), payload);
+        // 令牌第 3 段 = b64url(hmacHex)，先解码再恒时比对（与 generateExtToken 编码口径一致）
+        String provided;
+        try {
+            provided = new String(Base64.getUrlDecoder().decode(parts[2]), StandardCharsets.UTF_8);
+        } catch (IllegalArgumentException e) {
+            return null;
+        }
+        if (!constantTimeEquals(expected, provided)) {
+            return null;
+        }
+        try {
+            username = new String(Base64.getUrlDecoder().decode(parts[0]), StandardCharsets.UTF_8);
+        } catch (IllegalArgumentException e) {
+            return null;
+        }
+        AdminExtUserRecord record = snapshot.getUsers().stream()
+            .filter(u -> u.getUsername().equals(username)).findFirst().orElse(null);
+        if (record == null) {
+            return null; // 账号已删除 → 会话失效
+        }
+        return toUser(record);
+    }
+
+    private String generateExtToken(String username) {
+        String serverKey = userStore.serverKey();
+        if (serverKey == null) {
+            throw new BusinessException("账号表 serverKey 缺失（账号 Secret 未初始化）");
+        }
+        long expiryMs = System.currentTimeMillis() + cookieMaxAge * 1000L;
+        String body = Base64.getUrlEncoder().withoutPadding()
+            .encodeToString(username.getBytes(StandardCharsets.UTF_8));
+        String payload = body + TOKEN_SEPARATOR + expiryMs;
+        return TOKEN_PREFIX + payload + TOKEN_SEPARATOR
+            + Base64.getUrlEncoder().withoutPadding()
+                .encodeToString(hmac(serverKey, payload).getBytes(StandardCharsets.UTF_8));
+    }
+
+    private AdminExtUserRecord tryFindRecord(String username) {
+        try {
+            return userStore.findByUsername(username);
+        } catch (RuntimeException e) {
+            // 账号表不可达 → 原生 admin 流程兜底（原生配置独立缓存；锁定器仍生效）。
+            log.warn("[admin-ext] 账号表读取失败，回落原生登录流程: {}", e.getMessage());
+            return null;
+        }
+    }
+
+    private Cookie buildCookie(String value) {
+        Cookie cookie = new Cookie(cookieName, value);
+        cookie.setPath("/");
+        cookie.setHttpOnly(true);
+        return cookie;
+    }
+
+    private static User toUser(AdminExtUserRecord record) {
+        User user = new User();
+        user.setName(record.getUsername());
+        user.setDisplayName(record.getDisplayName());
+        return user;
+    }
+
+    private static String hmac(String serverKey, String input) {
+        try {
+            Mac mac = Mac.getInstance(HMAC_ALG);
+            mac.init(new SecretKeySpec(serverKey.getBytes(StandardCharsets.UTF_8), HMAC_ALG));
+            byte[] out = mac.doFinal(input.getBytes(StandardCharsets.UTF_8));
+            StringBuilder sb = new StringBuilder(out.length * 2);
+            for (byte b : out) {
+                sb.append(String.format("%02x", b));
+            }
+            return sb.toString();
+        } catch (Exception e) {
+            throw new IllegalStateException("HMAC-SHA256 不可用", e);
+        }
+    }
+
+    private static boolean constantTimeEquals(String a, String b) {
+        return java.security.MessageDigest.isEqual(a.getBytes(StandardCharsets.UTF_8),
+            b.getBytes(StandardCharsets.UTF_8));
+    }
+
+    /** 供测试/审计读取当前账号全量（脱敏）。 */
+    public List<AdminExtUserRecord> sanitizedUsers() {
+        return AdminExtUserStore.sanitize(userStore.listUsers());
+    }
+}
