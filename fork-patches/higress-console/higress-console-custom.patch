+
+        @SuppressWarnings("unchecked")
+        ArgumentCaptor<List<AdminExtUserRecord>> captor = ArgumentCaptor.forClass(List.class);
+        verify(userStore).writeUsers(any(), captor.capture());
+        assertEquals(1, captor.getValue().size());
+        assertEquals("new-user", captor.getValue().get(0).getUsername());
+        verify(forwarder).forward(eq(AdminExtAuditForwarder.ACTION_ACCOUNT_CREATE),
+            eq("new-user"), eq("root-admin"));
+    }
+
+    @Test
+    void auditFailureRollsBackSecretWrite() {
+        when(userStore.resolveRole("root-admin")).thenReturn(AdminExtRole.ADMIN);
+        AdminExtUserRecord bob = record("bob", AdminExtRole.AUDITOR);
+        when(userStore.readFresh()).thenReturn(snapshot(bob));
+        doThrow(new BusinessException("审计链投递失败")).when(forwarder)
+            .forward(eq(AdminExtAuditForwarder.ACTION_ACCOUNT_CREATE), eq("new-user"), anyString());
+
+        assertThrows(BusinessException.class,
+            () -> controller.create(createReq("new-user", AdminExtRole.AUDITOR, "passw0rdA")));
+
+        // 回滚：writeUsers 第二次调用以变更前快照（仅 bob）回写
+        verify(userStore).writeUsers(any(), eq(new ArrayList<>(Collections.singletonList(bob))));
+    }
+
+    @Test
+    void passwordResetAuditFailureRollsBackOldHash() {
+        when(userStore.resolveRole("root-admin")).thenReturn(AdminExtRole.ADMIN);
+        AdminExtUserRecord bob = record("bob", AdminExtRole.AUDITOR);
+        String oldHash = bob.getPasswordHash();
+        when(userStore.readFresh()).thenReturn(snapshot(bob));
+        doThrow(new BusinessException("审计链投递失败")).when(forwarder)
+            .forward(eq(AdminExtAuditForwarder.ACTION_ACCOUNT_PASSWORD_RESET), eq("bob"), anyString());
+
+        AdminExtAccountController.ResetPasswordRequest req = new AdminExtAccountController.ResetPasswordRequest();
+        req.setPassword("new-pass99");
+        assertThrows(BusinessException.class, () -> controller.resetPassword("bob", req));
+
+        // 深拷贝回滚：第二次 writeUsers 写回旧 hash（而非已变更的新 hash）
+        @SuppressWarnings("unchecked")
+        ArgumentCaptor<List<AdminExtUserRecord>> captor = ArgumentCaptor.forClass(List.class);
+        verify(userStore, times(2)).writeUsers(any(), captor.capture());
+        assertEquals(oldHash, captor.getAllValues().get(1).get(0).getPasswordHash());
+    }
+
+    @Test
+    void deleteProtectsSelfAndLastAdmin() {
+        when(userStore.resolveRole("root-admin")).thenReturn(AdminExtRole.ADMIN);
+        when(userStore.readFresh())
+            .thenReturn(snapshot(record("root-admin", AdminExtRole.ADMIN), record("bob", AdminExtRole.AUDITOR)));
+
+        assertThrows(ValidationException.class, () -> controller.delete("root-admin")); // 自删
+        assertThrows(ValidationException.class, () -> controller.delete("no-such")); // 不存在
+
+        // 最后一个 admin（表中仅 1 个）→ 拒绝
+        when(userStore.readFresh())
+            .thenReturn(snapshot(record("bob", AdminExtRole.AUDITOR), record("chief", AdminExtRole.ADMIN)));
+        assertThrows(ValidationException.class, () -> controller.delete("chief"));
+    }
+
+    @Test
+    void deleteSucceedsForAuditorAccount() {
+        when(userStore.resolveRole("root-admin")).thenReturn(AdminExtRole.ADMIN);
+        when(userStore.readFresh())
+            .thenReturn(snapshot(record("bob", AdminExtRole.AUDITOR), record("chief", AdminExtRole.ADMIN)));
+        doNothing().when(forwarder).forward(anyString(), anyString(), anyString());
+
+        assertEquals(204, controller.delete("bob").getStatusCodeValue());
+        @SuppressWarnings("unchecked")
+        ArgumentCaptor<List<AdminExtUserRecord>> captor = ArgumentCaptor.forClass(List.class);
+        verify(userStore).writeUsers(any(), captor.capture());
+        assertTrue(captor.getValue().stream().noneMatch(u -> "bob".equals(u.getUsername())));
+        verify(forwarder).forward(eq(AdminExtAuditForwarder.ACTION_ACCOUNT_DELETE), eq("bob"), eq("root-admin"));
+    }
+}
