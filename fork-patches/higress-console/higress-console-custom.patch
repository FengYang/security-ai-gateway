+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：
+ * gateway-admin-service 转发配置（docs/管理门户-细化方案.md §3.1/§6）。
+ *
+ * 配置一律经环境变量注入（K8s ConfigMap/Secret），不落 application.properties：
+ *  - ADMIN_SVC_TARGET          Go 服务地址（默认 http://127.0.0.1:19095，集群内配 ClusterIP 名）
+ *  - ADMIN_SVC_JWT_SECRET      内部服务令牌共享密钥（与 Go 服务一致；必填，<16 字节拒绝服务）
+ *  - ADMIN_SVC_JWT_TTL_SECONDS 令牌有效期秒（默认 60，管理请求为短时令牌）
+ * 签发方/受众固定与 Go 端默认一致（higress-console / gateway-admin-service）。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import javax.annotation.PostConstruct;
+
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+
+/**
+ * @author admin-ext
+ */
+@Component
+public class AdminExtConfig {
+
+    public static final String DEFAULT_ISSUER = "higress-console";
+    public static final String DEFAULT_AUDIENCE = "gateway-admin-service";
+
+    @Value("${ADMIN_SVC_TARGET:http://127.0.0.1:19095}")
+    private String target;
+
+    @Value("${ADMIN_SVC_JWT_SECRET:}")
+    private String jwtSecret;
+
+    @Value("${ADMIN_SVC_JWT_TTL_SECONDS:60}")
+    private long jwtTtlSeconds;
+
+    private boolean ready;
+
+    @PostConstruct
+    public void init() {
+        // fail-closed：密钥缺失/过短时本转发面不可用（端点返回 503），
+        // 但不得拖垮控制台整体启动，故仅标记状态不抛异常。
+        ready = jwtSecret != null && jwtSecret.length() >= 16 && !target.isEmpty();
+    }
+
+    public boolean isReady() {
+        return ready;
+    }
+
+    public String getTarget() {
+        return target;
+    }
+
+    public byte[] getJwtSecret() {
+        return jwtSecret.getBytes(java.nio.charset.StandardCharsets.UTF_8);
+    }
+
+    public long getJwtTtlSeconds() {
+        return jwtTtlSeconds;
+    }
+}
