+import request from './request';
+
+/**
+ * ADMIN-EXT（自研扩展）：模型目录只读 API 客户端（M2 A-1'）。
+ *
+ * 数据源 = 控制面实时运行态（ai-proxy CR providers × ai-route ConfigMap），
+ * 由 gateway-admin-service 聚合为「一条 ai-route 上游 = 一行目录」。
+ * 后端：GET /v1/adminext/models（Go，经控制台 AdminExtProxyController 通用转发）。
+ * 只读：任意已认证会话（auditor）可访问；数据源缺失返回空列表而非报错。
+ */
+
+/** 模型目录行：一条 ai-route 上游（route × provider 绑定）。 */
+export interface ModelRouteEntry {
+  /** ai-route 名称 */
+  route: string;
+  /** 路径前缀（PRE 谓词值） */
+  path: string;
+  /** 模型谓词值（空数组 = 不限模型） */
+  models: string[];
+  /** 上游模型映射（原样展示；可能为 null） */
+  defaultMapping?: Record<string, string> | null;
+  /** 上游 provider id */
+  provider: string;
+  /** ai-proxy CR 声明的 type（provider 不在 CR 中时为空串） */
+  providerType?: string;
+  /** ai-proxy CR 声明的 protocol（同上） */
+  providerProtocol?: string;
+  /** customUrl 指向 /llm-broker/（密态托管链路） */
+  viaBroker: boolean;
+  /** CR 仍存明文 apiTokens（迁移前形态，应尽快经凭据托管迁移） */
+  hasPlaintextToken: boolean;
+  /** 上游权重（多上游 failover） */
+  weight: number;
+}
+
+/** 模型目录响应。 */
+export interface ModelCatalog {
+  routes: ModelRouteEntry[];
+}
+
+const BASE = '/v1/adminext/models';
+
+export const listModels = (): Promise<ModelCatalog> => {
+  return request.get<any, ModelCatalog>(BASE);
+};
