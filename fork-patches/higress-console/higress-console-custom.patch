+import { PlusOutlined, ReloadOutlined } from '@ant-design/icons';
+import { PageContainer } from '@ant-design/pro-layout';
+import {
+  Alert,
+  Button,
+  Descriptions,
+  Form,
+  Input,
+  message,
+  Modal,
+  Select,
+  Space,
+  Table,
+  Tag,
+} from 'antd';
+import { useCallback, useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import AdminExtBadge from '@/components/AdminExtBadge';
+import {
+  ChangeItem,
+  ChangeSubmit,
+  approveChange,
+  listChanges,
+  rejectChange,
+  submitChange,
+} from '@/services/admin-ext-changes';
+
+/**
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：高敏变更复核（M3-C）。
+ *
+ * 设计（docs/管理门户-细化方案.md §5.3，D8）：状态机 草稿(提交即待复核) → 已执行/已驳回。
+ *  - 发起人 ≠ 复核人（**服务端强制**；前端不掌握当前登录名与角色，故无法置灰，
+ *    如实不做体验层拦截——安全由后端承担，见 D10 边界）；
+ *  - 凭据轮换两阶段：新 Key 一次性提交（后端 0600 暂存，复核通过才提升为正式凭据）；
+ *    本页绝不回显明文；
+ *  - 全部状态流转落 G1 管理面审计链（安全中心可查）。
+ */
+
+const ACTION_GUARDRAIL = 'guardrail_pii_mode';
+const ACTION_ROTATE = 'credential_rotate';
+const ACTION_DELETE = 'credential_delete';
+
+const statusColor = (s: string): string => {
+  switch (s) {
+    case 'pending':
+      return 'orange';
+    case 'executed':
+      return 'green';
+    case 'rejected':
+      return 'default';
+    case 'failed':
+      return 'red';
+    default:
+      return 'blue';
+  }
+};
+
+const ChangeReview: React.FC = () => {
+  const { t } = useTranslation();
+  const [form] = Form.useForm();
+  const [rejectForm] = Form.useForm();
+  const [items, setItems] = useState<ChangeItem[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [submitOpen, setSubmitOpen] = useState(false);
+  const [rejectTarget, setRejectTarget] = useState<ChangeItem | null>(null);
+  const [detail, setDetail] = useState<ChangeItem | null>(null);
+  const [submitting, setSubmitting] = useState(false);
+  const action = Form.useWatch('action', form);
+
+  const reload = useCallback(() => {
+    setLoading(true);
+    listChanges()
+      .then((r) => {
+        setItems(r?.items || []);
+        setError(null);
+      })
+      .catch((e) => setError(String(e)))
+      .finally(() => setLoading(false));
+  }, []);
+
+  useEffect(() => {
+    reload();
+  }, [reload]);
+
+  const openSubmit = () => {
+    form.resetFields();
+    form.setFieldsValue({ action: ACTION_GUARDRAIL, payload_mode: 'mask' });
+    setSubmitOpen(true);
+  };
+
+  const doSubmit = async () => {
+    const v = await form.validateFields();
+    const payload: ChangeSubmit = {
+      action: v.action,
+      diff: v.diff,
+      target: v.target,
+    };
+    if (v.action === ACTION_GUARDRAIL) {
+      payload.target = 'guardrail';
+      payload.payload = { pii_mode: v.payload_mode };
+    }
+    if (v.action === ACTION_ROTATE) {
+      payload.secret = v.secret;
+    }
+    setSubmitting(true);
+    try {
+      await submitChange(payload);
+      message.success(t('adminExt.changes.submitted'));
+      setSubmitOpen(false);
+      reload();
+    } catch (e) {
+      message.error(String(e));
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  const doApprove = async (c: ChangeItem) => {
+    setSubmitting(true);
+    try {
+      await approveChange(c.id);
+      message.success(t('adminExt.changes.executed'));
+      reload();
+    } catch (e) {
+      message.error(String(e));
+      reload();
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  const doReject = async () => {
+    if (!rejectTarget) {
+      return;
+    }
+    const v = await rejectForm.validateFields();
+    setSubmitting(true);
+    try {
+      await rejectChange(rejectTarget.id, v.reason);
+      message.success(t('adminExt.changes.rejected'));
+      setRejectTarget(null);
+      reload();
+    } catch (e) {
+      message.error(String(e));
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  const fmtTime = (ns?: number) => (ns ? new Date(ns / 1e6).toLocaleString() : '-');
+
+  const columns = [
+    { title: t('adminExt.changes.colId'), dataIndex: 'id', key: 'id' },
+    {
+      title: t('adminExt.changes.colAction'),
+      dataIndex: 'action',
+      key: 'action',
+      render: (v: string) => <Tag color="geekblue">{t(`adminExt.changes.action.${v}`) || v}</Tag>,
+    },
+    {
+      title: t('adminExt.changes.colTarget'),
+      dataIndex: 'target',
+      key: 'target',
+      render: (v: string) => v || '-',
+    },
+    {
+      title: t('adminExt.changes.colStatus'),
+      dataIndex: 'status',
+      key: 'status',
+      render: (v: string) => <Tag color={statusColor(v)}>{t(`adminExt.changes.status.${v}`) || v}</Tag>,
+    },
+    { title: t('adminExt.changes.colSubmitter'), dataIndex: 'submitter', key: 'submitter' },
+    {
+      title: t('adminExt.changes.colReviewer'),
+      dataIndex: 'reviewer',
+      key: 'reviewer',
+      render: (v: string) => v || '-',
+    },
+    {
+      title: t('adminExt.changes.colCreatedAt'),
+      dataIndex: 'created_at',
+      key: 'created_at',
+      render: fmtTime,
+    },
+    {
+      title: t('adminExt.changes.colActions'),
+      key: 'actions',
+      render: (_: unknown, c: ChangeItem) =>
+        c.status === 'pending' ? (
+          <Space>
+            <Button size="small" type="primary" onClick={() => doApprove(c)} loading={submitting}>
+              {t('adminExt.changes.approve')}
+            </Button>
+            <Button size="small" danger onClick={() => setRejectTarget(c)}>
+              {t('adminExt.changes.reject')}
+            </Button>
+          </Space>
+        ) : (
+          <Button size="small" onClick={() => setDetail(c)}>
+            {t('adminExt.changes.detail')}
+          </Button>
+        ),
+    },
+  ];
+
+  return (
+    <PageContainer>
+      <AdminExtBadge />
+      <Alert
+        type="info"
+        showIcon
+        message={t('adminExt.changes.guide')}
+        style={{ marginBottom: 16 }}
+      />
+      {error && <Alert type="error" showIcon message={error} style={{ marginBottom: 16 }} />}
+
+      <Space style={{ marginBottom: 16 }}>
+        <Button type="primary" icon={<PlusOutlined />} onClick={openSubmit}>
+          {t('adminExt.changes.submit')}
+        </Button>
+        <Button icon={<ReloadOutlined />} onClick={reload}>
+          {t('adminExt.changes.refresh')}
+        </Button>
+      </Space>
+
+      <Table
+        rowKey="id"
+        size="middle"
+        loading={loading}
+        columns={columns}
+        dataSource={items}
+        pagination={{ pageSize: 20 }}
+        locale={{ emptyText: t('adminExt.changes.empty') }}
+      />
+
+      <Modal
+        open={submitOpen}
+        title={t('adminExt.changes.submit')}
+        onCancel={() => setSubmitOpen(false)}
+        onOk={doSubmit}
+        confirmLoading={submitting}
+        okText={t('adminExt.changes.ok')}
+        destroyOnClose
+      >
+        <Form form={form} layout="vertical">
+          <Form.Item
+            name="action"
+            label={t('adminExt.changes.colAction')}
+            rules={[{ required: true, message: t('adminExt.changes.required') }]}
+          >
+            <Select>
+              <Select.Option value={ACTION_GUARDRAIL}>
+                {t(`adminExt.changes.action.${ACTION_GUARDRAIL}`)}
+              </Select.Option>
+              <Select.Option value={ACTION_ROTATE}>
+                {t(`adminExt.changes.action.${ACTION_ROTATE}`)}
+              </Select.Option>
+              <Select.Option value={ACTION_DELETE}>
+                {t(`adminExt.changes.action.${ACTION_DELETE}`)}
+              </Select.Option>
+            </Select>
+          </Form.Item>
+
+          {action === ACTION_GUARDRAIL && (
+            <Form.Item
+              name="payload_mode"
+              label={t('adminExt.changes.piiMode')}
+              extra={t('adminExt.changes.piiModeTip')}
+              rules={[{ required: true, message: t('adminExt.changes.required') }]}
+            >
+              <Select>
+                <Select.Option value="mask">mask</Select.Option>
+                <Select.Option value="block">block</Select.Option>
+              </Select>
+            </Form.Item>
+          )}
+
+          {action !== ACTION_GUARDRAIL && (
+            <Form.Item
+              name="target"
+              label={t('adminExt.changes.colTarget')}
+              extra={t('adminExt.changes.targetTip')}
+              rules={[{ required: true, message: t('adminExt.changes.required') }]}
+            >
+              <Input placeholder="phala" autoComplete="off" />
+            </Form.Item>
+          )}
+
+          {action === ACTION_ROTATE && (
+            <Form.Item
+              name="secret"
+              label={t('adminExt.changes.newKey')}
+              extra={t('adminExt.changes.newKeyTip')}
+              rules={[{ required: true, message: t('adminExt.changes.required') }]}
+            >
+              <Input.Password autoComplete="new-password" />
+            </Form.Item>
+          )}
+
+          <Form.Item
+            name="diff"
+            label={t('adminExt.changes.diff')}
+            extra={t('adminExt.changes.diffTip')}
+            rules={[{ required: true, message: t('adminExt.changes.required') }]}
+          >
+            <Input.TextArea rows={3} />
+          </Form.Item>
+        </Form>
+      </Modal>
+
+      <Modal
+        open={!!rejectTarget}
+        title={`${t('adminExt.changes.reject')}：${rejectTarget?.id || ''}`}
+        onCancel={() => setRejectTarget(null)}
+        onOk={doReject}
+        confirmLoading={submitting}
+        okText={t('adminExt.changes.ok')}
+        destroyOnClose
+      >
+        <Form form={rejectForm} layout="vertical">
+          <Form.Item
+            name="reason"
+            label={t('adminExt.changes.reason')}
+            rules={[{ required: true, message: t('adminExt.changes.required') }]}
+          >
+            <Input.TextArea rows={3} />
+          </Form.Item>
+        </Form>
+      </Modal>
+
+      <Modal
+        open={!!detail}
+        title={`${t('adminExt.changes.detail')}：${detail?.id || ''}`}
+        onCancel={() => setDetail(null)}
+        footer={<Button onClick={() => setDetail(null)}>{t('adminExt.changes.ok')}</Button>}
+      >
+        {detail && (
+          <Descriptions column={1} size="small">
+            <Descriptions.Item label={t('adminExt.changes.colAction')}>
+              {t(`adminExt.changes.action.${detail.action}`) || detail.action}
+            </Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.changes.colTarget')}>{detail.target}</Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.changes.diff')}>{detail.diff}</Descriptions.Item>
+            {detail.key_fingerprint && (
+              <Descriptions.Item label={t('adminExt.changes.fingerprint')}>
+                {detail.key_fingerprint}
+              </Descriptions.Item>
+            )}
+            <Descriptions.Item label={t('adminExt.changes.colSubmitter')}>{detail.submitter}</Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.changes.colReviewer')}>
+              {detail.reviewer || '-'}
+            </Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.changes.colStatus')}>
+              <Tag color={statusColor(detail.status)}>
+                {t(`adminExt.changes.status.${detail.status}`) || detail.status}
+              </Tag>
+            </Descriptions.Item>
+            {detail.reject_reason && (
+              <Descriptions.Item label={t('adminExt.changes.reason')}>{detail.reject_reason}</Descriptions.Item>
+            )}
+            {detail.exec_error && (
+              <Descriptions.Item label={t('adminExt.changes.execError')}>
+                <span style={{ color: '#cf1322' }}>{detail.exec_error}</span>
+              </Descriptions.Item>
+            )}
+          </Descriptions>
+        )}
+      </Modal>
+    </PageContainer>
+  );
+};
+
+export default ChangeReview;
