+++ b/frontend/src/services/admin-ext-security.ts
@@ -0,0 +1,117 @@
+import request from './request';
+
+/**
+ * ADMIN-EXT（自研扩展）：安全中心 API 客户端（M3-B）。
+ *
+ * 数据源分层：
+ *  - 密态链路状态 / Guardrail 策略 → gateway-admin-service GET /v1/adminext/sec-status
+ *    （内部聚合 tee-infer /healthz 与 /config，服务间令牌注入，前端不可见）；
+ *  - G1 管理面审计链 → /v1/adminext/audit-chain（查询/校验/导出）；
+ *  - tee-infer 数据面审计链 → /v1/adminext/audit-tee（代理）。
+ *
+ * 最小披露：Guardrail 只返回类别与规则条数，链尾哈希只给前 8 位（规则原文不出 TEE）。
+ * 503 语义：G1 链未启用 / tee-infer 未配置时后端返回 503（不静默给空数据）。
+ * 只读边界（D10）：本页全部端点允许 admin 与 auditor 读取。
+ */
+
+/** G1 审计事件（字段随事件类型可选）。 */
+export interface AuditChainEvent {
+  event_id: string;
+  timestamp: number;
+  actor: string;
+  action: string;
+  provider?: string;
+  key_fingerprint?: string;
+  tenant?: string;
+  max_tokens?: number;
+  target?: string;
+  request_id: string;
+  result: string;
+  prev_hash: string;
+}
+
+/** G1 链分页查询响应（events 为倒序：最新在前）。 */
+export interface AuditChainQuery {
+  events: AuditChainEvent[];
+  total: number;
+  limit: number;
+  offset: number;
+}
+
+/** G1 链完整性校验结果。 */
+export interface AuditChainVerify {
+  ok: boolean;
+  events: number;
+  broken_at?: number;
+}
+
+/** Guardrail 规则摘要（类别 + 条数，不含规则原文）。 */
+export interface GuardrailSnapshot {
+  enabled: boolean;
+  pii_categories: string;
+  sql_categories: string;
+  pii_rules: number;
+  sql_rules: number;
+  injection_terms: number;
+  prompt_classifier: boolean;
+}
+
+/** tee-infer 配置快照（/config）。 */
+export interface TeeConfig {
+  protocol_version: string;
+  require_attest: boolean;
+  admin_auth_enabled: boolean;
+  pii_mode: string;
+  /** startup = 启动参数生效；runtime = 高敏复核后运行时降级生效 */
+  pii_mode_source: string;
+  system_prompt_set: boolean;
+  audit_enabled: boolean;
+  guardrail: GuardrailSnapshot;
+}
+
+/** 密态链路状态聚合视图。 */
+export interface SecStatus {
+  tee_url: string;
+  /** ok | attestation_required | unreachable */
+  tee_health: string;
+  tee_http_status: number;
+  tee_config?: TeeConfig;
+  audit_chain: {
+    enabled: boolean;
+    events: number;
+    verified: boolean;
+    last_hash: string;
+  };
+  fetched_at: number;
+}
+
+const BASE = '/v1/adminext';
+
+export const getSecStatus = (): Promise<SecStatus> => {
+  return request.get<any, SecStatus>(`${BASE}/sec-status`);
+};
+
+export const queryAuditChain = (limit: number, offset: number): Promise<AuditChainQuery> => {
+  return request.get<any, AuditChainQuery>(`${BASE}/audit-chain`, { params: { limit, offset } });
+};
+
+export const verifyAuditChain = (): Promise<AuditChainVerify> => {
+  return request.get<any, AuditChainVerify>(`${BASE}/audit-chain/verify`);
+};
+
+/** G1 链导出（JSONL 附件，浏览器直接下载，走同源会话认证）。 */
+export const exportAuditChain = (): void => {
+  window.open(`${BASE}/audit-chain/export`, '_blank');
+};
+
+/** tee-infer 数据面审计链查询（verify=true 走 /audit/verify 校验）。 */
+export const getTeeAudit = (params: { tenant?: string; verify?: boolean }): Promise<any> => {
+  const q: Record<string, string> = {};
+  if (params.tenant) {
+    q.tenant = params.tenant;
+  }
+  if (params.verify) {
+    q.verify = '1';
+  }
+  return request.get<any, any>(`${BASE}/audit-tee`, { params: q });
+};
