+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT（自研扩展）单测：账号记录（哈希/强度校验）与登录锁定器（M3-A）。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.security.SecureRandom;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * @author admin-ext
+ */
+class AdminExtUserRecordTest {
+
+    @Test
+    void hashPasswordRoundTripAndUniqueness() {
+        String salt = AdminExtUserRecord.newSalt(new SecureRandom());
+        String hash = AdminExtUserRecord.hashPassword(salt, "passw0rd!");
+        assertEquals(64, hash.length());
+        AdminExtUserRecord record = new AdminExtUserRecord("bob", "Bob", AdminExtRole.AUDITOR, hash, salt);
+        assertTrue(record.matchesPassword("passw0rd!"));
+        assertFalse(record.matchesPassword("passw0rd?"));
+        assertFalse(record.matchesPassword(null));
+    }
+
+    @Test
+    void saltedHashDiffersForSamePassword() {
+        String s1 = AdminExtUserRecord.newSalt(new SecureRandom());
+        String s2 = AdminExtUserRecord.newSalt(new SecureRandom());
+        assertNotEquals(AdminExtUserRecord.hashPassword(s1, "same-password1"),
+            AdminExtUserRecord.hashPassword(s2, "same-password1"));
+    }
+
+    @Test
+    void passwordStrengthRules() {
+        assertNull(AdminExtUserRecord.validatePassword("abcd1234"));
+        assertNotNull(AdminExtUserRecord.validatePassword(null));
+        assertNotNull(AdminExtUserRecord.validatePassword("abc12"));
+        assertNotNull(AdminExtUserRecord.validatePassword("abcdefgh"));
+        assertNotNull(AdminExtUserRecord.validatePassword("12345678"));
+    }
+
+    @Test
+    void loginGuardLocksAfterFiveFailuresAndUnlocksOnSuccess() {
+        AdminExtLoginGuard guard = new AdminExtLoginGuard();
+        guard.checkNotLocked("alice"); // 未失败不锁
+        for (int i = 0; i < 4; i++) {
+            guard.recordFailure("alice");
+        }
+        guard.checkNotLocked("alice"); // 4 次 < 5 不锁
+        guard.recordFailure("alice");
+        assertThrows(AdminExtLoginGuard.LockedException.class, () -> guard.checkNotLocked("alice"));
+
+        guard.recordSuccess("alice");
+        guard.checkNotLocked("alice"); // 成功登录解锁
+    }
+
+    @Test
+    void loginGuardIsolatedPerUser() {
+        AdminExtLoginGuard guard = new AdminExtLoginGuard();
+        for (int i = 0; i < 5; i++) {
+            guard.recordFailure("bob");
+        }
+        guard.checkNotLocked("carol");
+        assertThrows(AdminExtLoginGuard.LockedException.class, () -> guard.checkNotLocked("bob"));
+    }
+}
