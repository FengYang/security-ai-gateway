+import request from './request';
+
+/**
+ * ADMIN-EXT（自研扩展）：高敏变更复核 API 客户端（M3-C）。
+ *
+ * 设计：docs/管理门户-细化方案.md §5.3（D8 状态机：草稿 → 待复核 → 已执行/已驳回）。
+ *
+ * 服务端硬约束（前端不承担安全职责，仅提示）：
+ *  - submitter ≠ reviewer：发起人不得复核本人提交的变更；
+ *  - 凭据轮换的新 Key 一次性提交（后端落 0600 暂存，复核通过才提升为正式凭据），
+ *    响应与变更单均不含明文；
+ *  - 全部状态流转落 G1 管理面审计链。
+ *
+ * 特性开关：后端未配置 ADMIN_CHANGES_FILE 时端点不注册（404）。
+ */
+
+/** 变更单状态：pending 待复核 / executed 已执行 / rejected 已驳回 / failed 执行失败。 */
+export type ChangeStatus = 'pending' | 'executed' | 'rejected' | 'failed';
+
+/** 本期可执行的高敏动作。 */
+export type ChangeAction =
+  | 'guardrail_pii_mode'
+  | 'credential_rotate'
+  | 'credential_delete';
+
+export interface ChangeItem {
+  id: string;
+  action: ChangeAction | string;
+  target: string;
+  diff: string;
+  payload?: Record<string, string>;
+  key_fingerprint?: string;
+  status: ChangeStatus | string;
+  submitter: string;
+  reviewer?: string;
+  reject_reason?: string;
+  created_at: number;
+  decided_at?: number;
+  executed_at?: number;
+  exec_error?: string;
+}
+
+export interface ChangeSubmit {
+  action: ChangeAction;
+  target?: string;
+  diff: string;
+  payload?: Record<string, string>;
+  /** 仅 credential_rotate：新 Key 明文，一次性提交（不入变更单/日志） */
+  secret?: string;
+}
+
+const BASE = '/v1/adminext/changes';
+
+export const listChanges = (): Promise<{ items: ChangeItem[]; total: number }> => {
+  return request.get<any, { items: ChangeItem[]; total: number }>(BASE);
+};
+
+export const submitChange = (data: ChangeSubmit): Promise<ChangeItem> => {
+  return request.post<any, ChangeItem>(BASE, data);
+};
+
+export const approveChange = (id: string): Promise<ChangeItem> => {
+  return request.post<any, ChangeItem>(`${BASE}/${id}/approve`, {});
+};
+
+export const rejectChange = (id: string, reason: string): Promise<ChangeItem> => {
+  return request.post<any, ChangeItem>(`${BASE}/${id}/reject`, { reason });
+};
