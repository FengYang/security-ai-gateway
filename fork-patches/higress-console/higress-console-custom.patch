--- /dev/null
+++ b/frontend/src/components/AdminExtBadge/index.tsx
@@ -0,0 +1,25 @@
+import { ExperimentOutlined } from '@ant-design/icons';
+import { Tag, Tooltip } from 'antd';
+import { useTranslation } from 'react-i18next';
+
+/**
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：自研页统一角标（常显）。
+ *
+ * 用途：让「自研扩展页」与 Higress 上游页面在 UI 上可一眼区分（配置见 docs/管理门户-细化方案.md）。
+ * 适用范围：仅 pages/admin-ext/** 与 pages/security-center/** 这 7 个自研页；
+ * 上游业务页面一律不引用本组件，避免污染 fork 白名单。
+ */
+const AdminExtBadge = () => {
+  const { t } = useTranslation();
+  return (
+    <div style={{ marginBottom: 12 }}>
+      <Tooltip title={t('adminExt.badgeTip')}>
+        <Tag icon={<ExperimentOutlined />} color="geekblue">
+          {t('adminExt.badge')}
+        </Tag>
+      </Tooltip>
+    </div>
+  );
+};
+
+export default AdminExtBadge;
