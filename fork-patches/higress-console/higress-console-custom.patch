+++ b/backend/console/src/test/java/com/alibaba/higress/console/controller/admin/AdminExtJwtSignerTest.java
@@ -0,0 +1,95 @@
+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT：AdminExtJwtSigner 单元测试。
+ * 校验 JWT 结构、载荷字段、TTL 语义与 HMAC 敏感性（与 Go 端 gateway-admin-service/auth.go
+ * 校验约定一致：base64url 无 padding / 键名 sub,role,iss,aud,iat,exp / Unix 秒）。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * @author admin-ext
+ */
+class AdminExtJwtSignerTest {
+
+    private static final byte[] SECRET = "test-admin-shared-secret-0123456789".getBytes(StandardCharsets.UTF_8);
+    private static final long NOW = 1_752_000_000L;
+    private static final long TTL = 60L;
+
+    private static String[] parts(String token) {
+        String[] p = token.split("\\.");
+        assertEquals(3, p.length, "JWT 应为三段");
+        return p;
+    }
+
+    private static String decode(String segment) {
+        return new String(Base64.getUrlDecoder().decode(segment), StandardCharsets.UTF_8);
+    }
+
+    @Test
+    void signProducesWellFormedTokenWithClaims() {
+        String token = AdminExtJwtSigner.sign(SECRET, "alice", "admin",
+                AdminExtConfig.DEFAULT_ISSUER, AdminExtConfig.DEFAULT_AUDIENCE, NOW, TTL);
+        String[] p = parts(token);
+
+        String header = decode(p[0]);
+        assertTrue(header.contains("\"alg\":\"HS256\""));
+
+        String payload = decode(p[1]);
+        assertTrue(payload.contains("\"sub\":\"alice\""));
+        assertTrue(payload.contains("\"role\":\"admin\""));
+        assertTrue(payload.contains("\"iss\":\"higress-console\""));
+        assertTrue(payload.contains("\"aud\":\"gateway-admin-service\""));
+        assertTrue(payload.contains("\"iat\":" + NOW));
+        assertTrue(payload.contains("\"exp\":" + (NOW + TTL)));
+    }
+
+    @Test
+    void expEqualsIatPlusTtl() {
+        String token = AdminExtJwtSigner.sign(SECRET, "bob", "auditor",
+                AdminExtConfig.DEFAULT_ISSUER, AdminExtConfig.DEFAULT_AUDIENCE, NOW, TTL);
+        String payload = decode(parts(token)[1]);
+        assertTrue(payload.contains("\"iat\":" + NOW), payload);
+        assertTrue(payload.contains("\"exp\":" + (NOW + TTL)), payload);
+    }
+
+    @Test
+    void signatureChangesWhenPayloadOrSecretChanges() {
+        String base = AdminExtJwtSigner.sign(SECRET, "alice", "admin",
+                AdminExtConfig.DEFAULT_ISSUER, AdminExtConfig.DEFAULT_AUDIENCE, NOW, TTL);
+
+        String otherRole = AdminExtJwtSigner.sign(SECRET, "alice", "auditor",
+                AdminExtConfig.DEFAULT_ISSUER, AdminExtConfig.DEFAULT_AUDIENCE, NOW, TTL);
+        assertNotEquals(base, otherRole, "载荷变化必须改变签名");
+
+        byte[] otherSecret = "another-secret-key-0123456789abcdef".getBytes(StandardCharsets.UTF_8);
+        String otherKey = AdminExtJwtSigner.sign(otherSecret, "alice", "admin",
+                AdminExtConfig.DEFAULT_ISSUER, AdminExtConfig.DEFAULT_AUDIENCE, NOW, TTL);
+        assertNotEquals(base, otherKey, "密钥变化必须改变签名");
+    }
+
+    @Test
+    void jsonEscapesQuotesAndBackslashesInSub() {
+        String token = AdminExtJwtSigner.sign(SECRET, "a\"b\\c", "admin",
+                AdminExtConfig.DEFAULT_ISSUER, AdminExtConfig.DEFAULT_AUDIENCE, NOW, TTL);
+        String payload = decode(parts(token)[1]);
+        assertTrue(payload.contains("\"sub\":\"a\\\"b\\\\c\""), payload);
+    }
+
+    @Test
+    void signNowCarriesDefaults() {
+        String token = AdminExtJwtSigner.signNow(SECRET, "alice", "admin", TTL);
+        String payload = decode(parts(token)[1]);
+        assertTrue(payload.contains("\"iss\":\"higress-console\""));
+        assertTrue(payload.contains("\"aud\":\"gateway-admin-service\""));
+    }
+}
diff --git a/backend/console/src/test/java/com/alibaba/higress/console/controller/admin/AdminExtSessionServiceTest.java b/backend/console/src/test/java/com/alibaba/higress/console/controller/admin/AdminExtSessionServiceTest.java
new file mode 100644
index 0000000..4179bbc
--- /dev/null
+++ b/backend/console/src/test/java/com/alibaba/higress/console/controller/admin/AdminExtSessionServiceTest.java
@@ -0,0 +1,209 @@
+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT（自研扩展）单测：多账号会话服务（M3-A @Primary 接管）。
+ *
+ * 覆盖核心闭环（delegate / userStore 用 Mockito 桩）：
+ *   - 自研账号登录（成功/失败计数/锁定）与原生兜底；
+ *   - 自研令牌 saveSession → validateSession 往返；
+ *   - 篡改/过期/账号已删 → 会话失效；
+ *   - 原生账号走委托；changePassword 路由与强度校验。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+import javax.servlet.http.Cookie;
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.alibaba.higress.console.model.User;
+import com.alibaba.higress.console.service.SessionServiceImpl;
+import com.alibaba.higress.sdk.exception.BusinessException;
+import com.alibaba.higress.sdk.exception.ValidationException;
+
+/**
+ * @author admin-ext
+ */
+class AdminExtSessionServiceTest {
+
+    private static final String SERVER_KEY = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
+
+    private SessionServiceImpl delegate;
+    private AdminExtUserStore userStore;
+    private AdminExtLoginGuard loginGuard;
+    private AdminExtSessionService service;
+
+    @BeforeEach
+    void setUp() {
+        delegate = mock(SessionServiceImpl.class);
+        userStore = mock(AdminExtUserStore.class);
+        loginGuard = new AdminExtLoginGuard();
+        service = new AdminExtSessionService();
+        ReflectionTestUtils.setField(service, "delegate", delegate);
+        ReflectionTestUtils.setField(service, "userStore", userStore);
+        ReflectionTestUtils.setField(service, "loginGuard", loginGuard);
+        ReflectionTestUtils.setField(service, "cookieName", "_hi_sess");
+        ReflectionTestUtils.setField(service, "cookieMaxAge", 3600);
+    }
+
+    private AdminExtUserRecord record(String name, String password, String role) {
+        String salt = AdminExtUserRecord.newSalt(new SecureRandom());
+        return new AdminExtUserRecord(name, name, role,
+            AdminExtUserRecord.hashPassword(salt, password), salt);
+    }
+
+    private static AdminExtUserStore.Snapshot snapshot(List<AdminExtUserRecord> users) {
+        AdminExtUserStore.Snapshot snapshot = new AdminExtUserStore.Snapshot();
+        snapshot.setUsers(new ArrayList<>(users));
+        snapshot.setServerKey(SERVER_KEY);
+        snapshot.setData(Collections.emptyMap());
+        return snapshot;
+    }
+
+    @Test
+    void extAccountLoginSuccess() {
+        when(userStore.findByUsername("bob")).thenReturn(record("bob", "passw0rdA", AdminExtRole.AUDITOR));
+        User user = service.login("bob", "passw0rdA");
+        assertNotNull(user);
+        assertEquals("bob", user.getName());
+        assertEquals("bob", user.getDisplayName());
+        verify(delegate, never()).login(anyString(), anyString());
+    }
+
+    @Test
+    void extAccountWrongPasswordFallsBackToDelegateAndCountsFailure() {
+        when(userStore.findByUsername("bob")).thenReturn(record("bob", "passw0rdA", AdminExtRole.AUDITOR));
+        when(delegate.login("bob", "wrong-pass")).thenReturn(null);
+        assertNull(service.login("bob", "wrong-pass"));
+        // 4 次失败后第 5 次命中锁定 → 直接拒绝且不再触达原生流程
+        for (int i = 0; i < 4; i++) {
+            assertNull(service.login("bob", "wrong-pass"));
+        }
+        assertThrows(AdminExtLoginGuard.LockedException.class, () -> service.login("bob", "passw0rdA"));
+        verify(delegate, never()).login(eq("bob"), eq("passw0rdA"));
+    }
+
+    @Test
+    void nativeAdminLoginDelegatesWhenNotInExtStore() {
+        when(userStore.findByUsername("admin")).thenReturn(null);
+        User expected = new User();
+        expected.setName("admin");
+        when(delegate.login("admin", "pw123456")).thenReturn(expected);
+        assertEquals(expected, service.login("admin", "pw123456"));
+    }
+
+    @Test
+    void storeFailureFallsBackToNativeLogin() {
+        when(userStore.findByUsername("admin")).thenThrow(new BusinessException("账号表读取失败"));
+        User expected = new User();
+        expected.setName("admin");
+        when(delegate.login("admin", "pw123456")).thenReturn(expected);
+        assertEquals(expected, service.login("admin", "pw123456"));
+    }
+
+    @Test
+    void saveSessionRoundTripForExtAccount() {
+        when(userStore.findByUsername("bob")).thenReturn(record("bob", "passw0rdA", AdminExtRole.AUDITOR));
+        when(userStore.serverKey()).thenReturn(SERVER_KEY);
+
+        HttpServletResponse response = mock(HttpServletResponse.class);
+        ArgumentCaptor<Cookie> cookieCaptor = ArgumentCaptor.forClass(Cookie.class);
+        service.saveSession(response, User.builder().name("bob").build(), false);
+        verify(response).addCookie(cookieCaptor.capture());
+        Cookie cookie = cookieCaptor.getValue();
+        assertEquals("_hi_sess", cookie.getName());
+        assertTrue(cookie.getValue().startsWith("admext1."));
+
+        // 往返：validateSession 回读账号表（readFresh）应还原用户
+        when(userStore.readFresh()).thenReturn(snapshot(
+            Collections.singletonList(record("bob", "passw0rdA", AdminExtRole.AUDITOR))));
+        HttpServletRequest request = mock(HttpServletRequest.class);
+        when(request.getCookies()).thenReturn(new Cookie[] {cookie});
+        User user = service.validateSession(request);
+        assertNotNull(user);
+        assertEquals("bob", user.getName());
+    }
+
+    @Test
+    void tamperedTokenRejected() {
+        when(userStore.findByUsername("bob")).thenReturn(record("bob", "passw0rdA", AdminExtRole.AUDITOR));
+        when(userStore.serverKey()).thenReturn(SERVER_KEY);
+        HttpServletResponse response = mock(HttpServletResponse.class);
+        ArgumentCaptor<Cookie> cookieCaptor = ArgumentCaptor.forClass(Cookie.class);
+        service.saveSession(response, User.builder().name("bob").build(), false);
+        verify(response).addCookie(cookieCaptor.capture());
+
+        Cookie tampered = new Cookie("_hi_sess", cookieCaptor.getValue().getValue() + "x");
+        when(userStore.readFresh()).thenReturn(snapshot(
+            Collections.singletonList(record("bob", "passw0rdA", AdminExtRole.AUDITOR))));
+        HttpServletRequest request = mock(HttpServletRequest.class);
+        when(request.getCookies()).thenReturn(new Cookie[] {tampered});
+        assertNull(service.validateSession(request));
+    }
+
+    @Test
+    void deletedAccountInvalidatesToken() {
+        when(userStore.findByUsername("bob")).thenReturn(record("bob", "passw0rdA", AdminExtRole.AUDITOR));
+        when(userStore.serverKey()).thenReturn(SERVER_KEY);
+        HttpServletResponse response = mock(HttpServletResponse.class);
+        ArgumentCaptor<Cookie> cookieCaptor = ArgumentCaptor.forClass(Cookie.class);
+        service.saveSession(response, User.builder().name("bob").build(), false);
+        verify(response).addCookie(cookieCaptor.capture());
+
+        // 账号表为空（账号已删）→ 会话失效
+        when(userStore.readFresh()).thenReturn(snapshot(Collections.emptyList()));
+        HttpServletRequest request = mock(HttpServletRequest.class);
+        when(request.getCookies()).thenReturn(new Cookie[] {cookieCaptor.getValue()});
+        assertNull(service.validateSession(request));
+    }
+
+    @Test
+    void changePasswordRoutesBetweenExtAndNative() {
+        AdminExtUserRecord bob = record("bob", "old-pass1", AdminExtRole.AUDITOR);
+        when(userStore.findByUsername("bob")).thenReturn(bob);
+        when(userStore.readFresh()).thenReturn(snapshot(Collections.singletonList(bob)));
+        doThrow(new BusinessException("native-only")).when(delegate)
+            .changePassword(eq("bob"), anyString(), anyString());
+
+        // 错旧密码 → ValidationException（不触达原生）
+        assertThrows(ValidationException.class, () -> service.changePassword("bob", "wrong-old", "new-pass99"));
+        verify(delegate, never()).changePassword(anyString(), anyString(), anyString());
+
+        // 弱新密码 → ValidationException
+        assertThrows(ValidationException.class, () -> service.changePassword("bob", "old-pass1", "short"));
+        verify(delegate, never()).changePassword(anyString(), anyString(), anyString());
+
+        // 正确路径 → 写回账号表且新密码可校验
+        service.changePassword("bob", "old-pass1", "new-pass99");
+        verify(userStore).writeUsers(any(), any());
+        assertTrue(bob.matchesPassword("new-pass99"));
+
+        // 原生账号 → 委托
+        when(userStore.findByUsername("admin")).thenReturn(null);
+        service.changePassword("admin", "old", "new");
+        verify(delegate).changePassword("admin", "old", "new");
+    }
+}
diff --git a/backend/console/src/test/java/com/alibaba/higress/console/controller/admin/AdminExtUserRecordTest.java b/backend/console/src/test/java/com/alibaba/higress/console/controller/admin/AdminExtUserRecordTest.java
