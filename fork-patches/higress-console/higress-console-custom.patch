+import request from './request';
+
+/**
+ * ADMIN-EXT（自研扩展）：用量看板与配额 API 客户端（M2 A-2'）。
+ *
+ * 计量唯一真源 = tee-infer 审计链（Higress 只见密文无法计量）；
+ * 由 gateway-admin-service 代理（GET /v1/adminext/usage → tee-infer GET /usage，
+ * 服务间令牌注入，前端不可见）。
+ * 503 语义：数据源未配置/不可达时后端返回 503（不静默返回空数据）。
+ * 明文直连 /provider/* 链路不计量（V 点①定案）。
+ */
+
+/** 单模型维度用量。 */
+export interface ModelUsageStat {
+  tokens_in: number;
+  tokens_out: number;
+  requests: number;
+}
+
+/** 单租户用量（区间增量聚合）。 */
+export interface TenantUsage extends ModelUsageStat {
+  by_model?: Record<string, ModelUsageStat> | null;
+  /** deny 次数（仅累计口径返回；增量聚合 deny 不计费不入）。 */
+  denies?: number;
+  /** 配额上限（累计 token，<=0 = 不限；仅累计口径返回）。 */
+  quota?: number;
+  /** 累计消耗 token（输入+输出；仅累计口径返回）。 */
+  used_tokens?: number;
+}
+
+/** 用量查询响应（增量模式，[from, to) 左闭右开）。 */
+export interface UsageResponse {
+  from?: string;
+  to?: string;
+  window_semantics?: string;
+  tenants: Record<string, TenantUsage>;
+}
+
+/** 用量查询响应（累计口径，无 from/to：外层直接是 租户 → 用量 map）。 */
+export interface UsageCumulative {
+  [tenant: string]: TenantUsage;
+}
+
+/** 配额设置响应（tee-infer 返回当前生效配额）。 */
+export interface QuotaResponse {
+  tenant: string;
+  quota: number;
+}
+
+const BASE = '/v1/adminext/usage';
+
+export interface UsageQuery {
+  from?: string;
+  to?: string;
+  tenant?: string;
+}
+
+export const getUsage = (params: UsageQuery): Promise<UsageResponse> => {
+  return request.get<any, UsageResponse>(BASE, { params });
+};
+
+/** 累计口径查询（无 from/to：含 denies/quota/used_tokens，免疫增量口径丢 deny）。 */
+export const getUsageCumulative = (): Promise<UsageCumulative> => {
+  return request.get<any, UsageCumulative>(BASE);
+};
+
+export const setQuota = (data: { tenant: string; max_tokens: number }): Promise<QuotaResponse> => {
+  return request.post<any, QuotaResponse>(`${BASE}/quota`, data);
+};
