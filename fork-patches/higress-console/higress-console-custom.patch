+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：
+ * 内部服务令牌 HS256 签发器（RFC 7515）。零第三方依赖（仅 JDK 8 标准库），
+ * 与 gateway-admin-service（Go）的校验逻辑保持同一约定：
+ *   - base64url 无 padding；
+ *   - header={"alg":"HS256","typ":"JWT"}，payload 键：sub/role/iss/aud/iat/exp；
+ *   - iat/exp 为 Unix 秒（long，纯数字序列化，避免浮点）。
+ *
+ * Go 端校验侧（gateway/gateway-admin-service/auth.go）：
+ * 过期、aud/iss（若声明）、角色白名单、sub 非空；本签发器默认带全量字段。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+
+/**
+ * @author admin-ext
+ */
+public final class AdminExtJwtSigner {
+
+    private static final String ALG = "HmacSHA256";
+
+    private AdminExtJwtSigner() {
+    }
+
+    /**
+     * 签发内部服务令牌。
+     *
+     * @param secret  共享密钥（≥16 字节，由 AdminExtConfig 把关）
+     * @param sub     操作人登录名（控制台会话 user.name）
+     * @param role    管理面角色（admin/auditor；角色源待 M3 User+role 扩展落地）
+     * @param issuer  签发方（默认 higress-console）
+     * @param audience 受众（默认 gateway-admin-service）
+     * @param nowSec  当前 Unix 秒（便于单测注入固定时钟）
+     * @param ttlSec  有效期秒
+     */
+    public static String sign(byte[] secret, String sub, String role, String issuer, String audience,
+                              long nowSec, long ttlSec) {
+        String header = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}";
+        String payload = "{\"sub\":\"" + jsonEscape(sub) + "\",\"role\":\"" + jsonEscape(role)
+                + "\",\"iss\":\"" + jsonEscape(issuer) + "\",\"aud\":\"" + jsonEscape(audience)
+                + "\",\"iat\":" + nowSec + ",\"exp\":" + (nowSec + ttlSec) + "}";
+        String signingInput = b64url(header.getBytes(StandardCharsets.UTF_8))
+                + "." + b64url(payload.getBytes(StandardCharsets.UTF_8));
+        return signingInput + "." + b64url(hmacSha256(secret, signingInput));
+    }
+
+    private static String jsonEscape(String s) {
+        // 登录名/角色/issuer/audience 为受控 ASCII 域，仅转义引号与反斜杠即可。
+        return s == null ? "" : s.replace("\\", "\\\\").replace("\"", "\\\"");
+    }
+
+    private static String b64url(byte[] data) {
+        return Base64.getUrlEncoder().withoutPadding().encodeToString(data);
+    }
+
+    private static byte[] hmacSha256(byte[] secret, String input) {
+        try {
+            Mac mac = Mac.getInstance(ALG);
+            mac.init(new SecretKeySpec(secret, ALG));
+            return mac.doFinal(input.getBytes(StandardCharsets.UTF_8));
+        } catch (Exception e) {
+            throw new IllegalStateException("HMAC-SHA256 不可用", e);
+        }
+    }
+
+    /**
+     * 辅助：便捷签发（缺省时钟）。供 controller 调用。
+     */
+    public static String signNow(byte[] secret, String sub, String role, long ttlSec) {
+        long now = System.currentTimeMillis() / 1000;
+        return sign(secret, sub, role, AdminExtConfig.DEFAULT_ISSUER, AdminExtConfig.DEFAULT_AUDIENCE,
+                now, ttlSec);
+    }
+}
diff --git a/backend/console/src/main/java/com/alibaba/higress/console/controller/admin/AdminExtLoginGuard.java b/backend/console/src/main/java/com/alibaba/higress/console/controller/admin/AdminExtLoginGuard.java
