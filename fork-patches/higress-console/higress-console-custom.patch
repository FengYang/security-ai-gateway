diff --git a/frontend/src/pages/security-center/index.tsx b/frontend/src/pages/security-center/index.tsx
new file mode 100644
index 0000000..6750e75
--- /dev/null
+++ b/frontend/src/pages/security-center/index.tsx
@@ -0,0 +1,307 @@
+import { PageContainer } from '@ant-design/pro-layout';
+import { Alert, Button, Card, Descriptions, message, Space, Spin, Table, Tag } from 'antd';
+import { useCallback, useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import AdminExtBadge from '@/components/AdminExtBadge';
+import {
+  AuditChainEvent,
+  AuditChainQuery,
+  AuditChainVerify,
+  SecStatus,
+  exportAuditChain,
+  getSecStatus,
+  getTeeAudit,
+  queryAuditChain,
+  verifyAuditChain,
+} from '@/services/admin-ext-security';
+
+/**
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：安全中心（M3-B）。
+ *
+ * 三区块（docs/管理门户-细化方案.md §5「安全中心」）：
+ *  ① 密态链路状态：quote 会话/握手/TEE 地址健康（聚合 tee-infer /healthz + /config）；
+ *  ② Guardrail 策略：只读展示生效规则摘要（**变更走高敏变更复核**，本页不提供写入口——
+ *     Guardrail 属 tee-infer 服务内配置，按高敏变更语义处理，见 §3.2/§5.3）；
+ *  ③ 审计链：G1 管理面链查询/哈希校验/导出 + tee-infer 数据面链校验。
+ *
+ * 安全取舍（最小披露）：Guardrail 只展示类别与规则条数（不展示正则/关键词原文，
+ * 原文等同绕过手册）；链尾哈希只展示前 8 位。
+ *
+ * 只读边界（D10）：本页全部端点服务端允许 admin 与 auditor 读取；前端不区分角色。
+ */
+
+const PAGE_SIZE = 20;
+
+const SecurityCenter: React.FC = () => {
+  const { t } = useTranslation();
+  const [status, setStatus] = useState<SecStatus | null>(null);
+  const [statusErr, setStatusErr] = useState<string | null>(null);
+  const [loadingStatus, setLoadingStatus] = useState(false);
+
+  const [chain, setChain] = useState<AuditChainQuery | null>(null);
+  const [chainErr, setChainErr] = useState<string | null>(null);
+  const [loadingChain, setLoadingChain] = useState(false);
+  const [page, setPage] = useState(1);
+
+  const [verifyResult, setVerifyResult] = useState<AuditChainVerify | null>(null);
+  const [teeVerify, setTeeVerify] = useState<string | null>(null);
+  const [acting, setActing] = useState(false);
+
+  const loadStatus = useCallback(() => {
+    setLoadingStatus(true);
+    getSecStatus()
+      .then((s) => {
+        setStatus(s);
+        setStatusErr(null);
+      })
+      .catch((e) => setStatusErr(String(e)))
+      .finally(() => setLoadingStatus(false));
+  }, []);
+
+  const loadChain = useCallback(
+    (p: number) => {
+      setLoadingChain(true);
+      queryAuditChain(PAGE_SIZE, (p - 1) * PAGE_SIZE)
+        .then((c) => {
+          setChain(c);
+          setChainErr(null);
+        })
+        .catch((e) => setChainErr(String(e)))
+        .finally(() => setLoadingChain(false));
+    },
+    [],
+  );
+
+  useEffect(() => {
+    loadStatus();
+    loadChain(1);
+  }, [loadStatus, loadChain]);
+
+  const runVerify = async () => {
+    setActing(true);
+    try {
+      const r = await verifyAuditChain();
+      setVerifyResult(r);
+      message[r.ok ? 'success' : 'error'](
+        r.ok ? t('adminExt.security.chainVerifyOk') : t('adminExt.security.chainVerifyFail'),
+      );
+    } catch (e) {
+      message.error(String(e));
+    } finally {
+      setActing(false);
+    }
+  };
+
+  const runTeeVerify = async () => {
+    setActing(true);
+    try {
+      const r = await getTeeAudit({ verify: true });
+      setTeeVerify(JSON.stringify(r, null, 2));
+      message.success(t('adminExt.security.teeQueryOk'));
+    } catch (e) {
+      message.error(String(e));
+    } finally {
+      setActing(false);
+    }
+  };
+
+  const healthNode = (() => {
+    const h = status?.tee_health;
+    if (h === 'ok') {
+      return <Tag color="green">{t('adminExt.security.healthOk')}</Tag>;
+    }
+    if (h === 'attestation_required') {
+      return <Tag color="orange">{t('adminExt.security.healthAttest')}</Tag>;
+    }
+    return <Tag color="red">{t('adminExt.security.healthUnreachable')}</Tag>;
+  })();
+
+  const fmtTime = (ns?: number) => (ns ? new Date(ns / 1e6).toLocaleString() : '-');
+
+  const columns = [
+    { title: t('adminExt.security.colTime'), dataIndex: 'timestamp', key: 'timestamp', render: fmtTime },
+    { title: t('adminExt.security.colActor'), dataIndex: 'actor', key: 'actor' },
+    { title: t('adminExt.security.colAction'), dataIndex: 'action', key: 'action' },
+    {
+      title: t('adminExt.security.colTarget'),
+      key: 'target',
+      render: (_: unknown, r: AuditChainEvent) => r.target || r.provider || r.tenant || '-',
+    },
+    {
+      title: t('adminExt.security.colPrevHash'),
+      dataIndex: 'prev_hash',
+      key: 'prev_hash',
+      render: (v: string) => (v ? v.substring(0, 8) : 'GENESIS'),
+    },
+  ];
+
+  const guardrail = status?.tee_config?.guardrail;
+
+  return (
+    <PageContainer>
+      <AdminExtBadge />
+      {statusErr && (
+        <Alert type="warning" showIcon message={statusErr} style={{ marginBottom: 16 }} />
+      )}
+
+      <Card
+        title={t('adminExt.security.teeStatus')}
+        extra={
+          <Button size="small" onClick={loadStatus} loading={loadingStatus}>
+            {t('adminExt.security.refresh')}
+          </Button>
+        }
+        style={{ marginBottom: 16 }}
+      >
+        {loadingStatus && !status ? (
+          <Spin />
+        ) : (
+          <Descriptions column={2} size="small">
+            <Descriptions.Item label={t('adminExt.security.teeUrl')}>
+              {status?.tee_url || '-'}
+            </Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.security.teeHealth')}>{healthNode}</Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.security.protocolVersion')}>
+              {status?.tee_config?.protocol_version || '-'}
+            </Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.security.requireAttest')}>
+              {status?.tee_config?.require_attest ? (
+                <Tag color="green">{t('adminExt.security.on')}</Tag>
+              ) : (
+                <Tag>{t('adminExt.security.off')}</Tag>
+              )}
+            </Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.security.piiMode')}>
+              {status?.tee_config?.pii_mode || '-'}
+              {status?.tee_config?.pii_mode_source === 'runtime' && (
+                <Tag color="orange" style={{ marginLeft: 8 }}>
+                  {t('adminExt.security.piiModeRuntime')}
+                </Tag>
+              )}
+            </Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.security.auditEnabled')}>
+              {status?.tee_config?.audit_enabled ? (
+                <Tag color="green">{t('adminExt.security.on')}</Tag>
+              ) : (
+                <Tag color="orange">{t('adminExt.security.off')}</Tag>
+              )}
+            </Descriptions.Item>
+          </Descriptions>
+        )}
+      </Card>
+
+      <Card title={t('adminExt.security.guardrail')} style={{ marginBottom: 16 }}>
+        <Alert
+          type="info"
+          showIcon
+          message={t('adminExt.security.guardrailHint')}
+          style={{ marginBottom: 12 }}
+        />
+        {guardrail ? (
+          <Descriptions column={2} size="small">
+            <Descriptions.Item label={t('adminExt.security.guardrailEnabled')}>
+              {guardrail.enabled ? (
+                <Tag color="green">{t('adminExt.security.on')}</Tag>
+              ) : (
+                <Tag color="red">{t('adminExt.security.off')}</Tag>
+              )}
+            </Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.security.injectionTerms')}>
+              {guardrail.injection_terms}
+            </Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.security.piiCategories')}>
+              {guardrail.pii_categories}
+            </Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.security.piiRules')}>
+              {guardrail.pii_rules}
+            </Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.security.sqlCategories')}>
+              {guardrail.sql_categories}
+            </Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.security.sqlRules')}>
+              {guardrail.sql_rules}
+            </Descriptions.Item>
+          </Descriptions>
+        ) : (
+          <Alert type="warning" showIcon message={t('adminExt.security.noTeeConfig')} />
+        )}
+      </Card>
+
+      <Card
+        title={t('adminExt.security.auditChain')}
+        extra={
+          <Space>
+            <Button size="small" onClick={runVerify} loading={acting}>
+              {t('adminExt.security.verifyG1')}
+            </Button>
+            <Button size="small" onClick={exportAuditChain}>
+              {t('adminExt.security.exportG1')}
+            </Button>
+            <Button size="small" onClick={runTeeVerify} loading={acting}>
+              {t('adminExt.security.verifyTee')}
+            </Button>
+          </Space>
+        }
+      >
+        {verifyResult && (
+          <Alert
+            type={verifyResult.ok ? 'success' : 'error'}
+            showIcon
+            style={{ marginBottom: 12 }}
+            message={
+              verifyResult.ok
+                ? t('adminExt.security.chainVerifyOk')
+                : `${t('adminExt.security.chainVerifyFail')} (broken_at=${verifyResult.broken_at})`
+            }
+            description={t('adminExt.security.chainEvents', { count: verifyResult.events })}
+          />
+        )}
+        {teeVerify && (
+          <Alert
+            type="success"
+            showIcon
+            style={{ marginBottom: 12 }}
+            message={t('adminExt.security.teeQueryResult')}
+            description={<pre style={{ margin: 0 }}>{teeVerify}</pre>}
+          />
+        )}
+        {chainErr && <Alert type="warning" showIcon message={chainErr} style={{ marginBottom: 12 }} />}
+        {status && (
+          <Descriptions column={3} size="small" style={{ marginBottom: 12 }}>
+            <Descriptions.Item label={t('adminExt.security.chainTotal')}>
+              {status.audit_chain.events}
+            </Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.security.chainVerified')}>
+              {status.audit_chain.verified ? (
+                <Tag color="green">{t('adminExt.security.chainIntact')}</Tag>
+              ) : (
+                <Tag color="red">{t('adminExt.security.chainBroken')}</Tag>
+              )}
+            </Descriptions.Item>
+            <Descriptions.Item label={t('adminExt.security.chainLastHash')}>
+              {status.audit_chain.last_hash || '-'}
+            </Descriptions.Item>
+          </Descriptions>
+        )}
+        <Table
+          rowKey="event_id"
+          size="small"
+          loading={loadingChain}
+          columns={columns}
+          dataSource={chain?.events || []}
+          pagination={{
+            current: page,
+            pageSize: PAGE_SIZE,
+            total: chain?.total || 0,
+            onChange: (p) => {
+              setPage(p);
+              loadChain(p);
+            },
+          }}
+        />
+      </Card>
+    </PageContainer>
+  );
+};
+
+export default SecurityCenter;
