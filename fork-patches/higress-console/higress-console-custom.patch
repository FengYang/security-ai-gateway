@@ -0,0 +1,155 @@
+/*
+ * Copyright (c) 2026
+ *
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：
+ * /v1/adminext/** 通用转发端点（docs/管理门户-细化方案.md §3.1/§3.2）。
+ *
+ * 设计：
+ *  - 本 controller 不加 @AllowAnonymous → 由 ApiStandardizationAspect 强制控制台登录会话
+ *    （validateSession 通过后 SessionUserHelper 注入当前用户），不重复建账号体系；
+ *  - 转发路径 = 目标前缀(ADMIN_SVC_TARGET) + 原始 URI（含 query），保留 /v1/adminext 前缀，
+ *    gateway-admin-service 侧同一前缀路由；
+ *  - 内部令牌：以共享密钥签发 HS256 JWT（sub=会话登录名），Go 侧校验签名/过期/aud-iss/角色；
+ *    role = AdminExtUserStore.resolveRole（M3-A：账号表派生；未命中=原生 admin 兜底；
+ *    账号表不可达 = auditor 降级只读，运维白名单为最后防线）；
+ *  - 敏感头（Cookie/Authorization 等）不转发，仅注入自签 Bearer，防会话泄露/头注入。
+ *
+ * 语义说明：控制台 ApiStandardizationAspect 对 DELETE 统一强制 204（上游行为），
+ * 故转发 DELETE 亦无响应体语义（管理面 M1 无删除端点，不影响）。
+ */
+package com.alibaba.higress.console.controller.admin;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Set;
+
+import javax.annotation.Resource;
+import javax.servlet.http.HttpServletRequest;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.alibaba.higress.console.model.User;
+import com.alibaba.higress.console.service.SessionUserHelper;
+
+/**
+ * @author admin-ext
+ */
+@RestController
+@RequestMapping("/v1/adminext")
+public class AdminExtProxyController {
+
+    private static final Logger log = LoggerFactory.getLogger(AdminExtProxyController.class);
+
+    private static final Set<String> FORWARDABLE_METHODS =
+            new HashSet<>(Arrays.asList("GET", "POST", "PUT", "PATCH", "DELETE"));
+
+    private static final int MAX_BODY_BYTES = 10 * 1024 * 1024;
+
+    @Resource
+    private AdminExtConfig config;
+
+    @Resource
+    private AdminExtUserStore userStore;
+
+    @RequestMapping(path = "/**")
+    public ResponseEntity<byte[]> forward(HttpServletRequest request) throws IOException {
+        User user = SessionUserHelper.getCurrentUser();
+        if (user == null || user.getName() == null) {
+            // 理论不可达（aspect 已强制登录），防御性兜底。
+            return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build();
+        }
+        if (!config.isReady()) {
+            log.error("[admin-ext] 转发配置未就绪（ADMIN_SVC_JWT_SECRET 缺失/过短或目标为空），fail-closed 拒绝");
+            return ResponseEntity.status(HttpStatus.SERVICE_UNAVAILABLE)
+                    .body("gateway-admin-service 转发配置未就绪".getBytes(java.nio.charset.StandardCharsets.UTF_8));
+        }
+
+        String method = request.getMethod();
+        if (!FORWARDABLE_METHODS.contains(method)) {
+            return ResponseEntity.status(HttpStatus.BAD_REQUEST)
+                    .body(("不支持的转发方法: " + method).getBytes(java.nio.charset.StandardCharsets.UTF_8));
+        }
+
+        // M3-A：role 按账号表解析（未命中 = 原生 admin；账号表不可达 = auditor 降级只读）。
+        String role = userStore.resolveRole(user.getName());
+        String token = AdminExtJwtSigner.signNow(config.getJwtSecret(), user.getName(), role,
+                config.getJwtTtlSeconds());
+        return proxy(request, method, token);
+    }
+
+    private ResponseEntity<byte[]> proxy(HttpServletRequest request, String method, String token)
+            throws IOException {
+        String uri = request.getRequestURI();
+        String query = request.getQueryString();
+        URL url = new URL(config.getTarget() + uri + (query == null ? "" : "?" + query));
+
+        HttpURLConnection conn = null;
+        try {
+            conn = (HttpURLConnection) url.openConnection();
+            conn.setRequestMethod(method);
+            conn.setConnectTimeout(3000);
+            conn.setReadTimeout(60000);
+            conn.setRequestProperty("Authorization", "Bearer " + token);
+            String contentType = request.getContentType();
+            if (contentType != null) {
+                conn.setRequestProperty("Content-Type", contentType);
+            }
+
+            if ("POST".equals(method) || "PUT".equals(method) || "PATCH".equals(method)) {
+                conn.setDoOutput(true);
+                byte[] body = readFully(request.getInputStream());
+                try (OutputStream out = conn.getOutputStream()) {
+                    out.write(body);
+                }
+            }
+
+            int code = conn.getResponseCode();
+            InputStream in = code >= 400 ? conn.getErrorStream() : conn.getInputStream();
+            byte[] respBody = in == null ? new byte[0] : readFully(in);
+
+            HttpHeaders headers = new HttpHeaders();
+            String respType = conn.getContentType();
+            if (respType != null) {
+                try {
+                    headers.setContentType(MediaType.parseMediaType(respType));
+                } catch (RuntimeException e) {
+                    headers.setContentType(MediaType.APPLICATION_OCTET_STREAM);
+                }
+            }
+            log.info("[admin-ext] {} {} -> {} (upstream {})", method, uri, code, url);
+            return new ResponseEntity<>(respBody, headers, HttpStatus.valueOf(code));
+        } finally {
+            if (conn != null) {
+                conn.disconnect();
+            }
+        }
+    }
+
+    private static byte[] readFully(InputStream in) throws IOException {
+        ByteArrayOutputStream buf = new ByteArrayOutputStream();
+        byte[] chunk = new byte[4096];
+        int total = 0;
+        int n;
+        while ((n = in.read(chunk)) != -1) {
+            total += n;
+            if (total > MAX_BODY_BYTES) {
+                throw new IOException("管理面请求体超过上限 " + (MAX_BODY_BYTES / 1024 / 1024) + "MB");
+            }
+            buf.write(chunk, 0, n);
+        }
+        return buf.toByteArray();
+    }
+}
