diff --git a/frontend/src/pages/admin-ext/billing/index.tsx b/frontend/src/pages/admin-ext/billing/index.tsx
new file mode 100644
index 0000000..90097c9
--- /dev/null
+++ b/frontend/src/pages/admin-ext/billing/index.tsx
@@ -0,0 +1,557 @@
+import { ReloadOutlined } from '@ant-design/icons';
+import { PageContainer } from '@ant-design/pro-layout';
+import {
+  Alert,
+  Button,
+  Card,
+  Descriptions,
+  Form,
+  Input,
+  InputNumber,
+  message,
+  Modal,
+  Popconfirm,
+  Select,
+  Space,
+  Table,
+  TableColumnsType,
+  Tabs,
+  Tag,
+  Typography,
+} from 'antd';
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import AdminExtBadge from '@/components/AdminExtBadge';
+import {
+  bindSubscription,
+  Bill,
+  BillItem,
+  freezeTenant,
+  getSubscription,
+  listBills,
+  listPlans,
+  Plan,
+  Subscription,
+  unfreezeTenant,
+  upsertPlan,
+} from '@/services/admin-ext-billing';
+
+/**
+ * ADMIN-EXT（自研扩展，vendor-fork 只增不减）：计费中心（P0-3 §4.3.2/§4.3.4）。
+ *
+ * 数据源 = gateway-admin-service `/v1/adminext/billing/*`（账务域）：
+ *  - 账单中心：账单列表 + 明细展开（金额列**仅本页**出现，§3.1.3）；
+ *  - 套餐与订阅：套餐列表（admin 可新建/编辑）+ 当前租户订阅查询 + 绑定；
+ *  - 冻结管理：冻结/解冻租户（admin）。
+ * 写端点仅 `admin`：前端不做角色隐藏（无身份信息，§4.3.4 D10），以后端 403 为准；
+ * 写动作落审计链（`plan_upsert`/`plan_bind`/`bill_freeze`/`bill_unfreeze`）。
+ * 金额单位：后端为**分**，此处换算为元展示。
+ */
+
+/** 分 → 元（两位小数）。 */
+const fenToYuan = (fen: number): string => ((fen || 0) / 100).toFixed(2);
+
+/** 纳秒时间戳 → 本地时间串；0 视为未设置。 */
+const fmtNano = (ns: number): string => {
+  if (!ns) {
+    return '-';
+  }
+  return new Date(Math.round(ns / 1e6)).toLocaleString();
+};
+
+const STATUS_COLORS: Record<string, string> = {
+  issued: 'green',
+  draft: 'blue',
+  frozen: 'red',
+  void: 'default',
+  assoc_mismatch: 'orange',
+};
+
+const KIND_KEYS: Record<string, string> = {
+  daily: 'adminExt.billing.kindDaily',
+  monthly: 'adminExt.billing.kindMonthly',
+  overage: 'adminExt.billing.kindOverage',
+};
+
+/** 套餐表单值（id 即 model；over_quota 校验 R-29 由后端强制）。 */
+interface PlanFormValues {
+  id: string;
+  name: string;
+  monthly_tokens: number;
+  concurrency: number;
+  cache_tier: string;
+  over_quota: string;
+}
+
+const CACHE_TIERS = ['none', 'exact', 'semantic'];
+const OVER_QUOTA = ['reject', 'degrade', 'charge'];
+
+const BillingCenterPage: React.FC = () => {
+  const { t } = useTranslation();
+
+  // 账单中心
+  const [bills, setBills] = useState<Bill[]>([]);
+  const [billsLoading, setBillsLoading] = useState(false);
+  const [billsError, setBillsError] = useState<string | null>(null);
+  const [tenantFilter, setTenantFilter] = useState('');
+  const [kindFilter, setKindFilter] = useState<string>('');
+
+  // 套餐与订阅
+  const [plans, setPlans] = useState<Plan[]>([]);
+  const [plansLoading, setPlansLoading] = useState(false);
+  const [plansError, setPlansError] = useState<string | null>(null);
+  const [subTenant, setSubTenant] = useState('');
+  const [subscription, setSubscription] = useState<Subscription | null>(null);
+  const [subQueried, setSubQueried] = useState(false);
+  const [planModalOpen, setPlanModalOpen] = useState(false);
+  const [planEditable, setPlanEditable] = useState(false);
+  const [planSubmitting, setPlanSubmitting] = useState(false);
+  const [planForm] = Form.useForm<PlanFormValues>();
+  const [bindForm] = Form.useForm<{ tenant: string; plan_id: string; expires_days?: number }>();
+  const [binding, setBinding] = useState(false);
+
+  // 冻结管理
+  const [freezeTenantId, setFreezeTenantId] = useState('');
+  const [freezeReason, setFreezeReason] = useState<string>('manual');
+  const [freezing, setFreezing] = useState(false);
+  const [unfreezing, setUnfreezing] = useState(false);
+
+  const reloadBills = useCallback(() => {
+    setBillsLoading(true);
+    setBillsError(null);
+    const params: { tenant?: string; kind?: string; limit: number } = { limit: 200 };
+    if (tenantFilter.trim()) {
+      params.tenant = tenantFilter.trim();
+    }
+    if (kindFilter) {
+      params.kind = kindFilter;
+    }
+    listBills(params)
+      .then((resp) => setBills(resp?.bills || []))
+      .catch((e) => setBillsError(String(e)))
+      .finally(() => setBillsLoading(false));
+  }, [tenantFilter, kindFilter]);
+
+  const reloadPlans = useCallback(() => {
+    setPlansLoading(true);
+    setPlansError(null);
+    listPlans()
+      .then((resp) => setPlans(resp?.plans || []))
+      .catch((e) => setPlansError(String(e)))
+      .finally(() => setPlansLoading(false));
+  }, []);
+
+  useEffect(() => {
+    reloadBills();
+  }, [reloadBills]);
+
+  useEffect(() => {
+    reloadPlans();
+  }, [reloadPlans]);
+
+  const querySubscription = useCallback(() => {
+    setSubQueried(true);
+    getSubscription(subTenant.trim() || undefined)
+      .then((resp) => setSubscription(resp?.subscription || null))
+      .catch(() => setSubscription(null));
+  }, [subTenant]);
+
+  // ---------- 写：套餐 ----------
+  const openCreatePlan = () => {
+    setPlanEditable(false);
+    planForm.setFieldsValue({
+      id: '',
+      name: '',
+      monthly_tokens: 1000000,
+      concurrency: 5,
+      cache_tier: 'exact',
+      over_quota: 'reject',
+    });
+    setPlanModalOpen(true);
+  };
+
+  const openEditPlan = (p: Plan) => {
+    setPlanEditable(true);
+    planForm.setFieldsValue({
+      id: p.id,
+      name: p.name,
+      monthly_tokens: p.monthly_tokens,
+      concurrency: p.concurrency,
+      cache_tier: p.cache_tier,
+      over_quota: p.over_quota,
+    });
+    setPlanModalOpen(true);
+  };
+
+  const submitPlan = () => {
+    planForm
+      .validateFields()
+      .then((values) => {
+        setPlanSubmitting(true);
+        const payload: Plan = {
+          id: values.id.trim(),
+          name: values.name.trim(),
+          monthly_tokens: values.monthly_tokens || 0,
+          concurrency: values.concurrency || 0,
+          cache_tier: values.cache_tier,
+          over_quota: values.over_quota,
+          price_id: '',
+          pay_mode: 'postpaid',
+          extra_limits: [],
+          model_scopes: [],
+          version: 0,
+        };
+        upsertPlan(payload)
+          .then(() => {
+            message.success(t('adminExt.billing.planSaved'));
+            setPlanModalOpen(false);
+            reloadPlans();
+          })
+          .catch(() => {
+            // 全局拦截器已提示（400 R-29 / 403 越权 / 500）
+          })
+          .finally(() => setPlanSubmitting(false));
+      })
+      .catch(() => undefined);
+  };
+
+  const planColumns: TableColumnsType<Plan> = [
+    { title: t('adminExt.billing.planId'), dataIndex: 'id', key: 'id', width: 140 },
+    { title: t('adminExt.billing.planName'), dataIndex: 'name', key: 'name', width: 150 },
+    {
+      title: t('adminExt.billing.monthlyTokens'),
+      dataIndex: 'monthly_tokens',
+      key: 'monthly_tokens',
+      align: 'right' as const,
+      render: (v: number) => (v > 0 ? v.toLocaleString() : t('adminExt.billing.unlimited')),
+    },
+    { title: t('adminExt.billing.concurrency'), dataIndex: 'concurrency', key: 'concurrency', align: 'right' as const, width: 100 },
+    { title: t('adminExt.billing.cacheTier'), dataIndex: 'cache_tier', key: 'cache_tier', width: 100 },
+    {
+      title: t('adminExt.billing.overQuota'),
+      dataIndex: 'over_quota',
+      key: 'over_quota',
+      width: 100,
+      render: (v: string) => <Tag>{v}</Tag>,
+    },
+    {
+      title: t('adminExt.billing.actions'),
+      key: 'actions',
+      width: 90,
+      render: (_: unknown, r: Plan) => (
+        <Button type="link" size="small" onClick={() => openEditPlan(r)}>
+          {t('adminExt.billing.edit')}
+        </Button>
+      ),
+    },
+  ];
+
+  const submitBind = () => {
+    bindForm
+      .validateFields()
+      .then((values) => {
+        setBinding(true);
+        const days = values.expires_days || 0;
+        const payload = {
+          tenant: values.tenant.trim(),
+          plan_id: values.plan_id,
+          effective_at: 0,
+          expires_at: days > 0 ? Date.now() * 1e6 + days * 86400 * 1e9 : 0,
+        };
+        bindSubscription(payload)
+          .then(() => {
+            message.success(t('adminExt.billing.bindOk'));
+            setSubTenant(values.tenant.trim());
+            querySubscription();
+          })
+          .catch(() => undefined)
+          .finally(() => setBinding(false));
+      })
+      .catch(() => undefined);
+  };
+
+  // ---------- 写：冻结 ----------
+  const doFreeze = () => {
+    const tenant = freezeTenantId.trim();
+    if (!tenant) {
+      message.warning(t('adminExt.billing.freezeTenantRequired'));
+      return;
+    }
+    setFreezing(true);
+    freezeTenant(tenant, freezeReason, 'critical')
+      .then(() => message.success(t('adminExt.billing.freezeOk')))
+      .catch(() => undefined)
+      .finally(() => setFreezing(false));
+  };
+
+  const doUnfreeze = () => {
+    const tenant = freezeTenantId.trim();
+    if (!tenant) {
+      message.warning(t('adminExt.billing.freezeTenantRequired'));
+      return;
+    }
+    setUnfreezing(true);
+    unfreezeTenant(tenant)
+      .then(() => message.success(t('adminExt.billing.unfreezeOk')))
+      .catch(() => undefined)
+      .finally(() => setUnfreezing(false));
+  };
+
+  // ---------- 账单表 ----------
+  const billColumns: TableColumnsType<Bill> = [
+    { title: t('adminExt.billing.billId'), dataIndex: 'id', key: 'id', width: 220, ellipsis: true },
+    { title: t('adminExt.billing.tenant'), dataIndex: 'tenant', key: 'tenant', width: 140, ellipsis: true },
+    {
+      title: t('adminExt.billing.kind'),
+      dataIndex: 'kind',
+      key: 'kind',
+      width: 100,
+      render: (v: string) => <Tag>{t(KIND_KEYS[v] || v)}</Tag>,
+    },
+    { title: t('adminExt.billing.period'), dataIndex: 'period', key: 'period', width: 120 },
+    {
+      title: t('adminExt.billing.total'),
+      dataIndex: 'total',
+      key: 'total',
+      width: 120,
+      align: 'right' as const,
+      render: (v: number, r: Bill) => `${fenToYuan(v)} ${r.currency}`,
+    },
+    {
+      title: t('adminExt.billing.status'),
+      dataIndex: 'status',
+      key: 'status',
+      width: 130,
+      render: (v: string) => <Tag color={STATUS_COLORS[v]}>{v}</Tag>,
+    },
+    {
+      title: t('adminExt.billing.generatedAt'),
+      dataIndex: 'generated_at',
+      key: 'generated_at',
+      width: 180,
+      render: (v: number) => fmtNano(v),
+    },
+  ];
+
+  const itemColumns: TableColumnsType<BillItem> = [
+    { title: t('adminExt.billing.modelKey'), dataIndex: 'model_key', key: 'model_key', render: (v: string) => <Tag>{v}</Tag> },
+    { title: t('adminExt.billing.standardTokens'), dataIndex: 'standard_tokens', key: 'standard_tokens', align: 'right' as const },
+    { title: t('adminExt.billing.tokensIn'), dataIndex: 'tokens_in', key: 'tokens_in', align: 'right' as const },
+    { title: t('adminExt.billing.tokensOut'), dataIndex: 'tokens_out', key: 'tokens_out', align: 'right' as const },
+    { title: t('adminExt.billing.retryToks'), dataIndex: 'retry_toks', key: 'retry_toks', align: 'right' as const },
+    {
+      title: t('adminExt.billing.amountFen'),
+      dataIndex: 'amount',
+      key: 'amount',
+      align: 'right' as const,
+      render: (v: number) => fenToYuan(v),
+    },
+  ];
+
+  const planOptions = useMemo(() => plans.map((p) => ({ value: p.id, label: `${p.id} (${p.name})` })), [plans]);
+
+  const billsTab = (
+    <>
+      <Alert type="info" showIcon message={t('adminExt.billing.billsGuide')} style={{ marginBottom: 16 }} />
+      {billsError && <Alert type="error" showIcon message={billsError} style={{ marginBottom: 16 }} />}
+      <Space style={{ marginBottom: 16 }}>
+        <Input
+          allowClear
+          style={{ width: 240 }}
+          placeholder={t('adminExt.billing.tenantPlaceholder') as string}
+          value={tenantFilter}
+          onChange={(e) => setTenantFilter(e.target.value)}
+          onPressEnter={reloadBills}
+        />
+        <Select
+          style={{ width: 140 }}
+          value={kindFilter}
+          onChange={(v) => setKindFilter(v)}
+          options={[
+            { value: '', label: t('adminExt.billing.kindAll') },
+            { value: 'daily', label: t('adminExt.billing.kindDaily') },
+            { value: 'monthly', label: t('adminExt.billing.kindMonthly') },
+            { value: 'overage', label: t('adminExt.billing.kindOverage') },
+          ]}
+        />
+        <Button icon={<ReloadOutlined />} onClick={reloadBills} loading={billsLoading}>
+          {t('adminExt.billing.refresh')}
+        </Button>
+      </Space>
+      <Table<Bill>
+        rowKey="id"
+        size="middle"
+        loading={billsLoading}
+        dataSource={bills}
+        columns={billColumns}
+        locale={{ emptyText: t('adminExt.billing.empty') }}
+        pagination={{ pageSize: 20, hideOnSinglePage: true }}
+        expandable={{
+          rowExpandable: (r) => (r.items || []).length > 0,
+          expandedRowRender: (r) => (
+            <Table<BillItem>
+              rowKey="model_key"
+              size="small"
+              pagination={false}
+              dataSource={r.items || []}
+              columns={itemColumns}
+            />
+          ),
+        }}
+      />
+    </>
+  );
+
+  const plansTab = (
+    <>
+      <Alert type="info" showIcon message={t('adminExt.billing.plansGuide')} style={{ marginBottom: 16 }} />
+      {plansError && <Alert type="error" showIcon message={plansError} style={{ marginBottom: 16 }} />}
+
+      <Card
+        size="small"
+        title={t('adminExt.billing.subscriptionTitle')}
+        style={{ marginBottom: 16 }}
+        extra={<Button onClick={querySubscription}>{t('adminExt.billing.query')}</Button>}
+      >
+        <Space style={{ marginBottom: 12 }}>
+          <Input
+            allowClear
+            style={{ width: 220 }}
+            placeholder={t('adminExt.billing.subTenantPlaceholder') as string}
+            value={subTenant}
+            onChange={(e) => setSubTenant(e.target.value)}
+            onPressEnter={querySubscription}
+          />
+        </Space>
+        {subQueried &&
+          (subscription ? (
+            <Descriptions size="small" column={1} bordered style={{ marginBottom: 16 }}>
+              <Descriptions.Item label={t('adminExt.billing.tenant')}>{subscription.tenant}</Descriptions.Item>
+              <Descriptions.Item label={t('adminExt.billing.planId')}>{subscription.plan_id}</Descriptions.Item>
+              <Descriptions.Item label={t('adminExt.billing.effectiveAt')}>{fmtNano(subscription.effective_at)}</Descriptions.Item>
+              <Descriptions.Item label={t('adminExt.billing.expiresAt')}>
+                {subscription.expires_at ? fmtNano(subscription.expires_at) : t('adminExt.billing.noExpiry')}
+              </Descriptions.Item>
+            </Descriptions>
+          ) : (
+            <Typography.Text type="secondary" style={{ display: 'block', marginBottom: 16 }}>
+              {t('adminExt.billing.noSubscription')}
+            </Typography.Text>
+          ))}
+
+        <Typography.Paragraph type="secondary" style={{ marginBottom: 8 }}>
+          {t('adminExt.billing.bindGuide')}
+        </Typography.Paragraph>
+        <Form form={bindForm} layout="inline" onFinish={submitBind}>
+          <Form.Item name="tenant" rules={[{ required: true, message: t('adminExt.billing.tenantRequired') as string }]}>
+            <Input style={{ width: 200 }} placeholder={t('adminExt.billing.tenant') as string} />
+          </Form.Item>
+          <Form.Item name="plan_id" rules={[{ required: true, message: t('adminExt.billing.planRequired') as string }]}>
+            <Select
+              style={{ width: 220 }}
+              placeholder={t('adminExt.billing.selectPlan') as string}
+              options={planOptions}
+            />
+          </Form.Item>
+          <Form.Item name="expires_days">
+            <InputNumber min={0} step={1} style={{ width: 160 }} placeholder={t('adminExt.billing.expiresDays') as string} />
+          </Form.Item>
+          <Form.Item>
+            <Button type="primary" htmlType="submit" loading={binding}>
+              {t('adminExt.billing.bind')}
+            </Button>
+          </Form.Item>
+        </Form>
+      </Card>
+
+      <Card size="small" title={t('adminExt.billing.plansTitle')} extra={<Button type="primary" onClick={openCreatePlan}>{t('adminExt.billing.newPlan')}</Button>}>
+        <Table<Plan>
+          rowKey="id"
+          size="middle"
+          loading={plansLoading}
+          dataSource={plans}
+          columns={planColumns}
+          locale={{ emptyText: t('adminExt.billing.empty') }}
+          pagination={false}
+        />
+      </Card>
+
+      <Modal
+        title={planEditable ? t('adminExt.billing.editPlan') : t('adminExt.billing.newPlan')}
+        open={planModalOpen}
+        onOk={submitPlan}
+        confirmLoading={planSubmitting}
+        onCancel={() => setPlanModalOpen(false)}
+        destroyOnClose
+      >
+        <Form form={planForm} layout="vertical">
+          <Form.Item name="id" label={t('adminExt.billing.planId')} rules={[{ required: true, message: t('adminExt.billing.planIdRequired') as string }]}>
+            <Input disabled={planEditable} placeholder="free / basic / pro / enterprise" />
+          </Form.Item>
+          <Form.Item name="name" label={t('adminExt.billing.planName')} rules={[{ required: true, message: t('adminExt.billing.planNameRequired') as string }]}>
+            <Input />
+          </Form.Item>
+          <Form.Item name="monthly_tokens" label={t('adminExt.billing.monthlyTokens')}>
+            <InputNumber min={0} step={1000000} style={{ width: '100%' }} />
+          </Form.Item>
+          <Form.Item name="concurrency" label={t('adminExt.billing.concurrency')}>
+            <InputNumber min={0} step={1} style={{ width: '100%' }} />
+          </Form.Item>
+          <Form.Item name="cache_tier" label={t('adminExt.billing.cacheTier')}>
+            <Select options={CACHE_TIERS.map((v) => ({ value: v, label: v }))} />
+          </Form.Item>
+          <Form.Item name="over_quota" label={t('adminExt.billing.overQuota')}>
+            <Select options={OVER_QUOTA.map((v) => ({ value: v, label: v }))} />
+          </Form.Item>
+        </Form>
+      </Modal>
+    </>
+  );
+
+  const freezeTab = (
+    <>
+      <Alert type="info" showIcon message={t('adminExt.billing.freezeGuide')} style={{ marginBottom: 16 }} />
+      <Card size="small" title={t('adminExt.billing.freezeTitle')}>
+        <Space wrap>
+          <Input
+            allowClear
+            style={{ width: 240 }}
+            placeholder={t('adminExt.billing.tenant') as string}
+            value={freezeTenantId}
+            onChange={(e) => setFreezeTenantId(e.target.value)}
+          />
+          <Select
+            style={{ width: 160 }}
+            value={freezeReason}
+            onChange={(v) => setFreezeReason(v)}
+            options={[{ value: 'manual', label: t('adminExt.billing.reasonManual') }]}
+          />
+          <Popconfirm title={t('adminExt.billing.freezeConfirm') as string} onConfirm={doFreeze}>
+            <Button danger loading={freezing}>
+              {t('adminExt.billing.freeze')}
+            </Button>
+          </Popconfirm>
+          <Popconfirm title={t('adminExt.billing.unfreezeConfirm') as string} onConfirm={doUnfreeze}>
+            <Button loading={unfreezing}>{t('adminExt.billing.unfreeze')}</Button>
+          </Popconfirm>
+        </Space>
+      </Card>
+    </>
+  );
+
+  return (
+    <PageContainer>
+      <AdminExtBadge />
+      <Tabs
+        defaultActiveKey="bills"
+        items={[
+          { key: 'bills', label: t('adminExt.billing.tabBills'), children: billsTab },
+          { key: 'plans', label: t('adminExt.billing.tabPlans'), children: plansTab },
+          { key: 'freeze', label: t('adminExt.billing.tabFreeze'), children: freezeTab },
+        ]}
+      />
+    </PageContainer>
+  );
+};
+
+export default BillingCenterPage;
