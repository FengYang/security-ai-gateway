@@ -0,0 +1,154 @@
+import request from './request';
+
+/**
+ * ADMIN-EXT（自研扩展）：计费中心 API 客户端（P0-3 §4.3.1/§4.3.2）。
+ *
+ * 数据源 = gateway-admin-service `/v1/adminext/billing/*`（账务域）。
+ * 读端点按角色放行（`billing_reader`/`auditor`/`admin`，跨租户隔离由后端强制）；
+ * 写端点（套餐/绑定/冻结）仅 `admin`，由后端 `requireRole` 强制并落审计链。
+ * 金额单位：后端 Amount 为**分**，展示层换算为元；金额列仅本页出现（§3.1.3）。
+ */
+
+/** 账单明细行（与后端 billing.BillItem JSON 对齐）。 */
+export interface BillItem {
+  model_key: string;
+  standard_tokens: number;
+  tokens_in: number;
+  tokens_out: number;
+  /** 重试 token（平台承担，不计入 amount；M9）。 */
+  retry_toks: number;
+  /** 金额（分）。 */
+  amount: number;
+}
+
+/** 账单（日结/月结/超额）。 */
+export interface Bill {
+  id: string;
+  tenant: string;
+  /** daily | monthly | overage */
+  kind: string;
+  period: string;
+  items?: BillItem[] | null;
+  /** 总额（分）。 */
+  total: number;
+  currency: string;
+  price_version: string;
+  /** draft|frozen|issued|void|assoc_mismatch */
+  status: string;
+  sig?: string;
+  ledger_head?: string;
+  audit_head?: string;
+  generated_at: number;
+}
+
+/** 单维度配额（与后端 billing.QuotaLimit 对齐）。 */
+export interface QuotaLimit {
+  window?: string;
+  max_tokens: number;
+}
+
+/** 套餐定义。 */
+export interface Plan {
+  id: string;
+  name: string;
+  monthly_tokens: number;
+  concurrency: number;
+  cache_tier: string;
+  model_scopes?: string[] | null;
+  over_quota: string;
+  price_id: string;
+  extra_limits?: QuotaLimit[] | null;
+  pay_mode: string;
+  version: number;
+}
+
+/** 租户订阅（当前生效绑定）。 */
+export interface Subscription {
+  tenant: string;
+  plan_id: string;
+  effective_at: number;
+  expires_at: number;
+  bound_by: string;
+  bound_at: number;
+}
+
+const BASE = '/v1/adminext/billing';
+
+export interface BillQuery {
+  tenant?: string;
+  kind?: string;
+  from?: string;
+  to?: string;
+  limit?: number;
+}
+
+// ---------- 读 ----------
+
+/** 账单列表（GET /billing/bills）。 */
+export const listBills = (params: BillQuery): Promise<{ bills: Bill[] }> => {
+  return request.get<any, { bills: Bill[] }>(`${BASE}/bills`, { params });
+};
+
+/** 账单详情（GET /billing/bills/{id}，含明细）。 */
+export const getBill = (id: string): Promise<Bill> => {
+  return request.get<any, Bill>(`${BASE}/bills/${encodeURIComponent(id)}`);
+};
+
+/** 套餐列表（GET /billing/plans）。 */
+export const listPlans = (): Promise<{ plans: Plan[] }> => {
+  return request.get<any, { plans: Plan[] }>(`${BASE}/plans`);
+};
+
+/** 当前租户套餐（GET /billing/subscription；tenant 缺省时后端按令牌内租户）。 */
+export const getSubscription = (
+  tenant?: string,
+): Promise<{ tenant: string; subscription: Subscription | null }> => {
+  return request.get<any, { tenant: string; subscription: Subscription | null }>(
+    `${BASE}/subscription`,
+    { params: tenant ? { tenant } : undefined },
+  );
+};
+
+// ---------- 写（仅 admin；后端 requireRole 强制 + 落审计链） ----------
+
+/** 套餐 upsert（POST /billing/plans → 审计 `plan_upsert`）。 */
+export const upsertPlan = (plan: Plan): Promise<{ ok: boolean; id: string }> => {
+  return request.post<any, { ok: boolean; id: string }>(`${BASE}/plans`, plan);
+};
+
+export interface BindRequest {
+  tenant: string;
+  plan_id: string;
+  /** UTC 纳秒；0/缺省 = 立即生效。 */
+  effective_at?: number;
+  /** UTC 纳秒；0/缺省 = 不过期。 */
+  expires_at?: number;
+}
+
+/** 绑定/升降级订阅（POST /billing/subscription → 审计 `plan_bind`）。 */
+export const bindSubscription = (
+  data: BindRequest,
+): Promise<{ ok: boolean; tenant: string; plan_id: string }> => {
+  return request.post<any, { ok: boolean; tenant: string; plan_id: string }>(
+    `${BASE}/subscription`,
+    data,
+  );
+};
+
+/** 冻结租户（POST /billing/freeze → 审计 `bill_freeze`）。 */
+export const freezeTenant = (
+  tenant: string,
+  reason?: string,
+  severity?: string,
+): Promise<{ ok: boolean; tenant: string }> => {
+  return request.post<any, { ok: boolean; tenant: string }>(`${BASE}/freeze`, {
+    tenant,
+    reason,
+    severity,
+  });
+};
+
+/** 解冻租户（POST /billing/unfreeze → 审计 `bill_unfreeze`）。 */
+export const unfreezeTenant = (tenant: string): Promise<{ ok: boolean; tenant: string }> => {
+  return request.post<any, { ok: boolean; tenant: string }>(`${BASE}/unfreeze`, { tenant });
+};
