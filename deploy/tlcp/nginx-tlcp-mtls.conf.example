# deploy/tlcp/nginx-tlcp-mtls.conf.example —— P1-5 S3-c/M7-4 SM2 双向认证生产配置样例。
#
# 与 nginx-tlcp.conf.example（单向·示例）的区别：本样例开启**客户端证书校验**
# （ssl_verify_client on），面向强合规租户（金融/政务，§6.6.1/G-7 三级身份鉴别）。
#
# 前置条件：
#   1. Tongsuo（enable-ntls）+ Nginx/Tengine TLCP 模块；版本/许可证部署前确认（U-12）。
#   2. 服务端 SM2 双证书经 `make tlcp-certgen-prod` 生成（有效期 ≤1 年，R2-09）。
#   3. 客户端 CA（签发放行客户端证书的根）经密钥托管注入，禁止入库；私钥保护见 §6.6。
#
# 校验：make tlcp-verify（T-12.4-1..3）。

upstream higress-internal {
    server 127.0.0.1:8443;
    keepalive 32;
}

server {
    listen 443 ssl;
    server_name tlcp-gateway.local;

    # ---- 外层 TLCP（GB/T 38636-2020）----
    ssl_protocols        TLCPv1.1;
    # 国标静态套件为基线；ECDHE-SM2 为厂商扩展、须经 U-S3-8 机构确认后方可加入
    ssl_ciphers          ECC-SM2-WITH-SM4-GCM-SM3:ECC-SM2-WITH-SM4-SM3;
    ssl_prefer_server_ciphers on;

    # SM2 双证书（签名 + 加密）
    ssl_certificate      /etc/tlcp/sign.crt;
    ssl_certificate_key  /etc/tlcp/sign.key;
    ssl_certificate      /etc/tlcp/enc.crt;
    ssl_certificate_key  /etc/tlcp/enc.key;

    # ---- SM2 双向认证（M7-4）----
    ssl_client_certificate /etc/tlcp/client-ca.crt;   # 客户端 CA（信任根）
    ssl_verify_client      on;                        # 强制校验客户端证书
    ssl_verify_depth       2;                          # 根 → 中间 → 叶子（≥1 级中间 CA，§6.6.1）
    # 吊销：优先 OCSP，不支持时降级 CRL（间隔 ≤24h，§6.6.1）
    # ssl_crl              /etc/tlcp/client.crl;
    # ssl_stapling         on;
    # ssl_stapling_verify  on;

    location / {
        # 将已认证的客户端身份透传给内层（供应用层 RBAC/JWT 绑定，§6.6.1）
        proxy_set_header X-Client-Cert-Subject $ssl_client_s_dn;
        proxy_set_header X-Client-Cert-Verify  $ssl_client_verify;

        # 内层标准 TLS1.3 → Envoy（应用信封 SM4-GCM 构成双层，T-12.4-3）
        proxy_pass https://higress-internal;
        proxy_http_version 1.1;

        # B-12.4-1：真实客户端 IP / 协议显式透传（不透传则限流/审计按网关 IP 计）
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port  $server_port;

        proxy_set_header Connection "";
    }
}
