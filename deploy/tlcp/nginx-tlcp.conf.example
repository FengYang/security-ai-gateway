# deploy/tlcp/nginx-tlcp.conf.example —— P0-4 §12.4 前置国密网关配置样例（B6#10）。
#
# 前置条件：
#   1. Tongsuo（铜锁，enable-ntls 编译）+ Nginx/Tengine 的 TLCP 模块；
#      版本与许可证部署前按附录 H U-12 由运维确认（TLS 卸载二进制不属本仓库）。
#   2. 证书经 make tlcp-certgen 生成：sign.crt/sign.key、enc.crt/enc.key、ca.crt。
#   3. higress-internal upstream 指向 Envoy/Higress（内层标准 TLS1.3，不改）。
#
# 校验：T-12.4-1..3 经 make tlcp-verify（deploy/tlcp/verify.sh）。

upstream higress-internal {
    server 127.0.0.1:8443;       # Envoy/Higress HTTPS 监听（回环地址，非信任边界；可信区域见《GA-产品场景与可信区域矩阵》）
    keepalive 32;
}

server {
    listen 443 ssl;
    server_name tlcp-gateway.local;

    # ---- 外层 TLCP（GB/T 38636-2020）----
    ssl_protocols        TLCPv1.1;
    ssl_ciphers          ECC-SM2-WITH-SM4-GCM-SM3:ECC-SM2-WITH-SM4-SM3;
    ssl_prefer_server_ciphers on;

    # SM2 双证书：签名证书（握手签名）+ 加密证书（密钥交换）
    ssl_certificate      /etc/tlcp/sign.crt;
    ssl_certificate_key  /etc/tlcp/sign.key;
    ssl_certificate      /etc/tlcp/enc.crt;
    ssl_certificate_key  /etc/tlcp/enc.key;

    # 客户端证书：单向场景 off；双向（mTLS）场景改 on 并配置 ssl_client_certificate
    ssl_verify_client    optional;
    # ssl_client_certificate /etc/tlcp/ca.crt;

    location / {
        # ---- 内层标准 TLS1.3 → Envoy（应用信封 SM4-GCM 构成双层，T-12.4-3）----
        proxy_pass https://higress-internal;
        proxy_http_version 1.1;

        # B-12.4-1：真实客户端 IP / 协议显式透传——TLCP 终结在 Envoy 外，
        # 不透传则限流/审计按网关 IP 计（风险 R-13）。
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port  $server_port;

        proxy_set_header Connection "";
    }
}
