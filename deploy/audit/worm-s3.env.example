# deploy/audit/worm-s3.env.example
# M2-2 WORM S3 镜像后端安装期参数样例（技术方案 §1.6；参数名·默认值·覆写点·未填行为）。
# 用法：按现场改值后注入容器环境（K8s Secret/ConfigMap）；WORM_BACKEND=file（默认）时本文件全部参数不生效。

# WORM 后端模式：file（默认，仅 fileWorm，现状行为）| dual（fileWorm 链序权威 + S3 Object Lock 镜像）。
# ⚠ 纯 s3 不支持：与 A4-01 不变量（fileWorm 唯一写盘句柄/链序权威/启动恢复）冲突，填 s3 启动即拒。
#WORM_BACKEND=dual

# S3 兼容端点（AWS S3 / 阿里云 OSS S3 兼容 / MinIO / Ceph RGW）；未填 = AWS 公有云默认端点。
#WORM_S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# 区域；未填 = us-east-1。
#WORM_S3_REGION=us-east-1

# 目标桶（必须已启用 Object Lock，否则启动拒——fail-closed）；未填且 dual → 启动拒。
#WORM_S3_BUCKET=audit-worm-bucket

# 对象键前缀；未填 = audit/。
#WORM_S3_PREFIX=audit/prod-cluster/

# 对象锁保留天数（compliance 模式下保留期内不可删改）；未填 = 365。
#WORM_S3_RETENTION_DAYS=365

# 对象锁模式：compliance（默认，严格档）| governance（宽松档，需特殊权限可解锁）。
#WORM_S3_MODE=compliance

# 凭据引用（不落明文）：file:<路径> 或 env:<变量名>，内容两行 = access_key_id、secret_access_key；
# 凭据文件须 0600。与租户 S3 用途（change_s3_2、tenant_disposition_oss）凭据与桶隔离。
# 未填且 dual → 启动拒。
#WORM_S3_CREDS_REF=file:/etc/gateway/worm-s3-creds

# 集群标识（写入对象元数据 cluster-id，供跨集群对账）；未填 = default。
#WORM_S3_CLUSTER_ID=prod-cluster-1

# 攒批上传参数：行数上限（未填 = 500）与最大时延（未填 = 2s）。
#WORM_S3_FLUSH_BATCH_SIZE=500
#WORM_S3_FLUSH_INTERVAL=2s
